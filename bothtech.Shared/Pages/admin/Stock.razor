@page "/admin/stock"
@layout bothtech.Shared.Layout.AdminLayout
@using bothtech.Shared.Models
@using bothtech.Shared.Services
@using Microsoft.AspNetCore.Components.Forms
@inject DataSyncService DataSync
@inject IJSRuntime JSRuntime
@using System.Globalization

<div style="background: transparent; padding: 10px; padding-bottom: calc(85px + env(safe-area-inset-bottom, 20px)); margin: 0; overflow-x: hidden; font-family: 'Plus Jakarta Sans', sans-serif;">

    <!-- VUE 1 : KPI ET LISTE (Par défaut) -->
    <div id="viewList" style="display: @(showForm ? "none" : "block");">
        <section class="kpi-grid">
            <div class="kpi-card"><div class="kpi-label">Stock Restant</div><div class="kpi-value">@totalRemaining pcs</div></div>
            <div class="kpi-card"><div class="kpi-label">Qté Vendue</div><div class="kpi-value" style="color: var(--purple);">@totalSold pcs</div></div>
            <div class="kpi-card"><div class="kpi-label">Écoulement</div><div class="kpi-value" style="color: var(--success);">@amortizationRate %</div></div>
            <div class="kpi-card"><div class="kpi-label">C.A Réalisé</div><div class="kpi-value" style="color: var(--primary);">@FormatMoney(totalRevenue)</div></div>
        </section>

        <section class="card">
            <div class="card-header">
                <h2 class="card-title hide-mobile">Inventaire des articles</h2>
                <div style="display:flex; flex-direction: column; width: 100%; max-width: 400px; margin-left: auto;">
                    <input type="search" @bind="searchFilter" @bind:event="oninput" placeholder="Rechercher un article..." class="form-control">
                    @if (canAddProduct)
                    {
                        <button class="btn btn-primary" style="background: var(--success); color: white; border: none; font-weight: bold; cursor: pointer; margin-top: 10px;" @onclick="OpenNewProductForm">+ Nouvel Article</button>
                    }
                </div>
            </div>

            @if (isLoading)
            {
                <div style="text-align: center; padding: 40px; color: var(--text-muted);">
                    <div style="width: 30px; height: 30px; border: 3px solid #ccc; border-top-color: var(--primary); border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 10px;"></div>
                    Chargement du stock en cours...
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Article</th>
                                <th class="hide-mobile">Prix & Conditions</th>
                                <th class="hide-mobile">Stock Restant</th>
                                <th class="hide-mobile">Vendus</th>
                                <th class="hide-mobile">Écoulement</th>
                                <th style="text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (filteredProducts.Count == 0)
                            {
                                <tr><td colspan="6" style="text-align: center; padding: 20px; color: var(--text-muted);">Aucun produit correspondant.</td></tr>
                            }
                            else
                            {
                                @foreach (var kvp in filteredProducts)
                                {
                                    var id = kvp.Key;
                                    var p = kvp.Value;
                                    int remaining = p.Quantity;
                                    int sold = p.SoldQuantity;
                                    int rate = (remaining + sold) > 0 ? (sold * 100) / (remaining + sold) : 0;

                                    <tr>
                                        <td>
                                            <div class="prod-cell" style="display:flex; align-items:center;">
                                                <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "_content/bothtech.Shared/images/default.jpg" : p.ImageUrl)" class="prod-thumb" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px; margin-right: 10px;">
                                                <div style="flex:1;">
                                                    <b style="font-size:0.95rem; color:var(--text-main);">@p.Name</b><br>
                                                    <small style="color:var(--text-muted);">@p.Category</small><br>
                                                    @if (p.Validated)
                                                    {
                                                        <span class="badge badge-success" style="margin-top:4px; display:inline-block; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; background: var(--success); color: white;">✓ Validé</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-warning" style="margin-top:4px; display:inline-block; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; background: var(--warning); color: white;">⏳ Non Validé</span>
                                                    }

                                                    <div class="mobile-only-display" style="margin-top:8px; font-size:0.85rem; line-height: 1.5; border-top:1px dashed var(--border); padding-top:8px;">
                                                        <strong style="color:var(--primary); font-size:1rem;">@FormatMoney(p.Price)</strong><br>
                                                        <div style="display:flex; justify-content:space-between; margin-top:4px;">
                                                            <span>Stock: <span style="font-weight: bold; color: @(remaining == 0 ? "red" : "green");">@remaining</span></span>
                                                            <span>Vendus: <span style="font-weight: bold; color: purple;">@sold</span></span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="hide-mobile">
                                            <strong>@FormatMoney(p.Price)</strong><br>
                                            <span style="font-size:0.75rem; color:var(--text-muted);">PR: @FormatMoney(p.CostPrice ?? 0) | R.Max: @FormatMoney(p.MaxDiscount ?? 0)</span><br>
                                            @if (p.PartnerPrice > 0)
                                            {
                                                <span class="badge badge-warning" style="margin-top:4px; display:inline-block; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; background: #d97706; color: white;">Partenaire: @FormatMoney(p.PartnerPrice.Value)</span>
                                            }
                                        </td>
                                        <td class="hide-mobile"><span style="font-weight: bold; color: @(remaining == 0 ? "red" : "green");">@remaining</span></td>
                                        <td class="hide-mobile"><span style="font-weight: bold; color: purple;">@sold</span></td>
                                        <td class="hide-mobile"><div style="font-size:0.85rem;font-weight:bold;">@rate%</div></td>
                                        <td style="text-align: right; vertical-align: top;">
                                            <div class="action-buttons-container" style="display: flex; flex-direction: column; gap: 5px; align-items: flex-end;">
                                                @if (canModifyProduct)
                                                {
                                                    <button class="btn btn-outline btn-action" style="padding: 4px 8px; font-size: 0.8rem; cursor: pointer;" @onclick="() => EditProduct(id)">Éditer</button>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning">Lecture</span>
                                                }

                                                @if (isAdminOrMaintenance && !p.Validated)
                                                {
                                                    <button class="btn btn-outline btn-action" style="padding: 4px 8px; font-size: 0.8rem; color:var(--success); border-color:var(--success); cursor: pointer;" @onclick="() => ValidateStock(id)">Valider</button>
                                                }

                                                @if (sold == 0 && !p.Validated && canDeleteProduct)
                                                {
                                                    <button class="btn btn-outline btn-action" style="padding: 4px 8px; font-size: 0.8rem; color:var(--danger); border-color:var(--danger-subtle); cursor: pointer;" @onclick="() => DeleteStock(id)">Supprimer</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <!-- VUE 2 : FORMULAIRE ARTICLE (Masqué par défaut) -->
    <div id="viewForm" style="display: @(showForm ? "block" : "none");">
        <section class="card" style="max-width: 900px; margin: 0 auto;">
            <div class="card-header" style="display:flex; flex-direction:row; justify-content:space-between; align-items:center;">
                <h2 class="card-title" style="margin:0;">@formTitle</h2>
                <button type="button" class="btn btn-outline" style="cursor: pointer; width:auto; padding: 8px 12px; margin:0;" @onclick="() => showForm = false">🔙 Retour</button>
            </div>
            <div class="card-body">
                <form @onsubmit="SaveProduct">
                    <div class="form-group" style="margin-bottom:15px;"><label>Nom article *</label><input type="text" @bind="currentProduct.Name" class="form-control" required></div>

                    <div class="form-grid grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <div class="form-group"><label>Marque *</label><input type="text" @bind="currentProduct.Brand" class="form-control" required></div>
                        <div class="form-group">
                            <label>Catégorie *</label>
                            <select @bind="currentProduct.Category" class="form-control" required>
                                <option value="laptops">PC / Laptops</option>
                                <option value="smartphones">Smartphones</option>
                                <option value="tablets">Tablettes</option>
                                <option value="accessories">Accessoires</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-panel" style="margin-top:15px; padding: 15px; background: #f8fafc; border-radius: 8px;">
                        <div class="form-grid grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                            <div class="form-group"><label>Stock (Entrée) *</label><input type="number" @bind="currentProduct.Quantity" class="form-control" min="0" required></div>
                            <div class="form-group"><label>Vendus (Auto)</label><input type="number" @bind="currentProduct.SoldQuantity" class="form-control" min="0" disabled></div>
                        </div>
                    </div>

                    <div class="form-grid grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top:15px;">
                        <div class="form-group"><label>Prix de Revient (FCFA)</label><input type="number" @bind="currentProduct.CostPrice" class="form-control" min="0"></div>
                        <div class="form-group"><label>Réduction Max (hors promo)</label><input type="number" @bind="currentProduct.MaxDiscount" class="form-control" min="0"></div>
                    </div>

                    <div class="form-grid grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top:15px;">
                        <div class="form-group"><label>Prix de Vente Public (FCFA) *</label><input type="number" @bind="currentProduct.Price" class="form-control" min="0" required></div>
                        <div class="form-group"><label>Ancien Prix (Si Promo)</label><input type="number" @bind="currentProduct.OldPrice" class="form-control" min="0"></div>
                    </div>

                    <div class="form-panel warning" style="margin-top:15px; padding: 15px; background: #fffbeb; border-radius: 8px;">
                        <div class="form-grid grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                            <div class="form-group"><label style="color: #b45309;">Prix Détaillant/Gros (FCFA)</label><input type="number" @bind="currentProduct.PartnerPrice" class="form-control" min="0"></div>
                            <div class="form-group"><label style="color: #b45309;">Réd. Partenaire (%)</label><input type="text" value="@partnerDiscountText" class="form-control" disabled style="background: transparent; border: none; font-weight: bold; color: #b45309; padding-left: 0;"></div>
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom:15px; margin-top: 15px;"><label>Config technique (Séparer par des tirets)</label><input type="text" @bind="currentProduct.Specs" class="form-control"></div>

                    <div class="form-grid grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <div class="form-group">
                            <label>Badge Spécial</label>
                            <select @bind="currentProduct.Badge" class="form-control">
                                <option value="">Aucun</option>
                                <option value="Promo">Promo</option>
                                <option value="Recommander">Recommander</option>
                                <option value="Nouveau">Nouveau</option>
                                <option value="Rupture">Rupture</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Image (Upload)</label>
                            <InputFile @key="inputFileId" OnChange="HandleImageUpload" class="form-control" accept="image/*" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(currentProduct.ImageUrl))
                    {
                        <div style="margin: 15px 0; text-align: center;">
                            <img src="@currentProduct.ImageUrl" style="max-width: 100%; max-height: 150px; border-radius: 6px; border: 1px solid var(--border); object-fit: contain;">
                        </div>
                    }

                    <div class="form-group" style="display: flex; align-items: center; gap: 10px; margin: 20px 0; padding: 15px; background: white; border-radius:6px; border:1px solid var(--border);">
                        <input type="checkbox" id="pActive" @bind="currentProduct.Active" style="width:20px; height:20px;">
                        <label for="pActive" style="margin-bottom: 0; cursor:pointer; font-weight:bold; font-size:1rem;">Visible sur le catalogue public</label>
                    </div>

                    <button type="submit" class="btn btn-primary" style="background: var(--primary); font-weight:bold; width: 100%; padding: 12px;" disabled="@isSaving">@(isSaving ? "Enregistrement en cours..." : "Enregistrer l'Article")</button>
                </form>
            </div>
        </section>
    </div>

    <div id="toast" style="display: @(string.IsNullOrEmpty(toastMessage) ? "none" : "block"); position: fixed; bottom: 20px; right: 20px; background: #333; color: white; padding: 10px 20px; border-radius: 5px; z-index: 9999; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">@toastMessage</div>
</div>

@code {
    private bool isLoading = true;
    private bool showForm = false;
    private bool isSaving = false;
    private string searchFilter = "";
    private string toastMessage = "";
    private string formTitle = "Nouvel Article";
    private string editingId = "";
    private Guid inputFileId = Guid.NewGuid();

    // Sécurité et Permissions Dynamiques
    private string userRole = "client";
    private string idToken = "";
    private bool canAddProduct = false;
    private bool canModifyProduct = false;
    private bool canDeleteProduct = false;
    private bool isAdminOrMaintenance = false;

    private Dictionary<string, Dictionary<string, bool>> currentPermissions = new();

    // KPI
    private int totalRemaining = 0;
    private int totalSold = 0;
    private int amortizationRate = 0;
    private long totalRevenue = 0;

    // Données Locales
    private Product currentProduct = new();
    private Dictionary<string, Product> localProducts = new();

    private string partnerDiscountText
    {
        get
        {
            if (currentProduct.Price > 0 && currentProduct.PartnerPrice.HasValue && currentProduct.PartnerPrice.Value > 0 && currentProduct.PartnerPrice.Value < currentProduct.Price)
            {
                int pct = (int)Math.Round((double)((currentProduct.Price - currentProduct.PartnerPrice.Value) * 100) / currentProduct.Price);
                return $"-{pct} %";
            }
            return "0 %";
        }
    }

    private Dictionary<string, Product> filteredProducts
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchFilter)) return localProducts;
            return localProducts
                .Where(x => (x.Value.Name ?? "").ToLower().Contains(searchFilter.ToLower()))
                .ToDictionary(x => x.Key, x => x.Value);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                userRole = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userrole") ?? "client";
                idToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_idtoken") ?? "";

                isAdminOrMaintenance = (userRole == "admin" || userRole == "maintenance");

                // 👉 CHARGEMENT DES PERMISSIONS DEPUIS SQLITE POUR CE RÔLE
                LoadUserPermissionsLocal(userRole);

                // 👉 ÉVALUATION DES DROITS SUR LE MODULE "produits"
                canAddProduct = HasPerm("produits", "ajouter");
                canModifyProduct = HasPerm("produits", "modifier");
                canDeleteProduct = HasPerm("produits", "supprimer");

                LoadLocalData();

                _ = DataSync.PushPendingOperationsAsync(idToken);
            }
            catch (Exception ex)
            {
                Console.WriteLine("Erreur Init Stock : " + ex.Message);
            }
            finally
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    

    private bool HasPerm(string module, string action)
    {
        if (isAdminOrMaintenance) return true;

        // Sécurité de secours si la base de données locale des rôles est vide
        if (currentPermissions == null || currentPermissions.Count == 0)
        {
            string safeModule = module.ToLower();
            string safeAction = action.ToLower();

            // Rôles autorisés par défaut sur ce module s'il n'y a pas de matrice de permission
            if (userRole == "commercial")
            {
                if (safeModule == "produits" && safeAction == "lecture") return true;
            }
            return false;
        }

        if (currentPermissions.TryGetValue(module, out var actions) && actions.TryGetValue(action, out var allowed))
        {
            return allowed;
        }

        return false;
    }

    private void LoadLocalData()
    {
        try
        {
            var productsList = DataSync.GetAllLocal<Product>();
            localProducts = productsList.ToDictionary(p => p.Id, p => p);
            CalculateKpis();
        }
        catch (Exception ex)
        {
            ShowToast("Erreur lecture locale: " + ex.Message);
        }
    }

    private void CalculateKpis()
    {
        totalRemaining = localProducts.Values.Sum(p => p.Quantity);
        totalSold = localProducts.Values.Sum(p => p.SoldQuantity);
        amortizationRate = (totalRemaining + totalSold) > 0 ? (totalSold * 100) / (totalRemaining + totalSold) : 0;
        totalRevenue = localProducts.Values.Sum(p => (long)p.SoldQuantity * p.Price);
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                long maxAllowedSize = 5 * 1024 * 1024;
                var format = file.ContentType;
                if (string.IsNullOrEmpty(format) || !format.StartsWith("image/")) format = "image/jpeg";

                var resizedImageFile = await file.RequestImageFileAsync(format, 800, 800);
                using var ms = new MemoryStream();
                await resizedImageFile.OpenReadStream(maxAllowedSize).CopyToAsync(ms);

                var base64 = Convert.ToBase64String(ms.ToArray());
                currentProduct.ImageUrl = $"data:{format};base64,{base64}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ShowToast($"❌ Erreur de l'image : {ex.Message}");
        }
    }

    private void OpenNewProductForm()
    {
        if (!canAddProduct) { ShowToast("❌ Action non autorisée par la matrice."); return; }
        editingId = "";
        formTitle = "Nouvel Article";
        currentProduct = new Product { Active = true, Category = "laptops" };
        inputFileId = Guid.NewGuid();
        showForm = true;
    }

    private void EditProduct(string id)
    {
        if (!canModifyProduct) { ShowToast("❌ Action non autorisée par la matrice."); return; }
        editingId = id;
        formTitle = "Modifier l'Article";
        var p = localProducts[id];

        currentProduct = new Product
        {
            Id = p.Id,
            Name = p.Name,
            Brand = p.Brand,
            Category = p.Category,
            Price = p.Price,
            CostPrice = p.CostPrice,
            MaxDiscount = p.MaxDiscount,
            PartnerPrice = p.PartnerPrice,
            Quantity = p.Quantity,
            SoldQuantity = p.SoldQuantity,
            OldPrice = p.OldPrice,
            Specs = p.Specs,
            Badge = p.Badge,
            ImageUrl = p.ImageUrl,
            Active = p.Active,
            Validated = p.Validated,
            CreatedAt = p.CreatedAt,
            Reviews = p.Reviews
        };

        inputFileId = Guid.NewGuid();
        showForm = true;
    }

    private void SaveProduct()
    {
        bool isNew = string.IsNullOrEmpty(editingId);
        if (isNew && !canAddProduct) { ShowToast("❌ Non autorisé à ajouter."); return; }
        if (!isNew && !canModifyProduct) { ShowToast("❌ Non autorisé à modifier."); return; }

        isSaving = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(currentProduct.ImageUrl)) currentProduct.ImageUrl = "";

            if (isNew)
            {
                currentProduct.Id = Guid.NewGuid().ToString("N");
                currentProduct.CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
                currentProduct.ValidatedBy = userRole;
                currentProduct.Validated = isAdminOrMaintenance;
            }
            else
            {
                currentProduct.UpdatedAt = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
            }

            DataSync.SaveLocal(currentProduct);
            localProducts[currentProduct.Id] = currentProduct;

            string opType = isNew ? "CREATE" : "UPDATE";
            DataSync.EnqueueOperation("Product", currentProduct.Id, opType, currentProduct);
            _ = DataSync.PushPendingOperationsAsync(idToken);

            ShowToast(isNew ? "✅ Article créé en local" : "✅ Article mis à jour");

            CalculateKpis();
            showForm = false;
        }
        catch (Exception ex)
        {
            ShowToast($"❌ Erreur : {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void ValidateStock(string id)
    {
        if (!isAdminOrMaintenance) { ShowToast("❌ Réservé aux administrateurs."); return; }

        try
        {
            if (!localProducts.TryGetValue(id, out var p)) return;

            p.Validated = true;
            p.ValidatedAt = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
            p.ValidatedBy = "Admin";

            DataSync.SaveLocal(p);

            var payload = new Dictionary<string, object>
            {
                { "validated", true },
                { "validatedAt", p.ValidatedAt },
                { "validatedBy", p.ValidatedBy }
            };
            DataSync.EnqueueOperation("Product", id, "UPDATE", payload);
            _ = DataSync.PushPendingOperationsAsync(idToken);

            ShowToast("✅ Stock validé !");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowToast($"❌ Erreur : {ex.Message}");
        }
    }

    private async Task DeleteStock(string id)
    {
        if (!canDeleteProduct) { ShowToast("❌ Action non autorisée par la matrice."); return; }

        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Supprimer définitivement cet article ?");
        if (!confirm) return;

        try
        {
            DataSync.DeleteLocal<Product>(id);
            localProducts.Remove(id);

            DataSync.EnqueueOperation<Product>("Product", id, "DELETE", null);
            _ = DataSync.PushPendingOperationsAsync(idToken);

            CalculateKpis();
            ShowToast("🗑️ Article supprimé.");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowToast($"❌ Erreur : {ex.Message}");
        }
    }

    private void ShowToast(string msg)
    {
        toastMessage = msg;
        StateHasChanged();
        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            toastMessage = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private string FormatMoney(decimal amount)
    {
        var nfi = (NumberFormatInfo)CultureInfo.GetCultureInfo("fr-FR").NumberFormat.Clone();
        nfi.NumberGroupSeparator = " ";
        return amount.ToString("N0", nfi) + " FCFA";
    }
    private void LoadUserPermissionsLocal(string role)
    {
        try
        {
            var localRoles = DataSync.GetAllLocal<RoleConfig>();
            string cleanRole = (role ?? "").ToLower().Trim();
            var myRoleConfig = localRoles.FirstOrDefault(r => r.Id != null && r.Id.ToLower().Trim() == cleanRole);

            if (myRoleConfig != null && !string.IsNullOrEmpty(myRoleConfig.PermissionsJson))
            {
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var parsed = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, Dictionary<string, bool>>>(myRoleConfig.PermissionsJson, options);

                if (parsed != null && parsed.Count > 0)
                {
                    // Reconstruction pour ignorer la casse des clés (ex: "Produits" == "produits", "Ajouter" == "ajouter")
                    currentPermissions = new Dictionary<string, Dictionary<string, bool>>(StringComparer.OrdinalIgnoreCase);
                    foreach (var module in parsed)
                    {
                        var actionDict = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);
                        foreach (var action in module.Value)
                        {
                            actionDict[action.Key] = action.Value;
                        }
                        currentPermissions[module.Key] = actionDict;
                    }
                }
                else
                {
                    currentPermissions = new();
                }
            }
            else
            {
                currentPermissions = new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erreur lecture permissions stock : " + ex.Message);
            currentPermissions = new();
        }
    }
}