    private string EncryptMessage(string plainText) { if (string.IsNullOrEmpty(plainText)) return ""; using Aes aes = Aes.Create(); aes.Key = encryptionKey; aes.IV = encryptionIv; ICryptoTransform encryptor = aes.CreateEncryptor(aes.Key, aes.IV); using MemoryStream ms = new MemoryStream(); using CryptoStream cs = new CryptoStream(ms, encryptor, CryptoStreamMode.Write); using (StreamWriter sw = new StreamWriter(cs)) { sw.Write(plainText); } return Convert.ToBase64String(ms.ToArray()); }
    private string DecryptMessage(string cipherText) { if (string.IsNullOrEmpty(cipherText)) return ""; try { using Aes aes = Aes.Create(); aes.Key = encryptionKey; aes.IV = encryptionIv; ICryptoTransform decryptor = aes.CreateDecryptor(aes.Key, aes.IV); using MemoryStream ms = new MemoryStream(Convert.FromBase64String(cipherText)); using CryptoStream cs = new CryptoStream(ms, decryptor, CryptoStreamMode.Read); using StreamReader sr = new StreamReader(cs); return sr.ReadToEnd(); } catch { return "Erreur de lecture."; } }
    private string FormatDate(long ts) => ts < 10000000000 ? DateTimeOffset.FromUnixTimeSeconds(ts).LocalDateTime.ToString("dd/MM/yyyy HH:mm") : DateTimeOffset.FromUnixTimeMilliseconds(ts).LocalDateTime.ToString("dd/MM/yyyy HH:mm");
    private string FormatMoney(double? amount) { if (!amount.HasValue) return "0 FCFA"; return amount.Value.ToString("N0", new CultureInfo("fr-FR")) + " FCFA"; }

    private string ConvertAmountToWords(double? amount)
    {
        if (!amount.HasValue || amount.Value == 0) return "ZÉRO";
        long val = (long)Math.Floor(amount.Value);
        return NumberToWords(val);
    }

    private static string NumberToWords(long number)
    {
        if (number == 0) return "zéro";
        if (number < 0) return "moins " + NumberToWords(Math.Abs(number));

        string words = "";
        if ((number / 1000000) > 0)
        {
            words += NumberToWords(number / 1000000) + " million ";
            number %= 1000000;
        }
        if ((number / 1000) > 0)
        {
            if (number / 1000 == 1) words += "mille ";
            else words += NumberToWords(number / 1000) + " mille ";
            number %= 1000;
        }
        if ((number / 100) > 0)
        {
            if (number / 100 == 1) words += "cent ";
            else words += NumberToWords(number / 100) + " cent ";
            number %= 100;
        }
        if (number > 0)
        {
            if (words != "") words += "";
            var unitsMap = new[] { "zéro", "un", "deux", "trois", "quatre", "cinq", "six", "sept", "huit", "neuf", "dix", "onze", "douze", "treize", "quatorze", "quinze", "seize", "dix-sept", "dix-huit", "dix-neuf" };
            var tensMap = new[] { "zéro", "dix", "vingt", "trente", "quarante", "cinquante", "soixante", "soixante-dix", "quatre-vingt", "quatre-vingt-dix" };

            if (number < 20) words += unitsMap[number];
            else
            {
                words += tensMap[number / 10];
                if ((number % 10) > 0) words += "-" + unitsMap[number % 10];
            }
        }
        return words.Trim();
    }

    private string FormatPaymentMethod(string? method)
    {
        return method switch
        {
