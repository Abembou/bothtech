@page "/admin/comptabilite"
@layout bothtech.Shared.Layout.AdminLayout
@using bothtech.Shared.Models
@using System.Globalization

<PageTitle>Comptabilité | Console Admin</PageTitle>

<!-- ONGLETS COMPTABILITÉ (CORRECTION LAMBDA AVEC LES ACCOLADES { } ) -->
<div class="compta-tabs" style="display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 2px solid var(--border); padding-bottom: 10px; flex-wrap: wrap;">
    <button class="compta-tab-btn @(ActiveTab == "journal" ? "active" : "")" @onclick='() => { ActiveTab = "journal"; }'>Grand Livre de Caisse</button>
    <button class="compta-tab-btn @(ActiveTab == "depenses" ? "active" : "")" @onclick='() => { ActiveTab = "depenses"; }'>Saisie des Dépenses</button>
</div>

@if (ActiveTab == "journal")
{
    <!-- TAB 1 : GRAND LIVRE DE CAISSE -->
    <div class="kpi-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 20px;">
        <div class="kpi-card" style="background: white; padding: 20px; border-radius: 12px; border: 1px solid var(--border);">
            <span class="kpi-title" style="font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Total des Entrées (Ventes)</span>
            <span class="kpi-value green" style="font-size: 1.8rem; font-weight: 900; color: var(--success);">@FormatMoney(TotalEntrees)</span>
        </div>
        <div class="kpi-card" style="background: white; padding: 20px; border-radius: 12px; border: 1px solid var(--border);">
            <span class="kpi-title" style="font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Total des Sorties (Dépenses)</span>
            <span class="kpi-value red" style="font-size: 1.8rem; font-weight: 900; color: var(--danger);">@FormatMoney(TotalSorties)</span>
        </div>
        <div class="kpi-card" style="background: white; padding: 20px; border-radius: 12px; border: 2px solid var(--primary);">
            <span class="kpi-title" style="font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">SOLDE GLOBAL EN CAISSE</span>
            <span class="kpi-value blue" style="font-size: 1.8rem; font-weight: 900; color: var(--primary);">@FormatMoney(SoldeGlobal)</span>
        </div>
    </div>

    <section class="card">
        <div class="card-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:15px;">
            <h2 class="card-title">Journal des Opérations</h2>
            <div style="display:flex; gap:10px; align-items:center;">

                <!-- CORRECTION TIMEONLY : On sépare "value" et "@onchange" et on ajoute les { } dans le lambda -->
                <input type="month" value="@FilterMonth" @onchange='e => { FilterMonth = e.Value?.ToString() ?? ""; }' class="form-control" style="max-width: 200px;">

                <button class="btn btn-outline" style="padding: 6px 12px; background:var(--primary-subtle); color:var(--primary); font-weight:bold;" @onclick="LoadJournal">🔄 Rafraîchir</button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type d'Opération</th>
                        <th>Libellé / Motif</th>
                        <th style="text-align: right; color: var(--success);">Entrée (+)</th>
                        <th style="text-align: right; color: var(--danger);">Sortie (-)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (IsLoadingJournal)
                    {
                        <tr><td colspan="5" style="text-align: center; padding: 20px;">Chargement du journal...</td></tr>
                    }
                    else if (!JournalOperations.Any())
                    {
                        <tr><td colspan="5" style="text-align: center; padding: 20px; color: var(--text-muted);">Aucune opération comptable pour cette période.</td></tr>
                    }
                    else
                    {
                        @foreach (var op in JournalOperations)
                        {
                            <tr style="background-color: @(op.IsEntree ? "#f0fdf4" : "#fef2f2");">
                                <td><small>@FormatDate(op.Date)</small></td>
                                <td><b>@(op.IsEntree ? "Entrée" : "Sortie")</b><br><small style="color:var(--text-muted);">@op.Categorie</small></td>
                                <td>@op.Libelle</td>
                                <td style="text-align:right; font-weight:bold; color:var(--success);">@(op.IsEntree? FormatMoney(op.Montant) : "-")</td>
                                <td style="text-align:right; font-weight:bold; color:var(--danger);">@(!op.IsEntree ? FormatMoney(op.Montant) : "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
}
else
{
    <!-- TAB 2 : SAISIE DES DÉPENSES -->
    <div class="dashboard-grid" style="display: grid; grid-template-columns: 1fr; gap: 20px;">
        <section class="card">
            <div class="card-header"><h2 class="card-title">💸 Enregistrer une Dépense</h2></div>
            <div class="card-body">
                <EditForm Model="NewExpense" OnValidSubmit="SaveExpense">
                    <div class="form-group">
                        <label>Catégorie de la dépense *</label>
                        <InputSelect @bind-Value="NewExpense.Categorie" class="form-control" required>
                            <option value="Achat Stock / Fournisseur">Achat Stock / Fournisseur</option>
                            <option value="Loyer">Loyer Boutique</option>
                            <option value="Électricité / Eau">Électricité / Eau (SONABEL, ONEA)</option>
                            <option value="Carburant / Transport">Carburant / Transport</option>
                            <option value="Salaire Manuel">Salaire Manuel (RH)</option>
                            <option value="Frais Bancaires">Frais Bancaires / Mobile Money</option>
                            <option value="Autre">Autre Dépense</option>
                        </InputSelect>
                    </div>
                    <div class="form-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                        <div class="form-group"><label>Montant (FCFA) *</label><InputNumber @bind-Value="NewExpense.Montant" class="form-control" required min="1" /></div>

                        <!-- CORRECTION TIMEONLY : Utilisation du InputDate officiel de Blazor lié à un DateTime -->
                        <div class="form-group"><label>Date *</label><InputDate @bind-Value="NewExpense.DateSortie" class="form-control" required /></div>
                    </div>
                    <div class="form-group"><label>Bénéficiaire / Destinataire *</label><InputText @bind-Value="NewExpense.Beneficiaire" class="form-control" placeholder="Ex: Jean, SONABEL..." required /></div>
                    <div class="form-group"><label>Motif / Libellé détaillé *</label><InputText @bind-Value="NewExpense.Motif" class="form-control" required /></div>
                    <div class="form-group">
                        <label>Moyen de Paiement *</label>
                        <InputSelect @bind-Value="NewExpense.MoyenPaiement" class="form-control" required>
                            <option value="Espèces">Caisse (Espèces)</option>
                            <option value="Orange Money">Orange Money</option>
                            <option value="Moov Money">Moov Money</option>
                            <option value="Virement Bancaire">Virement Bancaire</option>
                        </InputSelect>
                    </div>
                    <button type="submit" class="btn btn-primary" style="width: 100%; background:var(--danger); border-color:var(--danger); cursor:pointer;">Soumettre la Dépense</button>
                </EditForm>
            </div>
        </section>
    </div>
}

@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div id="toast" style="display:block;">@ToastMessage</div>
}

@code {
    private string ActiveTab = "journal";
    private bool IsLoadingJournal = false;
    private string FilterMonth = DateTime.Now.ToString("yyyy-MM");
    private string ToastMessage = "";

    public class AccountingOperation
    {
        public long Date { get; set; }
        public bool IsEntree { get; set; }
        public string Categorie { get; set; }
        public string Libelle { get; set; }
        public int Montant { get; set; }
    }

    public class ExpenseItem
    {
        public string Categorie { get; set; } = "Achat Stock / Fournisseur";
        public int Montant { get; set; }
        // Utilisation stricte de DateTime pour éviter l'erreur de conversion
        public DateTime DateSortie { get; set; } = DateTime.Today;
        public string Beneficiaire { get; set; }
        public string Motif { get; set; }
        public string MoyenPaiement { get; set; } = "Espèces";
    }

    private ExpenseItem NewExpense = new();
    private List<AccountingOperation> JournalOperations = new();

    // KPIs calculés dynamiquement
    private int TotalEntrees => JournalOperations.Where(o => o.IsEntree).Sum(o => o.Montant);
    private int TotalSorties => JournalOperations.Where(o => !o.IsEntree).Sum(o => o.Montant);
    private int SoldeGlobal => TotalEntrees - TotalSorties;

    protected override async Task OnInitializedAsync()
    {
        await LoadJournal();
    }

    private async Task LoadJournal()
    {
        IsLoadingJournal = true;
        await Task.Delay(400); // Simulation réseau

        // Simulation de données dans le Grand Livre
        JournalOperations = new List<AccountingOperation>
        {
            new AccountingOperation { Date = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(), IsEntree = true, Categorie = "Vente", Libelle = "Facture #P123 - Client Comptoir", Montant = 195000 },
            new AccountingOperation { Date = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - 86400000, IsEntree = false, Categorie = "Loyer", Libelle = "À: Propriétaire - Loyer Mois en cours", Montant = 75000 }
        };

        IsLoadingJournal = false;
    }

    private async Task SaveExpense()
    {
        // Enregistrement de la dépense
        JournalOperations.Insert(0, new AccountingOperation
        {
            Date = new DateTimeOffset(NewExpense.DateSortie).ToUnixTimeMilliseconds(),
            IsEntree = false,
            Categorie = NewExpense.Categorie,
            Libelle = $"À: {NewExpense.Beneficiaire} - {NewExpense.Motif}",
            Montant = NewExpense.Montant
        });

        NewExpense = new ExpenseItem(); // Reset form
        ActiveTab = "journal"; // Bascule automatique vers le grand livre
        await ShowToast("✅ Dépense enregistrée avec succès !");
    }

    private string FormatMoney(int amount)
    {
        var nfi = (NumberFormatInfo)CultureInfo.GetCultureInfo("fr-FR").NumberFormat.Clone();
        nfi.NumberGroupSeparator = " ";
        return amount.ToString("N0", nfi) + " FCFA";
    }

    private string FormatDate(long timestamp)
    {
        return DateTimeOffset.FromUnixTimeMilliseconds(timestamp).LocalDateTime.ToString("dd/MM/yyyy HH:mm");
    }

    private async Task ShowToast(string message)
    {
        ToastMessage = message;
        StateHasChanged();
        await Task.Delay(3000);
        ToastMessage = "";
        StateHasChanged();
    }
}