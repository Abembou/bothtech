@page "/vente/chat"
@layout bothtech.Shared.Layout.AdminLayout
@using bothtech.Shared.Services
@using bothtech.Shared.Models
@using System.Security.Cryptography
@using System.IO
@using System.Threading
@using System.Net.Http
@using System.Text.Json
@using System.Globalization
@inject DataSyncService DataSync
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@implements IDisposable

<PageTitle>Messagerie et Gestion des Tickets | Console Admin</PageTitle>

<style>
    /* =========================================
       STYLES DE L'APPLICATION (ÉCRAN)
       ========================================= */
    .chat-container-full {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 80px);
        background: transparent;
        margin: -10px;
        overflow: hidden;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .chat-layout {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        width: 100%;
    }

    .chat-sidebar {
        flex: 1;
        width: 100%;
        background: #fff;
        display: @(selectedClientId == null ? "flex" : "none");
        flex-direction: column;
        min-height: 0;
    }

    .chat-list {
        flex: 1;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    .chat-main {
        flex: 1;
        width: 100%;
        display: @(selectedClientId != null ? "flex" : "none");
        flex-direction: column;
        overflow: hidden;
        background: #f8fafc;
        min-height: 0;
    }

    .chat-item {
        padding: 15px;
        border-bottom: 1px solid var(--border);
        cursor: pointer;
        transition: background 0.2s;
    }

        .chat-item:active {
            background: #f1f5f9;
        }

        .chat-item.active {
            background: #eff6ff;
            border-left: 4px solid var(--primary);
            padding-left: 11px;
        }

    .chat-item-name {
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--text-main);
        display: flex;
        align-items: center;
    }

    .chat-item-preview {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .tab-content-panel {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 15px;
        background: #f8fafc;
        -webkit-overflow-scrolling: touch;
        min-height: 0;
    }

    .chat-messages {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .chat-input-container {
        display: flex;
        align-items: center;
        padding: 10px;
        gap: 8px;
        border-top: 1px solid var(--border);
        background: #fff;
        flex-shrink: 0;
        width: 100%;
    }

    .receipt-block {
        margin-top: 10px;
        padding: 20px;
        border-radius: 12px;
        background: white;
        border: 1px solid var(--border);
    }

    .receipt-row {
        margin-bottom: 8px;
        font-size: 1rem;
        display: flex;
        justify-content: space-between;
    }

    .receipt-total {
        font-size: 1.3rem;
        padding-top: 15px;
        margin-top: 10px;
        font-weight: bold;
        border-top: 2px solid var(--border);
        display: flex;
        justify-content: space-between;
    }

    @@media (min-width: 768px) {
        .chat-layout { flex-direction: row; }
        .chat-sidebar { width: 350px; max-width: 40%; flex: none; display: flex !important; border-right: 1px solid var(--border); }
        .chat-main { display: flex !important; }
        .mobile-only-display { display: none !important; }
    }

    /* =========================================
       STYLES D'IMPRESSION (FACTURE A4)
       ========================================= */
    @@media screen {
        .only-print { display: none !important; }
    }

    @@media print {
        @@page { size: A4; margin: 0; }

        body * { visibility: hidden; }

        html, body {
            overflow: visible !important;
            height: auto !important;
            background-color: #fff !important;
            margin: 0 !important;
            padding: 15mm !important;
        }

        .only-print {
            visibility: visible !important;
            position: absolute;
            top: 10mm;
            left: 10mm;
            right: 10mm;
            display: block !important;
            margin: 0;
            padding: 0;
        }

        .only-print * { visibility: visible !important; }

        /* Design de la Facture */
        .facture-container { font-family: 'Segoe UI', Arial, sans-serif; color: #0f172a; }
        .facture-top-bar { border-top: 8px solid #1d4ed8; width: 100%; margin-bottom: 25px; }
        .facture-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px; }
        .facture-title-box { text-align: center; margin-bottom: 40px; }
        .facture-title { display: inline-block; font-size: 1.8rem; font-weight: 900; letter-spacing: 3px; color: #0f172a; text-transform: uppercase; border-top: 3px solid #1d4ed8; border-bottom: 3px solid #1d4ed8; padding: 8px 20px; margin: 0; }
        .facture-cards { display: flex; gap: 20px; margin-bottom: 30px; }
        .facture-card { flex: 1; border: 1px solid #cbd5e1; border-radius: 8px; padding: 15px; background: #f8fafc; }
        .facture-card h4 { font-size: 0.8rem; color: #64748b; margin-top: 0; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px; }
        .facture-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        .facture-table th { background-color: #1e293b; color: white; padding: 12px 10px; text-align: left; font-size: 0.9rem; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        .facture-table td { padding: 12px 10px; border-bottom: 1px solid #e2e8f0; font-size: 0.95rem; }
        .facture-totals-wrapper { display: flex; justify-content: flex-end; margin-bottom: 30px; }
        .facture-totals-table { width: 300px; border-collapse: collapse; }
        .facture-totals-table td { padding: 10px; border: 1px solid #e2e8f0; }
        .total-row { background-color: #1d4ed8; color: white; font-weight: bold; font-size: 1.1rem; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        .amount-in-words { border-left: 4px solid #1d4ed8; padding-left: 15px; margin-bottom: 50px; font-size: 0.95rem; }
        .signatures { display: flex; justify-content: space-around; margin-top: 40px; text-align: center; }
        .signatures div { width: 40%; }
        .sig-line { border-bottom: 1px solid #cbd5e1; margin-top: 60px; margin-bottom: 10px; }
        .custom-print-footer {
            position: fixed;
            bottom: 10mm;
            left: 0;
            width: 100%;
            text-align: center;
            font-size: 0.9rem;
            font-weight: 700;
            color: #1d4ed8;
            letter-spacing: 1px;
        }
    }
</style>

<!-- =========================================
     MODÈLE D'IMPRESSION (FACTURE EXACTE A4)
     ========================================= -->
@if (InvoiceToPrint != null)
{
    <div class="only-print facture-container">
        <div class="facture-top-bar"></div>

        <div class="facture-header">
            <!-- Logo et Enseigne -->
            <div style="display: flex; align-items: center; gap: 15px;">
                <div style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; overflow:hidden;">
                    <img src="/images/Both_Tech_Burkina.jpeg" style="max-width: 100%; max-height: 100%; object-fit: contain;" alt="Logo Both Tech" />
                </div>
                <div>
                    <h2 style="margin: 0; color: #0f172a; font-weight: 900; font-size: 1.5rem; letter-spacing: 1px;">@(localCompanyInfos?.Name ?? "BOTH TECH BURKINA")</h2>
                    <p style="margin: 5px 0; color: #64748b; font-size: 0.9rem; text-transform: uppercase;">Vente de matériels informatiques</p>
                    <p style="margin: 0; color: #1d4ed8; font-weight: bold;">Réf. Facture : @InvoiceToPrint.Id?.Substring(0, 8).ToUpper()</p>
                </div>
            </div>

            <!-- Infos Entreprise Droite -->
            <div style="text-align: right;">
                <h3 style="margin: 0; font-weight: 900; font-size: 1.2rem;">@(localCompanyInfos?.Country ?? "BURKINA FASO")</h3>
                <p style="margin: 5px 0; color: #1d4ed8; font-style: italic; font-size: 0.9rem;">@(localCompanyInfos?.Slogan ?? "La Patrie ou la Mort, nous vaincrons")</p>
                <p style="margin: 5px 0; font-size: 0.85rem;"><b>N° IFU :</b> @(localCompanyInfos?.Ifu ?? "0000000000X")</p>
                <p style="margin: 5px 0; font-size: 0.85rem;"><b>Adresse :</b> @(localCompanyInfos?.Address ?? "Ouagadougou, Kadiogo")</p>
                <p style="margin: 5px 0; font-size: 0.85rem;"><b>Tél :</b> @(localCompanyInfos?.Phone ?? "+226 70 00 00 00")</p>
            </div>
        </div>

        <div class="facture-title-box">
            <h1 class="facture-title">FACTURE / DEVIS</h1>
        </div>

        <div class="facture-cards">
            <div class="facture-card">
                <h4>Détails du document</h4>
                <p style="margin: 5px 0;"><b>Date d'émission :</b> @FormatDate(InvoiceToPrint.CreatedAt)</p>
                <p style="margin: 5px 0; display: flex; align-items: center; gap: 8px;">
                    <b>Statut :</b> 
                    <span style="background: #eff6ff; color: #1d4ed8; padding: 2px 8px; border-radius: 4px; font-weight: 600; font-size: 0.85rem; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important;">@(InvoiceToPrint.Status.ToUpper())</span>
                </p>
            </div>
            <div class="facture-card">
                <h4>Facturé à</h4>
                <p style="margin: 5px 0; font-size: 1.1rem;"><b>@(InvoiceToPrint.RecipientName ?? InvoiceToPrint.ClientName)</b></p>
                <p style="margin: 5px 0;"><b>Tél :</b> @(InvoiceToPrint.RecipientPhone ?? "-")</p>
                <p style="margin: 5px 0;"><b>Adresse :</b> @(InvoiceToPrint.RecipientAddress ?? "-")</p>
            </div>
        </div>

        <table class="facture-table">
            <thead>
                <tr>
                    <th style="width: 5%;">N°</th>
                    <th style="width: 45%;">Désignation</th>
                    <th style="width: 10%; text-align: center;">Qté</th>
                    <th style="width: 20%; text-align: right;">PU</th>
                    <th style="width: 20%; text-align: right;">PT</th>
                </tr>
            </thead>
            <tbody>
                @if (InvoiceToPrint.Items != null)
                {
                    int index = 1;
                    foreach (var item in InvoiceToPrint.Items)
                    {
                        <tr>
                            <td style="color: #64748b;">@index</td>
                            <td>@item.Name</td>
                            <td style="text-align: center;">@item.Quantity</td>
                            <td style="text-align: right;">@FormatMoney((double)item.Price)</td>
                            <td style="text-align: right; font-weight: bold; color: #0f172a;">@FormatMoney((double)(item.Quantity * item.Price))</td>
                        </tr>
                        index++;
                    }
                }
            </tbody>
        </table>

        <div class="facture-totals-wrapper">
            <table class="facture-totals-table">
                <tr>
                    <td style="text-align: right; font-weight: 600; text-transform: uppercase; color: #64748b;">Sous-Total :</td>
                    <td style="text-align: right; font-weight: bold; font-size: 1.05rem;">@FormatMoney((double)(InvoiceToPrint.Items?.Sum(i => i.Quantity * i.Price) ?? 0))</td>
                </tr>
                @if (InvoiceToPrint.DeliveryFee > 0)
                {
                    <tr>
                        <td style="text-align: right; font-weight: 600; text-transform: uppercase; color: #64748b;">Livraison :</td>
                        <td style="text-align: right; font-weight: bold; font-size: 1.05rem;">@FormatMoney((double)(InvoiceToPrint.DeliveryFee ?? 0))</td>
                    </tr>
                }
                @if (InvoiceToPrint.Discount > 0)
                {
                    <tr>
                        <td style="text-align: right; font-weight: 600; text-transform: uppercase; color: #ef4444;">Réduction :</td>
                        <td style="text-align: right; font-weight: bold; color: #ef4444;">- @FormatMoney((double)(InvoiceToPrint.Discount ?? 0))</td>
                    </tr>
                }
                <tr class="total-row">
                    <td style="text-align: right;">TOTAL FACTURE :</td>
                    <td style="text-align: right;">@FormatMoney((double)(InvoiceToPrint.Total ?? 0))</td>
                </tr>
            </table>
        </div>

        <div class="amount-in-words">
            Arrêtée la présente facture à la somme de :<br>
            <b style="color: #0f172a;">@ConvertAmountToWords((double?)InvoiceToPrint.Total).ToUpper() FRANCS CFA.</b>
        </div>

        <div class="signatures">
            <div>
                <span style="font-size: 0.85rem; font-weight: 600; color: #64748b; letter-spacing: 1px;">LE CLIENT</span>
                <div class="sig-line"></div>
                <b>@(InvoiceToPrint.RecipientName ?? InvoiceToPrint.ClientName)</b>
            </div>
            <div>
                <span style="font-size: 0.85rem; font-weight: 600; color: #64748b; letter-spacing: 1px;">LE CONSEILLER</span>
                <div class="sig-line"></div>
                <b>@(InvoiceToPrint.TraitePar ?? currentAdminName)</b>
            </div>
        </div>

        <div class="custom-print-footer">
            BothTech burkina la référence du numérique
        </div>
    </div>
}

<div class="chat-container-full no-print">
    <div class="chat-layout">
        <!-- COLONNE 1 : LISTE DES CHATS -->
        <div class="chat-sidebar">
            <div style="padding: 15px; border-bottom: 1px solid var(--border); background: #f8fafc; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: 800; font-size: 1.1rem; color: var(--text-main);">Discussions</span>
                <select class="form-control" style="width: auto; padding: 5px; font-size: 0.85rem;" @bind="archiveFilter">
                    <option value="active">Actives</option>
                    <option value="archive">Archives</option>
                </select>
            </div>

            <div class="chat-list">
                @if (isLoadingData)
                {
                    <div style="text-align: center; padding: 20px;">Chargement...</div>
                }
                else if (!FilteredChatUids.Any())
                {
                    <div style="text-align: center; padding: 20px;">Aucune discussion.</div>
                }
                else
                {
                    @foreach (var uid in FilteredChatUids)
                    {
                        var msgs = localChats.ContainsKey(uid) ? localChats[uid].Messages?.Values.OrderBy(m => m.Timestamp).ToList() : new List<ChatMessageFirebase>();
                        var lastMsg = msgs?.LastOrDefault();
                        string clientName = localUsers.ContainsKey(uid) ? (localUsers[uid].ShopName ?? localUsers[uid].Name ?? localUsers[uid].Email) : "Client Inconnu";
                        bool isB2B = localUsers.ContainsKey(uid) && (localUsers[uid].Role == "detaillant" || localUsers[uid].Role == "detaillantB2B");

                        var clientOrders = localOrders.Values.Where(o => o.ClientId == uid || o.UserId == uid).OrderByDescending(o => o.CreatedAt).ToList();
                        var latestOrder = clientOrders.FirstOrDefault();
                        bool isLockedForMe = latestOrder != null && !string.IsNullOrEmpty(latestOrder.TraitePar) && latestOrder.TraitePar != currentAdminName && !isAdminOrMaintenance;

                        <div class="chat-item @(selectedClientId == uid ? "active" : "")" @onclick="() => SelectClient(uid, clientName)" style="@(isLockedForMe ? "opacity: 0.5;" : "")">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 6px;">
                                <span class="chat-item-name">
                                    @clientName
                                    @if (isB2B)
                                    {
                                        <span style="background:var(--purple); color:white; border-radius:4px; padding:2px 4px; font-size:0.6rem; margin-left:4px;">B2B</span>
                                    }
                                    @if (isLockedForMe)
                                    {
                                        <span style="font-size:0.8rem; margin-left:4px;">🔒</span>
                                    }
                                </span>
                                @if (lastMsg != null)
                                {
                                    if (lastMsg.SenderId != currentAdminUid)
                                    {
                                        <span style="background:#fef2f2; color:#b91c1c; padding:2px 6px; border-radius:4px; font-size:0.7rem; font-weight:bold;">Client</span>
                                    }
                                    else
                                    {
                                        <span style="background:#ecfdf5; color:#047857; padding:2px 6px; border-radius:4px; font-size:0.7rem; font-weight:bold;">Répondu</span>
                                    }
                                }
                                else
                                {
                                    <span style="background:#f1f5f9; color:#64748b; padding:2px 6px; border-radius:4px; font-size:0.7rem;">Nouveau</span>
                                }
                            </div>
                            <div class="chat-item-preview">
                                @(lastMsg != null ? (lastMsg.IsAudio ? "🎤 Message vocal" : (!string.IsNullOrEmpty(lastMsg.AttachmentDataUrl) ? "📎 Fichier joint" : DecryptMessage(lastMsg.Text))) : "...")
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- COLONNE 2 : CHAT ACTIF / FACTURE -->
        <div class="chat-main">
            @if (selectedClientId != null)
            {
                var activeOrder = localOrders.Values.Where(o => o.ClientId == selectedClientId || o.UserId == selectedClientId).OrderByDescending(o => o.CreatedAt).FirstOrDefault();
                bool isUnassigned = activeOrder != null && string.IsNullOrEmpty(activeOrder.TraitePar);
                bool isLocked = activeOrder != null && !string.IsNullOrEmpty(activeOrder.TraitePar) && activeOrder.TraitePar != currentAdminName && !isAdminOrMaintenance;

                bool canWriteMsg = !isLocked && !isUnassigned && canModifyMessages;

                <div style="display:flex; align-items:center; padding: 15px; border-bottom: 1px solid var(--border); background: #fff;">
                    <button class="btn btn-outline mobile-only-display" @onclick="() => selectedClientId = null" style="padding: 5px 10px; border:none; margin-right: 10px;">🔙</button>
                    <div style="display:flex; flex-direction:column; flex:1;">
                        <span style="font-weight:800; font-size:1.1rem; color:var(--text-main);">👤 @selectedClientName</span>
                        <span style="font-size:0.85rem; color:var(--text-muted); margin-top:4px;">
                            📞 @(activeOrder?.RecipientPhone ?? "N/A") | 🏠 @(activeOrder?.RecipientAddress ?? "N/A") | Conseiller: <b>@(activeOrder?.TraitePar ?? "Aucun")</b>
                        </span>
                    </div>
                </div>

                <div style="display: flex; padding: 10px; background: #fff; border-bottom: 1px solid var(--border); gap: 8px; flex-wrap: wrap;">
                    @if (!isLocked)
                    {
                        <button class="btn @(currentTab == "details" ? "btn-primary" : "btn-outline")" style="flex:1;" @onclick='() => SwitchTab("details")'>🧾 Facture</button>
                    }
                    <button class="btn @(currentTab == "messages" ? "btn-primary" : "btn-outline")" style="flex:1;" @onclick='() => SwitchTab("messages")'>💬 Messages</button>
                    @if (!isLocked && canModifyMessages && (activeOrder?.Status == "nouveau" || activeOrder?.Status == "en_cours") && activeOrder?.Type != "comptoir")
                    {
                        <button class="btn @(currentTab == "transfer" ? "btn-primary" : "btn-outline")" style="flex:1;" @onclick='() => SwitchTab("transfer")'>🤝 Transférer</button>
                    }
                </div>

                @if (currentTab == "transfer" && canModifyMessages)
                {
                    <div class="tab-content-panel">
                        <label style="font-size:0.95rem; font-weight:bold; color:var(--text-main);">Transférer ce ticket à :</label>
                        <div style="display:flex; gap:10px; margin-top: 10px;">
                            <select class="form-control" @bind="selectedTransferAgent">
                                <option value="">-- Choisir un agent --</option>
                                @foreach (var u in localUsers.Values.Where(u => u.Role != "client" && u.Name != currentAdminName))
                                {
                                    <option value="@u.Name">@u.Name (@u.Role)</option>
                                }
                            </select>
                            <button class="btn btn-success" @onclick="TransferTicket">Valider</button>
                        </div>
                    </div>
                }

                @if (currentTab == "details")
                {
                    <div class="tab-content-panel">
                        @if (isUnassigned)
                        {
                            <div style="text-align:center; padding:40px 20px; background:white; border-radius:12px; border:1px solid var(--border);">
                                <h3 style="color:var(--primary); margin-bottom: 15px;">Nouveau Devis</h3>
                                <p style="margin-bottom:20px;">Ce ticket n'est assigné à personne.</p>
                                @if (canModifyMessages)
                                {
                                    <button class="btn btn-primary" @onclick="TakeChargeTicket">✋ Prendre en charge</button>
                                }
                            </div>
                        }
                        else if (activeOrder != null)
                        {
                            bool isEditable = (activeOrder.Status == "nouveau" || activeOrder.Status == "en_cours") && activeOrder.Type != "comptoir" && canModifyMessages;

                            activeOrder.DeliveryType = "livraison";
                            decimal itemsSubtotal = activeOrder.Items.Sum(i => i.Quantity * (decimal)i.Price);
                            decimal finalDelivery = (decimal)(activeOrder.DeliveryFee ?? 0);
                            decimal finalDiscount = (decimal)(activeOrder.Discount ?? 0);
                            decimal finalTotal = itemsSubtotal + finalDelivery - finalDiscount;

                            decimal totalMaxDiscountAllowed = 0;
                            foreach (var item in activeOrder.Items)
                            {
                                var matchedProduct = GetMatchingProduct(item);
                                if (matchedProduct != null) totalMaxDiscountAllowed += matchedProduct.MaxDiscount * item.Quantity;
                            }

                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;" class="no-print">
                                <strong style="font-size:1.15rem;">Devis #@activeOrder.Id.Substring(0, 6)</strong>
                                <span class="badge badge-info">@activeOrder.Status</span>
                            </div>

                            @if (isEditable)
                            {
                                <div style="background:white; padding:15px; border-radius:8px; border:1px solid var(--border); margin-bottom: 15px;">
                                    <h4 style="margin-bottom: 10px; font-size: 1rem;">Articles (Quantités ajustables)</h4>
                                    @foreach (var item in activeOrder.Items)
                                    {
                                        LocalProductDto? matchedProduct = GetMatchingProduct(item);
                                        int stockLeft = matchedProduct != null ? matchedProduct.Quantity : 0;
                                        decimal maxDiscountUnit = matchedProduct != null ? matchedProduct.MaxDiscount : 0;

                                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; border-bottom:1px dashed #eee; padding-bottom:10px; flex-wrap:wrap;">
                                            <div style="flex:1; min-width: 150px; font-size:0.95rem;">
                                                <b>@item.Name</b><br>
                                                <small style="color:var(--text-muted); line-height:1.6; display:inline-block; margin-top:4px;">
                                                    Stock: <b style="color:@(stockLeft > 0 ? "var(--success)" : "var(--danger)")">@stockLeft</b><br>
                                                    Prix U: @FormatMoney((double)item.Price)<br>
                                                    Réd. Max U: @FormatMoney((double)maxDiscountUnit)
                                                </small>
                                            </div>
                                            <input type="number" class="form-control" style="width:80px; text-align:center;" value="@item.Quantity" min="0" max="@(stockLeft > 0 ? stockLeft : 999)" @onchange="(e) => UpdateItemQuantity(item.Id, e.Value)" />
                                        </div>
                                    }
                                </div>

                                <div style="display:flex; flex-direction:column; gap:10px; margin-bottom: 15px; background:white; padding:15px; border-radius:8px; border:1px solid var(--border);">
                                    <h4 style="margin-bottom: 5px; font-size: 1rem;">Informations de Livraison</h4>
                                    <label style="font-size: 0.8rem; font-weight: bold;">Nom complet *</label>
                                    <input type="text" class="form-control" @bind="activeOrder.RecipientName" />
