@page "/ventecomptoir"
@layout bothtech.Shared.Layout.AdminLayout
@using bothtech.Shared.Models
@using bothtech.Shared.Services
@using System.Globalization
@inject DatabaseService DbService

<PageTitle>Vente Comptoir | Console Admin</PageTitle>

<!-- MENU DES ONGLETS DE VENTE -->
<div class="ventes-tabs ventes-tabs-top" style="padding: 0 10px;">
    <NavLink class="ventes-tab-btn" href="/commandes" style="text-decoration:none;">📋 Commandes en ligne</NavLink>
    <button class="ventes-tab-btn active">🛒 Vente Comptoir</button>
    <NavLink class="ventes-tab-btn" href="/venteb2b" style="text-decoration:none;">🏢 Ventes B2B (Gros)</NavLink>
</div>

@if (!IsFormView)
{
    <!-- VUE 1 : HISTORIQUE DES VENTES COMPTOIR -->
    <div style="padding: 0 10px 20px 10px;">
        <section class="card">
            <div class="card-header">
                <div style="display: flex; align-items: center; gap: 15px; width: 100%;">
                    <button class="btn btn-primary" style="background: var(--success); color: white; border: none; font-weight: bold; cursor: pointer; padding: 14px 15px; flex: 1;" @onclick="OpenNewSale">
                        + Nouvelle Vente
                    </button>
                    <h2 class="card-title hide-mobile" style="margin:0;">Historique Comptoir</h2>
                </div>
                <div class="search-filters">
                    <input type="search" placeholder="Rechercher..." class="form-control" @bind="SearchQuery" @bind:event="oninput">
                </div>
            </div>
            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th class="hide-mobile">Date / Réf</th>
                            <th>Client / Date</th>
                            <th class="hide-mobile">Montant</th>
                            <th style="text-align:right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr><td colspan="4" style="text-align:center; padding:20px;">Chargement...</td></tr>
                        }
                        else if (!FilteredHistory.Any())
                        {
                            <tr><td colspan="4" style="text-align:center; padding:20px; color:var(--text-muted);">Aucune vente locale trouvée.</td></tr>
                        }
                        else
                        {
                            @foreach (var order in FilteredHistory)
                            {
                                <tr>
                                    <td class="hide-mobile">
                                        <small style="color:var(--text-muted);">@FormatDate(order.CreatedAt)</small><br>
                                        <b style="color:var(--primary);">#@order.Id?.Substring(0, 6).ToUpper()</b>
                                    </td>
                                    <td>
                                        <b>@order.ClientName</b><br>
                                        <small style="color:var(--text-muted);">@(string.IsNullOrEmpty(order.ClientPhone) ? "Pas de tél" : order.ClientPhone)</small>

                                        <!-- Affichage Mobile -->
                                        <div class="mobile-only-display" style="margin-top:5px; font-size:0.8rem; border-top:1px dashed var(--border); padding-top:5px;">
                                            <span style="color:var(--text-muted);">@FormatDate(order.CreatedAt)</span> - <b style="color:var(--primary);">#@order.Id?.Substring(0, 6).ToUpper()</b><br>
                                            <b style="color: var(--text-main);">@FormatMoney(order.Total)</b>
                                        </div>
                                    </td>
                                    <td class="hide-mobile">
                                        <b>@FormatMoney(order.Total)</b><br>
                                        <small style="color:var(--text-muted);">@FormatPaymentMethod(order.PaymentMethod)</small>
                                    </td>
                                    <td style="text-align:right;">
                                        <button class="btn btn-outline btn-action">🖨️ Facture</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}
else
{
    <!-- VUE 2 : CAISSE (POINT DE VENTE) -->
    <div style="padding: 0 10px 20px 10px;">
        <section class="card caisse-card">
            <div class="card-header">
                <h2 class="card-title" style="margin:0; font-size: 1.1rem;">🛒 Caisse Directe</h2>
                <button type="button" class="btn btn-outline" style="cursor: pointer;" @onclick="CloseNewSale">🔙 Retour</button>
            </div>

            <div class="card-body caisse-body">
                <div style="background:#f8fafc; padding:15px; border-radius:8px; border:1px solid var(--border); margin-bottom:20px;">
                    <h3 style="font-size:0.95rem; margin-bottom:12px; color:var(--primary);">Coordonnées du Client</h3>
                    <div class="client-info-grid">
                        <input type="text" class="form-control" placeholder="Nom du Client *" @bind="SaleClientName">
                        <input type="tel" class="form-control" placeholder="Téléphone" @bind="SaleClientPhone">
                    </div>
                    <input type="text" class="form-control" placeholder="Adresse / Quartier" @bind="SaleClientAddress">
                </div>

                <!-- LIGNES DE COMMANDE -->
                <div>
                    @foreach (var line in PosLines)
                    {
                        <div class="pos-line-item">
                            <div style="flex:2;">
                                <label style="font-size:0.8rem; font-weight:bold; display:block; margin-bottom:5px;">Article</label>
                                <select class="form-control" value="@line.ProductFirebaseId" @onchange="@(e => OnProductSelected(line, e.Value.ToString()))">
                                    <option value="">-- Choisir --</option>
                                    @foreach (var p in _catalog)
                                    {
                                        <option value="@p.Id">@p.Name - @FormatMoney(p.Price) (Stock: @p.Quantity)</option>
                                    }
                                </select>
                            </div>
                            <div class="pos-line-inputs">
                                <div>
                                    <label style="font-size:0.8rem; font-weight:bold; display:block; margin-bottom:5px;">Qté</label>
                                    <input type="number" class="form-control" value="@line.Quantity" min="1" max="@line.MaxStock" @onchange="@(e => OnQuantityChanged(line, e.Value))" style="text-align:center;">
                                </div>
                                <div>
                                    <label style="font-size:0.8rem; font-weight:bold; display:block; margin-bottom:5px;">Total Ligne</label>
                                    <input type="text" class="form-control" value="@FormatMoney(line.LineTotal)" disabled style="font-weight:bold; background:#f1f5f9;">
                                </div>
                            </div>
                            <button class="btn btn-outline" @onclick="() => PosLines.Remove(line)" style="color:var(--danger); border-color:var(--danger-subtle); font-weight:bold;">Supprimer</button>
                        </div>
                    }
                </div>

                <button class="btn btn-outline" @onclick="AddLine" style="width:100%; margin-top:10px; border-style:dashed; cursor: pointer; padding: 14px; font-weight: 600;">+ Ajouter un article</button>

                <div class="receipt-block" style="margin-top:25px; padding: 15px; border-radius: 8px;">
                    <div class="receipt-row" style="font-size:1.05rem; display:flex; justify-content:space-between;">
                        <span>Sous-total:</span>
                        <span style="font-weight: bold;">@FormatMoney(SubTotal)</span>
                    </div>

                    <div style="display:flex; flex-direction: column; gap: 8px; margin:15px 0; background: #fff; padding: 15px; border-radius: 6px; border: 1px dashed var(--border);">
                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
                            <span style="font-size:0.95rem; color:var(--danger); font-weight: 600;">Réduction accordée:</span>
                            <!-- Binding sécurisé avec plafond -->
                            <input type="number" class="form-control" style="width:140px; text-align:right;" placeholder="0" min="0" value="@Discount" @onchange="OnDiscountChanged">
                        </div>
                        <div style="text-align:right;">
                            <small style="font-size:0.75rem; color:var(--purple); font-weight: 500;">Plafond max autorisé: <span>@FormatMoney(MaxDiscountAllowed)</span></small>
                        </div>
                    </div>

                    <div class="receipt-total" style="font-size: 1.2rem; border-top: 2px solid var(--border); padding-top: 15px; display:flex; justify-content:space-between;">
                        <span>TOTAL À PAYER:</span>
                        <span style="font-weight:bold; color:var(--primary);">@FormatMoney(FinalTotal)</span>
                    </div>
                </div>

                <div class="form-group" style="margin-top:20px; margin-bottom: 10px;">
                    <label style="font-weight: bold; display:block; margin-bottom: 8px;">Mode d'encaissement *</label>
                    <select class="form-control" @bind="SalePaymentMethod">
                        <option value="espece">Espèce (Cash)</option>
                        <option value="mobile_money">Mobile Money</option>
                        <option value="virement">Virement Bancaire</option>
                    </select>
                </div>
            </div>

            <div class="caisse-footer">
                <button class="btn btn-success" disabled="@IsProcessing" @onclick="SubmitSale" style="width:100%; background:var(--success); color:white; border:none; padding:16px; font-size:1.15rem; font-weight:bold; cursor: pointer; border-radius: 8px;">
                    @(IsProcessing ? "Encaissement..." : "✅ Encaisser Vente")
                </button>
            </div>
        </section>
    </div>
}

@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div id="toast" style="display:block;">@ToastMessage</div>
}

@code {
    private bool IsLoading = true;
    private bool IsFormView = false;
    private bool IsProcessing = false;
    private string ToastMessage = "";
    private string SearchQuery = "";

    // Données chargées
    private List<Product> _catalog = new();
    private List<Order> _historyOrders = new();

    // État du formulaire de Caisse
    private string SaleClientName = "Client de passage";
    private string SaleClientPhone = "";
    private string SaleClientAddress = "";
    private string SalePaymentMethod = "espece";
    private int Discount = 0;

    // Les lignes de la caisse
    private List<PosLineItem> PosLines = new();

    // Classe locale pour gérer les lignes de caisse
    public class PosLineItem
    {
        public string ProductFirebaseId { get; set; }
        public string ProductName { get; set; }
        public int Quantity { get; set; } = 1;
        public int UnitPrice { get; set; }
        public int MaxDiscountUnit { get; set; }
        public int MaxStock { get; set; }
        public int LineTotal => Quantity * UnitPrice;
    }

    // Propriétés calculées (Data Binding Magique)
    private int SubTotal => PosLines.Sum(l => l.LineTotal);
    private int MaxDiscountAllowed => PosLines.Sum(l => l.Quantity * l.MaxDiscountUnit);
    private int FinalTotal => Math.Max(0, SubTotal - Discount);

    private IEnumerable<Order> FilteredHistory => _historyOrders
        .Where(o => string.IsNullOrWhiteSpace(SearchQuery) ||
                    o.ClientName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (o.Id != null && o.Id.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(o => o.CreatedAt);

    protected override async Task OnInitializedAsync()
    {
        // Chargement du catalogue local depuis SQLite (anciennement MySQL dans le com)
        _catalog = await DbService.GetProductsAsync();

        // Simulation du chargement de l'historique
        _historyOrders = new List<Order>
        {
            new Order { Id = "-Pabc123", ClientName = "Jean Dupont", Total = 195000, PaymentMethod = "espece", CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() }
        };
        IsLoading = false;
    }

    private void OpenNewSale()
    {
        SaleClientName = "Client de passage";
        SaleClientPhone = "";
        SaleClientAddress = "";
        SalePaymentMethod = "espece";
        Discount = 0;
        PosLines.Clear();
        AddLine();
        IsFormView = true;
    }

    private void CloseNewSale()
    {
        IsFormView = false;
    }

    private void AddLine()
    {
        PosLines.Add(new PosLineItem());
    }

    private void OnProductSelected(PosLineItem line, string productId)
    {
        line.ProductFirebaseId = productId;
        var p = _catalog.FirstOrDefault(x => x.Id == productId);
        if (p != null)
        {
            line.ProductName = p.Name;
            line.UnitPrice = p.Price;
            line.MaxDiscountUnit = p.MaxDiscount ?? 0;
            line.MaxStock = p.Quantity;
            if (line.Quantity > line.MaxStock) line.Quantity = line.MaxStock;
        }
        else
        {
            line.UnitPrice = 0;
            line.MaxDiscountUnit = 0;
            line.MaxStock = 0;
        }
        ValidateDiscount();
    }

    private void OnQuantityChanged(PosLineItem line, object value)
    {
        if (int.TryParse(value?.ToString(), out int qty))
        {
            line.Quantity = qty > line.MaxStock ? line.MaxStock : (qty < 1 ? 1 : qty);
            ValidateDiscount();
        }
    }

    private void OnDiscountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int parsed))
        {
            Discount = parsed;
            ValidateDiscount();
        }
    }

    private void ValidateDiscount()
    {
        if (Discount > MaxDiscountAllowed)
        {
            Discount = MaxDiscountAllowed;
            // Ne pas utiliser await ShowToast ici car c'est synchrone, on met juste à jour l'UI
        }
    }

    private async Task SubmitSale()
    {
        var validLines = PosLines.Where(l => !string.IsNullOrEmpty(l.ProductFirebaseId) && l.Quantity > 0).ToList();
        if (!validLines.Any())
        {
            await ShowToast("⚠️ Veuillez sélectionner au moins un article.");
            return;
        }

        IsProcessing = true;

        // Préparation de la commande pour la base de données
        var order = new Order
        {
            Total = FinalTotal,
            ClientName = SaleClientName,
            PaymentMethod = SalePaymentMethod,
            Items = validLines.Select(l => new OrderItem
            {
                ProductFirebaseId = l.ProductFirebaseId,
                ProductName = l.ProductName,
                UnitPrice = l.UnitPrice,
                Quantity = l.Quantity
            }).ToList()
        };

        // On utilise notre DatabaseService pour enregistrer et déduire le stock
        bool success = await DbService.CreateLocalOrderAsync(order);

        if (success)
        {
            await ShowToast("✅ Vente Comptoir enregistrée et stock déduit !");

            // On l'ajoute à l'historique visuel
            order.Id = "-LOCAL" + DateTimeOffset.UtcNow.ToUnixTimeSeconds();
            order.CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            _historyOrders.Insert(0, order);

            // On met à jour le catalogue local en retirant les quantités
            foreach (var line in validLines)
            {
                var p = _catalog.FirstOrDefault(x => x.Id == line.ProductFirebaseId);
                if (p != null) p.Quantity -= line.Quantity;
            }

            IsFormView = false;
        }
        else
        {
            await ShowToast("❌ Erreur lors de l'enregistrement dans la base de données.");
        }

        IsProcessing = false;
    }

    private string FormatMoney(int amount)
    {
        var nfi = (NumberFormatInfo)CultureInfo.GetCultureInfo("fr-FR").NumberFormat.Clone();
        nfi.NumberGroupSeparator = " ";
        return amount.ToString("N0", nfi) + " FCFA";
    }

    private string FormatDate(long timestamp)
    {
        return DateTimeOffset.FromUnixTimeMilliseconds(timestamp).LocalDateTime.ToString("dd/MM/yyyy HH:mm");
    }

    private string FormatPaymentMethod(string method)
    {
        return method switch
        {
            "espece" => "Espèces",
            "mobile_money" => "Mobile Money",
            "virement" => "Virement Bancaire",
            _ => "Non spécifié"
        };
    }

    private async Task ShowToast(string message)
    {
        ToastMessage = message;
        StateHasChanged();
        await Task.Delay(3000);
        ToastMessage = "";
        StateHasChanged();
    }
}