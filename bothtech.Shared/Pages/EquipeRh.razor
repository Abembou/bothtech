@page "/equipe"
@layout bothtech.Shared.Layout.AdminLayout
@using bothtech.Shared.Models
@using System.Globalization
@using bothtech.Shared.Services
@inject FirebaseService FirebaseService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager

<PageTitle>Gestion de l'Équipe | Console Admin</PageTitle>
<div style="background: transparent; padding: 20px; margin: 0; overflow-x: hidden; padding-bottom: calc(85px + env(safe-area-inset-bottom, 20px)); font-family: 'Plus Jakarta Sans', sans-serif;">

    <!-- ONGLETS RH -->
    <div style="display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 2px solid var(--border); padding-bottom: 10px; flex-wrap: wrap;">
        <NavLink href="/equipe" class="rh-tab-btn active">Gestion de l'Équipe</NavLink>
        <NavLink href="/compteB2B" class="rh-tab-btn">Partenaires B2B</NavLink>
    </div>

    @if (!IsFormView)
    {
        <!-- VUE 1 : LISTE DE L'ÉQUIPE -->
        <section class="card">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <h2 class="card-title hide-mobile">Membres de l'Équipe</h2>
                <div style="display:flex; gap:10px; align-items:center; flex: 1; justify-content: flex-end;">
                    <input type="search" placeholder="Rechercher par nom..." class="form-control" @bind="SearchQuery" @bind:event="oninput" style="max-width: 350px;">
                    <button class="btn btn-primary" style="background: var(--success); color: white; border: none; font-weight: bold;" @onclick="OpenNewForm">
                        + Ajouter un employé
                    </button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Agent</th>
                            <th class="hide-mobile">Poste</th>
                            <th class="hide-mobile" style="text-align: center;">Statut</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr><td colspan="4" style="text-align:center;">Chargement...</td></tr>
                        }
                        else
                        {
                            @foreach (var staff in FilteredStaff)
                            {
                                <tr>
                                    <td>
                                        <b>@staff.Name</b><br>
                                        <small>✉️️ @staff.Email</small>
                                    </td>
                                    <td class="hide-mobile">
                                        <span class="badge" style="background:#e2e8f0; color:#334155;">@staff.Role</span>
                                    </td>
                                    <td class="hide-mobile" style="text-align: center;">
                                        <span style="color:@(staff.Active ? "var(--success)" : "var(--danger)"); font-weight:bold;">
                                            @(staff.Active ? "Actif" : "Suspendu")
                                        </span>
                                    </td>
                                    <td style="text-align:right;">
                                        <button class="btn btn-outline" style="margin-bottom:4px; width:100%;" @onclick="() => EditStaff(staff)">Éditer</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    else
    {
        <!-- VUE 2 : FORMULAIRE EMPLOYÉ -->
        <section class="card">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <h2 class="card-title">@(string.IsNullOrEmpty(EditingStaff.FirebaseUid) ? "Nouvelle Fiche" : "Modification Fiche")</h2>
                <button class="btn btn-outline" @onclick="CloseForm">🔙 Retour</button>
            </div>
            <div class="card-body">
                <EditForm Model="EditingStaff" OnValidSubmit="SaveStaff">

                    <h3 style="font-size:0.85rem; color:var(--primary); margin-bottom:10px; border-bottom:1px solid var(--border); padding-bottom:5px;">1. Informations Générales & Profil</h3>

                    <div class="form-group" style="margin-bottom: 15px;">
                        <label>Email de connexion *</label>
                        <InputText @bind-Value="EditingStaff.Email" class="form-control" disabled="@(!string.IsNullOrEmpty(EditingStaff.FirebaseUid))" required />
                    </div>

                    <div class="form-grid-2">
                        <div class="form-group">
                            <label>Nom complet *</label>
                            <InputText @bind-Value="EditingStaff.Name" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label>Sexe *</label>
                            <InputSelect @bind-Value="EditingStaff.Sexe" class="form-control">
                                <option value="Masculin">Masculin</option>
                                <option value="Féminin">Féminin</option>
                            </InputSelect>
                        </div>
                    </div>

                    <h3 style="font-size:0.85rem; color:var(--primary); margin-bottom:10px; margin-top:20px; border-bottom:1px solid var(--border); padding-bottom:5px;">2. Informations du Poste</h3>

                    <div class="form-group">
                        <label>Poste Actuel (Rôle) *</label>
                        <InputSelect @bind-Value="EditingStaff.Role" class="form-control" required>
                            <option value="secretaire">Secrétaire</option>
                            <option value="livreur">Livreur</option>
                            <option value="comptable">Comptable</option>
                            <option value="rh">Ressources Humaines (RH)</option>
                        </InputSelect>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width:100%; padding: 14px; font-size:1.05rem; margin-top:20px;">
                        💾 Enregistrer l'Employé
                    </button>
                </EditForm>
            </div>
        </section>
    }

    @if (!string.IsNullOrEmpty(ToastMessage))
    {
        <div id="toast" style="display:block;">@ToastMessage</div>
    }
</div>

@code {
    private bool IsLoading = true;
    private bool IsFormView = false;
    private string SearchQuery = "";
    private string ToastMessage = "";

    private List<User> _allStaff = new();
    private User EditingStaff = new();

    private IEnumerable<User> FilteredStaff => _allStaff
        .Where(s => string.IsNullOrWhiteSpace(SearchQuery) || (s.Name != null && s.Name.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500); // Simulation

        _allStaff = new List<User>
        {
            new User { FirebaseUid = "U1", Name = "KABORE Alain", Email = "alain@bothtech.bf", Role = "livreur", Active = true }
        };
        IsLoading = false;
    }

    private void OpenNewForm()
    {
        EditingStaff = new User { Role = "livreur", Sexe = "Masculin" };
        IsFormView = true;
    }

    private void EditStaff(User staff)
    {
        EditingStaff = new User
        {
            FirebaseUid = staff.FirebaseUid,
            Name = staff.Name,
            Email = staff.Email,
            Role = staff.Role,
            Sexe = staff.Sexe,
            Active = staff.Active
        };
        IsFormView = true;
    }

    private void CloseForm()
    {
        IsFormView = false;
    }

    private async Task SaveStaff()
    {
        // Logique de sauvegarde à implémenter avec FirebaseService
        await ShowToast("✅ Profil Agent enregistré !");
        IsFormView = false;
    }

    private async Task ShowToast(string message)
    {
        ToastMessage = message;
        StateHasChanged();
        await Task.Delay(3000);
        ToastMessage = "";
        StateHasChanged();
    }
}