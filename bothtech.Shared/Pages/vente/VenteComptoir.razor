@page "/vente/ventecomptoir"
@layout bothtech.Shared.Layout.AdminLayout
@using bothtech.Shared.Models
@using bothtech.Shared.Services
@using System.Globalization
@using System.Text.Json
@inject DatabaseService DbService
@inject DataSyncService DataSync
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager

<PageTitle>Vente Comptoir | Console Admin</PageTitle>

<style>
    /* =========================================
       STYLES DE L'APPLICATION (ÉCRAN)
       ========================================= */
    .ventes-tab-btn {
        padding: 10px 20px;
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--text-muted);
        background: transparent;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        text-decoration: none;
        display: inline-block;
    }

    .ventes-tab-btn:hover {
        background: #f1f5f9;
        color: var(--primary);
    }

    .ventes-tab-btn.active {
        background: var(--primary);
        color: white;
        box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
    }

    .mobile-only-display { display: none; }

    @@media (max-width: 768px) {
        .hide-mobile { display: none !important; }
        .mobile-only-display { display: block; }
        .pos-line-item { flex-direction: column; align-items: stretch; }
        .pos-line-item > div { width: 100%; min-width: 100% !important; }
        .pos-line-inputs { flex-direction: column; }
    }

    /* =========================================
       STYLES D'IMPRESSION (GÉNÉRATION PDF PUR)
       ========================================= */
    @@media screen {
        .only-print { display: none !important; }
    }

    @@media print {
        @@page { size: A4; margin: 0; }

        /* On cache absolument TOUT le site (Sidebar, Navbar, Formulaires) */
        body * { visibility: hidden; }

        html, body {
            overflow: visible !important;
            height: auto !important;
            background-color: #fff !important;
            margin: 0 !important;
            padding: 15mm !important;
        }

        /* On extrait la facture et on l'affiche au premier plan */
        .only-print {
            visibility: visible !important;
            position: absolute;
            top: 10mm;
            left: 10mm;
            right: 10mm;
            display: block !important;
            margin: 0;
            padding: 0;
        }

        .only-print * { visibility: visible !important; }

        /* Design de la Facture (Identique au B2B mais adapté Comptoir) */
        .facture-container { font-family: 'Segoe UI', Arial, sans-serif; color: #0f172a; }
        .facture-top-bar { border-top: 8px solid #10b981; width: 100%; margin-bottom: 25px; } /* Vert pour le comptoir */
        .facture-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px; }
        .facture-title-box { text-align: center; margin-bottom: 40px; }
        .facture-title { display: inline-block; font-size: 1.8rem; font-weight: 900; letter-spacing: 3px; color: #0f172a; text-transform: uppercase; border-top: 3px solid #10b981; border-bottom: 3px solid #10b981; padding: 8px 20px; margin: 0; }
        .facture-cards { display: flex; gap: 20px; margin-bottom: 30px; }
        .facture-card { flex: 1; border: 1px solid #cbd5e1; border-radius: 8px; padding: 15px; background: #f8fafc; }
        .facture-card h4 { font-size: 0.8rem; color: #64748b; margin-top: 0; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px; }
        .facture-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        .facture-table th { background-color: #1e293b; color: white; padding: 12px 10px; text-align: left; font-size: 0.9rem; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        .facture-table td { padding: 12px 10px; border-bottom: 1px solid #e2e8f0; font-size: 0.95rem; }
        .facture-totals-wrapper { display: flex; justify-content: flex-end; margin-bottom: 30px; }
        .facture-totals-table { width: 300px; border-collapse: collapse; }
        .facture-totals-table td { padding: 10px; border: 1px solid #e2e8f0; }
        .total-row { background-color: #10b981; color: white; font-weight: bold; font-size: 1.1rem; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        .amount-in-words { border-left: 4px solid #10b981; padding-left: 15px; margin-bottom: 50px; font-size: 0.95rem; }
        .signatures { display: flex; justify-content: space-around; margin-top: 40px; text-align: center; }
        .signatures div { width: 40%; }
        .sig-line { border-bottom: 1px solid #cbd5e1; margin-top: 60px; margin-bottom: 10px; }
        
        .custom-print-footer {
            position: fixed;
            bottom: 10mm;
            left: 0;
            width: 100%;
            text-align: center;
            font-size: 0.9rem;
            font-weight: 700;
            color: #10b981;
            letter-spacing: 1px;
        }
    }
</style>

<!-- =========================================
     MODÈLE D'IMPRESSION (FACTURE EXACTE A4)
     ========================================= -->
@if (InvoiceToPrint != null)
{
    <div class="only-print facture-container">
        <div class="facture-top-bar"></div>

        <div class="facture-header">
            <div style="display: flex; align-items: center; gap: 15px;">
                <div style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; overflow:hidden;">
                    <img src="/images/Both_Tech_Burkina.jpeg" style="max-width: 100%; max-height: 100%; object-fit: contain;" alt="Logo Both Tech" />
                </div>
                <div>
                    <h2 style="margin: 0; color: #0f172a; font-weight: 900; font-size: 1.5rem; letter-spacing: 1px;">@(CompanyInfos?.Name ?? "BOTH TECH BURKINA")</h2>
                    <p style="margin: 5px 0; color: #64748b; font-size: 0.9rem; text-transform: uppercase;">Vente de matériels informatiques</p>
                    <p style="margin: 0; color: #10b981; font-weight: bold;">Réf. Facture : @InvoiceToPrint.Id?.Substring(0, 8).ToUpper()</p>
                </div>
            </div>

            <div style="text-align: right;">
                <h3 style="margin: 0; font-weight: 900; font-size: 1.2rem;">@(CompanyInfos?.Country ?? "BURKINA FASO")</h3>
                <p style="margin: 5px 0; color: #10b981; font-style: italic; font-size: 0.9rem;">@(CompanyInfos?.Slogan ?? "La Patrie ou la Mort, nous vaincrons")</p>
                <p style="margin: 5px 0; font-size: 0.85rem;"><b>N° IFU :</b> @(CompanyInfos?.Ifu ?? "0000000000X")</p>
                <p style="margin: 5px 0; font-size: 0.85rem;"><b>Adresse :</b> @(CompanyInfos?.Address ?? "Ouagadougou, Kadiogo")</p>
                <p style="margin: 5px 0; font-size: 0.85rem;"><b>Tél :</b> @(CompanyInfos?.Phone ?? "+226 70 00 00 00")</p>
            </div>
        </div>

        <div class="facture-title-box">
            <h1 class="facture-title">FACTURE VENTE AU COMPTOIRE</h1>
        </div>

        <div class="facture-cards">
            <div class="facture-card">
                <h4>Détails du document</h4>
                <p style="margin: 5px 0;"><b>Date d'émission :</b> @FormatDate(InvoiceToPrint.CreatedAt)</p>
                <p style="margin: 5px 0; display: flex; align-items: center; gap: 8px;">
                    <b>Moyen de paiement :</b> 
                    <span style="background: #ecfdf5; color: #10b981; padding: 2px 8px; border-radius: 4px; font-weight: 600; font-size: 0.85rem; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important;">@FormatPaymentMethod(InvoiceToPrint.PaymentMethod)</span>
                </p>
            </div>
            <div class="facture-card">
                <h4>Facturé à</h4>
                <p style="margin: 5px 0; font-size: 1.1rem;"><b>@InvoiceToPrint.ClientName</b></p>
                @if (!string.IsNullOrEmpty(InvoiceToPrint.RecipientPhone)) { <p style="margin: 5px 0;"><b>Tél :</b> @InvoiceToPrint.RecipientPhone</p> }
                @if (!string.IsNullOrEmpty(InvoiceToPrint.RecipientAddress)) { <p style="margin: 5px 0;"><b>Adresse :</b> @InvoiceToPrint.RecipientAddress</p> }
            </div>
        </div>

        <table class="facture-table">
            <thead>
                <tr>
                    <th style="width: 5%;">N°</th>
                    <th style="width: 45%;">Désignation</th>
                    <th style="width: 10%; text-align: center;">Qté</th>
                    <th style="width: 20%; text-align: right;">PU</th>
                    <th style="width: 20%; text-align: right;">PT</th>
                </tr>
            </thead>
            <tbody>
                @if (InvoiceToPrint.Items != null)
                {
                    int index = 1;
                    foreach (var item in InvoiceToPrint.Items)
                    {
                        <tr>
                            <td style="color: #64748b;">@index</td>
                            <td>@item.ProductName</td>
                            <td style="text-align: center;">@item.Quantity</td>
                            <td style="text-align: right;">@FormatMoney(item.UnitPrice)</td>
                            <td style="text-align: right; font-weight: bold; color: #0f172a;">@FormatMoney(item.Quantity * item.UnitPrice)</td>
                        </tr>
                        index++;
                    }
                }
            </tbody>
        </table>

        <div class="facture-totals-wrapper">
            <table class="facture-totals-table">
                @if (InvoiceToPrint.Total > InvoiceToPrint.Avance) // Seulement si réduction
                {
                    <tr>
                        <td style="text-align: right; font-weight: 600; text-transform: uppercase; color: #64748b;">Sous-Total :</td>
                        <td style="text-align: right; font-weight: bold; font-size: 1.05rem;">@FormatMoney(InvoiceToPrint.Total)</td>
                    </tr>
                    <tr>
                        <td style="text-align: right; font-weight: 600; text-transform: uppercase; color: #ef4444;">Réduction :</td>
                        <td style="text-align: right; font-weight: bold; color: #ef4444;">- @FormatMoney(InvoiceToPrint.Total - InvoiceToPrint.Avance)</td>
                    </tr>
                }
                <tr class="total-row">
                    <td style="text-align: right;">TOTAL PAYÉ :</td>
                    <td style="text-align: right;">@FormatMoney(InvoiceToPrint.Avance)</td>
                </tr>
            </table>
        </div>

        <div class="amount-in-words">
            Arrêtée la présente facture à la somme de :<br>
            <b style="color: #0f172a;">@ConvertAmountToWords(InvoiceToPrint.Avance).ToUpper() FRANCS CFA.</b>
        </div>

        <div class="signatures">
            <div>
                <span style="font-size: 0.85rem; font-weight: 600; color: #64748b; letter-spacing: 1px;">LE CLIENT</span>
                <div class="sig-line"></div>
                <b>@InvoiceToPrint.ClientName</b>
            </div>
            <div>
                <span style="font-size: 0.85rem; font-weight: 600; color: #64748b; letter-spacing: 1px;">LE VENDEUR</span>
                <div class="sig-line"></div>
                <b>@CurrentUserName</b>
            </div>
        </div>

        <div class="custom-print-footer">
            BothTech burkina la référence du numérique
        </div>
    </div>
}


<!-- =========================================
     INTERFACE UTILISATEUR (ÉCRAN)
     ========================================= -->
<div class="no-print" style="background: transparent; padding: 20px; margin: 0; overflow-x: hidden; padding-bottom: calc(85px + env(safe-area-inset-bottom, 20px)); font-family: 'Plus Jakarta Sans', sans-serif;">

    <!-- MENU DES ONGLETS DE VENTE -->
    <div style="display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 2px solid var(--border); padding-bottom: 10px; flex-wrap: wrap;">
        <NavLink class="ventes-tab-btn" href="/vente/commandes" style="text-decoration:none;">📋 Commandes en ligne</NavLink>
        <NavLink class="ventes-tab-btn" href="/vente/ventecomptoir" Match="NavLinkMatch.All" style="text-decoration:none;">🛒 Vente Comptoir</NavLink>
        <NavLink class="ventes-tab-btn" href="/vente/venteb2b" style="text-decoration:none;">🏢 Ventes B2B (Gros)</NavLink>
    </div>

    @if (!IsFormView)
    {
        <!-- VUE 1 : HISTORIQUE DES VENTES COMPTOIR -->
        <div style="padding: 0 10px 20px 10px;">
            <section class="card">
                <div class="card-header">
                    <div style="display: flex; align-items: center; gap: 15px; width: 100%;">
                        @if (canAddComptoir)
                        {
                            <button class="btn btn-primary" style="background: var(--success); color: white; border: none; font-weight: bold; cursor: pointer; padding: 14px 15px; flex: 1;" @onclick="OpenNewSale">
                                + Nouvelle Vente
                            </button>
                        }
                        <h2 class="card-title hide-mobile" style="margin:0;">Historique Comptoir</h2>
                    </div>
                    <div class="search-filters">
                        <input type="search" placeholder="Rechercher..." class="form-control" @bind="SearchQuery" @bind:event="oninput">
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th class="hide-mobile">Date / Réf</th>
                                <th>Client / Date</th>
                                <th class="hide-mobile">Montant</th>
                                <th style="text-align:right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (IsLoading)
                            {
                                <tr><td colspan="4" style="text-align:center; padding:20px;">Chargement...</td></tr>
                            }
                            else if (!FilteredHistory.Any())
                            {
                                <tr><td colspan="4" style="text-align:center; padding:20px; color:var(--text-muted);">Aucune vente locale trouvée.</td></tr>
                            }
                            else
                            {
                                @foreach (var order in FilteredHistory)
                                {
                                    <tr>
                                        <td class="hide-mobile">
                                            <small style="color:var(--text-muted);">@FormatDate(order.CreatedAt)</small><br>
                                            <b style="color:var(--primary);">#@order.Id?.Substring(0, 6).ToUpper()</b>
                                        </td>
                                        <td>
                                            <b>@order.ClientName</b><br>

                                            <!-- Affichage Mobile -->
                                            <div class="mobile-only-display" style="margin-top:5px; font-size:0.8rem; border-top:1px dashed var(--border); padding-top:5px;">
                                                <span style="color:var(--text-muted);">@FormatDate(order.CreatedAt)</span> - <b style="color:var(--primary);">#@order.Id?.Substring(0, 6).ToUpper()</b><br>
                                                <b style="color: var(--text-main);">@FormatMoney(order.Avance)</b>
                                            </div>
                                        </td>
                                        <td class="hide-mobile">
                                            <b>@FormatMoney(order.Avance)</b><br>
                                            <small style="color:var(--text-muted);">@FormatPaymentMethod(order.PaymentMethod)</small>
                                        </td>
                                        <td style="text-align:right;">
                                            <button class="btn btn-outline btn-action" @onclick="() => PrintInvoice(order)" title="Imprimer Facture">🖨️ Facture</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }
    else
    {
        <!-- VUE 2 : CAISSE (POINT DE VENTE) -->
        <div style="padding: 0 10px 20px 10px;">
            <section class="card caisse-card">
                <div class="card-header">
                    <h2 class="card-title" style="margin:0; font-size: 1.1rem;">🛒 Caisse Directe</h2>
                    <button type="button" class="btn btn-outline" style="cursor: pointer;" @onclick="CloseNewSale">🔙 Retour</button>
                </div>

                <div class="card-body caisse-body">
                    <div style="background:#f8fafc; padding:15px; border-radius:8px; border:1px solid var(--border); margin-bottom:20px;">
                        <h3 style="font-size:0.95rem; margin-bottom:12px; color:var(--primary);">Coordonnées du Client</h3>
                        <div class="client-info-grid" style="display: flex; flex-wrap: wrap; gap: 10px;">
                            <input type="text" class="form-control" placeholder="Nom du Client *" @bind="SaleClientName" style="flex: 1; min-width: 150px;">
                            <input type="tel" class="form-control" placeholder="Téléphone" @bind="SaleClientPhone" style="flex: 1; min-width: 150px;">
                        </div>
                        <input type="text" class="form-control" placeholder="Adresse / Quartier" @bind="SaleClientAddress" style="margin-top: 10px; width: 100%;">
                    </div>

                    <!-- LIGNES DE COMMANDE -->
                    <div>
                        @foreach (var line in PosLines)
                        {
                            <div class="pos-line-item" style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:10px; background:#fff; padding:15px; border:1px solid var(--border); border-radius:8px;">
                                <div style="flex:2; min-width:100%;">
                                    <label style="font-size:0.8rem; font-weight:bold; display:block; margin-bottom:5px;">Article</label>
                                    <select class="form-control" value="@line.ProductFirebaseId" @onchange="@(e => OnProductSelected(line, e.Value?.ToString() ?? ""))" style="width: 100%;">
                                        <option value="">-- Choisir --</option>
                                        @foreach (var p in _catalog)
                                        {
                                            <option value="@p.Id">@p.Name - @FormatMoney(p.Price) (Stock: @p.Quantity)</option>
                                        }
                                    </select>
                                </div>
                                <div class="pos-line-inputs" style="display:flex; gap:10px; flex:1; min-width:100%;">
                                    <div style="flex:1;">
                                        <label style="font-size:0.8rem; font-weight:bold; display:block; margin-bottom:5px;">Qté</label>
                                        <input type="number" class="form-control" value="@line.Quantity" min="1" max="@line.MaxStock" @onchange="@(e => OnQuantityChanged(line, e.Value))" style="text-align:center; width: 100%;">
                                    </div>
                                    <div style="flex:2;">
                                        <label style="font-size:0.8rem; font-weight:bold; display:block; margin-bottom:5px;">Total Ligne</label>
                                        <input type="text" class="form-control" value="@FormatMoney(line.LineTotal)" disabled style="font-weight:bold; background:#f1f5f9; width: 100%;">
                                    </div>
                                </div>
                                <button class="btn btn-outline" @onclick="() => PosLines.Remove(line)" style="color:var(--danger); border-color:var(--danger-subtle); font-weight:bold; width: 100%;">Supprimer</button>
                            </div>
                        }
                    </div>

                    <button class="btn btn-outline" @onclick="AddLine" style="width:100%; margin-top:10px; border-style:dashed; cursor: pointer; padding: 14px; font-weight: 600; color:var(--primary); border-color:var(--primary-subtle);">+ Ajouter un article</button>

                    <div class="receipt-block" style="margin-top:25px; padding: 15px; border-radius: 8px; border: 1px solid var(--border);">
                        <div class="receipt-row" style="font-size:1.05rem; display:flex; justify-content:space-between;">
                            <span>Sous-total:</span>
                            <span style="font-weight: bold;">@FormatMoney(SubTotal)</span>
                        </div>

                        <div style="display:flex; flex-direction: column; gap: 8px; margin:15px 0; background: #fff; padding: 15px; border-radius: 6px; border: 1px dashed var(--border);">
                            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
                                <span style="font-size:0.95rem; color:var(--danger); font-weight: 600;">Réduction accordée:</span>
                                <input type="number" class="form-control" style="width:140px; text-align:right;" placeholder="0" min="0" value="@Discount" @onchange="OnDiscountChanged">
                            </div>
                            <div style="text-align:right;">
                                <small style="font-size:0.75rem; color:var(--purple); font-weight: 500;">Plafond max autorisé: <span>@FormatMoney(MaxDiscountAllowed)</span></small>
                            </div>
                        </div>

                        <div class="receipt-total" style="font-size: 1.2rem; border-top: 2px solid var(--border); padding-top: 15px; display:flex; justify-content:space-between;">
                            <span>TOTAL À PAYER:</span>
                            <span style="font-weight:bold; color:var(--primary);">@FormatMoney(FinalTotal)</span>
                        </div>
                    </div>

                    <div class="form-group" style="margin-top:20px; margin-bottom: 10px;">
                        <label style="font-weight: bold; display:block; margin-bottom: 8px;">Mode d'encaissement *</label>
                        <select class="form-control" @bind="SalePaymentMethod" style="width: 100%;">
                            <option value="espece">Espèce (Cash)</option>
                            <option value="mobile_money">Mobile Money</option>
                            <option value="virement">Virement Bancaire</option>
                        </select>
                    </div>
                </div>

                <div class="caisse-footer">
                    <button class="btn btn-success" disabled="@IsProcessing" @onclick="SubmitSale" style="width:100%; background:var(--success); color:white; border:none; padding:16px; font-size:1.15rem; font-weight:bold; cursor: pointer; border-radius: 8px;">
                        @(IsProcessing ? "Encaissement..." : "✅ Encaisser Vente")
                    </button>
                </div>
            </section>
        </div>
    }

    @if (!string.IsNullOrEmpty(ToastMessage))
    {
        <div id="toast" style="display:block; position: fixed; bottom: 20px; right: 20px; background: #333; color: white; padding: 10px 20px; border-radius: 5px; z-index: 9999; box-shadow: 0 4px 6px rgba(0,0,0,0.3);">@ToastMessage</div>
    }
</div>

@code {
    private bool IsLoading = true;
    private bool IsFormView = false;
    private bool IsProcessing = false;
    private string ToastMessage = "";
    private string SearchQuery = "";

    // Variables pour l'impression
    private OrderModel? InvoiceToPrint = null;
    private string CurrentUserName = "Agent BothTech";
    private CompanySettings? CompanyInfos = new CompanySettings();

    // Auth & Sync
    private string idToken = "";
    private string CurrentUserId = "";
    private string userRole = "client";

    private bool isAdminOrMaintenance = false;
    private bool canAddComptoir = false;
    private Dictionary<string, Dictionary<string, bool>> currentPermissions = new();

    // Données chargées localement
    private List<Product> _catalog = new();
    private List<OrderModel> _historyOrders = new();

    // État du formulaire de Caisse
    private string SaleClientName = "Client de passage";
    private string SaleClientPhone = "";
    private string SaleClientAddress = "";
    private string SalePaymentMethod = "espece";
    private int Discount = 0;

    private List<PosLineItem> PosLines = new();

    public class PosLineItem
    {
        public string ProductFirebaseId { get; set; } = "";
        public string ProductName { get; set; } = "";
        public int Quantity { get; set; } = 1;
        public int UnitPrice { get; set; }
        public int MaxDiscountUnit { get; set; }
        public int MaxStock { get; set; }
        public int LineTotal => Quantity * UnitPrice;
    }

    private int SubTotal => PosLines.Sum(l => l.LineTotal);
    private int MaxDiscountAllowed => PosLines.Sum(l => l.Quantity * l.MaxDiscountUnit);
    private int FinalTotal => Math.Max(0, SubTotal - Discount);

    private IEnumerable<OrderModel> FilteredHistory => _historyOrders
        .Where(o => string.IsNullOrWhiteSpace(SearchQuery) ||
                    (!string.IsNullOrEmpty(o.ClientName) && o.ClientName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(o.Id) && o.Id.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(o => o.CreatedAt);

    // ===================================================================
    // INITIALISATION OFFLINE SÉCURISÉE
    // ===================================================================
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                idToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_idtoken") ?? "";
                CurrentUserId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userid") ?? "";
                userRole = (await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userrole") ?? "client").ToLower().Trim();

                isAdminOrMaintenance = (userRole == "admin" || userRole == "maintenance");

                if (!isAdminOrMaintenance && userRole != "client")
                {
                    LoadUserPermissionsLocal(userRole);
                }

                bool canReadComptoir = HasPerm("comptoir", "lecture");
                canAddComptoir = HasPerm("comptoir", "ajouter");

                if (userRole == "client" || (!isAdminOrMaintenance && !canReadComptoir))
                {
                    NavManager.NavigateTo("/", true);
                    return;
                }

                LoadLocalData();

                // Extraction du Vrai Nom de l'agent
                try
                {
                    var staffs = DataSync.GetAllLocal<StaffModel>() ?? new List<StaffModel>();
                    var currentUser = staffs.FirstOrDefault(s => s.Id == CurrentUserId);
                    if (currentUser != null && !string.IsNullOrWhiteSpace(currentUser.Name))
                    {
                        CurrentUserName = currentUser.Name;
                    }
                    else
                    {
                        CurrentUserName = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_useremail") ?? "Agent BothTech";
                    }
                }
                catch { CurrentUserName = "Agent BothTech"; }

                StateHasChanged();

                if (!string.IsNullOrEmpty(idToken))
                {
                    _ = Task.Run(async () =>
                    {
                        try { await DataSync.PushPendingOperationsAsync(idToken); }
                        catch (Exception syncEx) { Console.WriteLine($"[Synchro ignorée] {syncEx.Message}"); }
                    });
                }
            }
            catch (Microsoft.AspNetCore.Components.NavigationException)
            {
                throw;
            }
            catch (Exception ex)
            {
                Console.WriteLine("Erreur Init Vente Comptoir : " + ex.Message);
                await ShowToast("Erreur système : " + ex.Message);
            }
            finally
            {
                IsLoading = false;
                StateHasChanged();
            }
        }
    }

    private void LoadUserPermissionsLocal(string role)
    {
        try
        {
            var localRoles = DataSync.GetAllLocal<RoleConfig>();
            string cleanRole = (role ?? "").ToLower().Trim();
            var myRoleConfig = localRoles.FirstOrDefault(r => r.Id != null && r.Id.ToLower().Trim() == cleanRole);

            if (myRoleConfig != null && !string.IsNullOrEmpty(myRoleConfig.PermissionsJson))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var parsed = JsonSerializer.Deserialize<Dictionary<string, Dictionary<string, bool>>>(myRoleConfig.PermissionsJson, options);

                if (parsed != null && parsed.Count > 0)
                {
                    currentPermissions = new Dictionary<string, Dictionary<string, bool>>(StringComparer.OrdinalIgnoreCase);
                    foreach (var module in parsed)
                    {
                        var actionDict = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);
                        foreach (var action in module.Value)
                        {
                            actionDict[action.Key] = action.Value;
                        }
                        currentPermissions[module.Key] = actionDict;
                    }
                }
                else currentPermissions = new();
            }
            else currentPermissions = new();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erreur lecture permissions comptoir : " + ex.Message);
            currentPermissions = new();
        }
    }

    private bool HasPerm(string module, string action)
    {
        if (isAdminOrMaintenance) return true;

        if (currentPermissions == null || currentPermissions.Count == 0)
        {
            string safeModule = module.ToLower();
            if ((userRole == "commercial" || userRole == "secretaire") && safeModule == "comptoir") return true;
            return false;
        }

        if (currentPermissions.TryGetValue(module, out var actions) && actions.TryGetValue(action, out var allowed))
        {
            return allowed;
        }

        return false;
    }

    private void LoadLocalData()
    {
        try { _catalog = DataSync.GetAllLocal<Product>() ?? new List<Product>(); }
        catch { _catalog = new List<Product>(); }

        try { _historyOrders = (DataSync.GetAllLocal<OrderModel>() ?? new List<OrderModel>()).Where(o => o.Type == "comptoir").ToList(); }
        catch { _historyOrders = new List<OrderModel>(); }

        try { CompanyInfos = DataSync.GetAllLocal<CompanySettings>().FirstOrDefault() ?? new CompanySettings(); }
        catch { CompanyInfos = new CompanySettings(); }
    }

    // ===================================================================
    // GESTION DU FORMULAIRE CAISSE
    // ===================================================================
    private void OpenNewSale()
    {
        if (!canAddComptoir)
        {
            _ = ShowToast("❌ Vous n'avez pas l'autorisation d'ajouter une vente.");
            return;
        }

        SaleClientName = "Client de passage";
        SaleClientPhone = "";
        SaleClientAddress = "";
        SalePaymentMethod = "espece";
        Discount = 0;
        PosLines.Clear();
        AddLine();
        IsFormView = true;
    }

    private void CloseNewSale()
    {
        IsFormView = false;
    }

    private void AddLine()
    {
        PosLines.Add(new PosLineItem());
    }

    private void OnProductSelected(PosLineItem line, string productId)
    {
        line.ProductFirebaseId = productId;
        var p = _catalog.FirstOrDefault(x => x.Id == productId);
        if (p != null)
        {
            line.ProductName = p.Name ?? "Produit inconnu";
            line.UnitPrice = p.Price;
            line.MaxDiscountUnit = p.MaxDiscount ?? 0;
            line.MaxStock = p.Quantity;
            if (line.Quantity > line.MaxStock) line.Quantity = line.MaxStock;
        }
        else
        {
            line.UnitPrice = 0;
            line.MaxDiscountUnit = 0;
            line.MaxStock = 0;
        }
        ValidateDiscount();
    }

    private void OnQuantityChanged(PosLineItem line, object? value)
    {
        if (int.TryParse(value?.ToString(), out int qty))
        {
            line.Quantity = qty > line.MaxStock ? line.MaxStock : (qty < 1 ? 1 : qty);
            ValidateDiscount();
        }
    }

    private void OnDiscountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int parsed))
        {
            Discount = parsed;
            ValidateDiscount();
        }
    }

    private void ValidateDiscount()
    {
        if (Discount > MaxDiscountAllowed)
        {
            Discount = MaxDiscountAllowed;
        }
    }

    // ===================================================================
    // VALIDATION DE LA VENTE ( AVEC STOCK MOVEMENTS & OUTBOX )
    // ===================================================================
    private async Task SubmitSale()
    {
        if (!canAddComptoir)
        {
            await ShowToast("❌ Vous n'avez pas l'autorisation d'ajouter une vente.");
            return;
        }

        var validLines = PosLines.Where(l => !string.IsNullOrEmpty(l.ProductFirebaseId) && l.Quantity > 0).ToList();
        if (!validLines.Any())
        {
            await ShowToast("⚠️ Veuillez sélectionner au moins un article.");
            return;
        }

        IsProcessing = true;
        StateHasChanged();

        try
        {
            string orderId = "COMPT-" + DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

            var order = new OrderModel
            {
                Id = orderId,
                Type = "comptoir",
                ClientName = SaleClientName,
                RecipientPhone = SaleClientPhone,
                RecipientAddress = SaleClientAddress,
                Total = SubTotal,
                Avance = FinalTotal, // Au comptoir, l'avance payée c'est le total après réduction
                Reste = 0,
                PaymentMethod = SalePaymentMethod,
                CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
                Status = "payee",
                Items = validLines.Select(l => new OrderItem
                {
                    ProductFirebaseId = l.ProductFirebaseId,
                    ProductName = l.ProductName,
                    UnitPrice = l.UnitPrice,
                    Quantity = l.Quantity
                }).ToList()
            };

            DataSync.SaveLocal(order);
            DataSync.EnqueueOperation("OrderModel", orderId, "CREATE", order);
            _historyOrders.Insert(0, order);

            foreach (var line in validLines)
            {
                var movement = new StockMovement
                {
                    MovementId = Guid.NewGuid().ToString("N"),
                    ProductId = line.ProductFirebaseId,
                    QuantityChange = -line.Quantity,
                    MovementType = "SALE",
                    OrderId = orderId,
                    AgentId = CurrentUserId,
                    Date = DateTime.UtcNow
                };

                DataSync.SaveLocal(movement);
                DataSync.EnqueueOperation("StockMovement", movement.MovementId, "CREATE", movement);

                var localProduct = _catalog.FirstOrDefault(x => x.Id == line.ProductFirebaseId);
                if (localProduct != null)
                {
                    localProduct.Quantity -= line.Quantity;
                    DataSync.SaveLocal(localProduct);
                }
            }

            _ = DataSync.PushPendingOperationsAsync(idToken);

            await ShowToast("✅ Vente Comptoir enregistrée et stock déduit !");
            
            // Impression automatique après validation (Optionnel)
            await PrintInvoice(order);
            
            IsFormView = false;
        }
        catch (Exception ex)
        {
            await ShowToast("❌ Erreur de sauvegarde : " + ex.Message);
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task PrintInvoice(OrderModel order)
    {
        InvoiceToPrint = order;
        StateHasChanged(); 
        await Task.Delay(300); // Laisse au navigateur le temps d'appliquer les CSS
        await JSRuntime.InvokeVoidAsync("window.print");
    }

