@page "/admin/chat"
@layout bothtech.Shared.Layout.AdminLayout
@using bothtech.Shared.Models

<PageTitle>Messagerie | Console Admin</PageTitle>

<div id="chatsDashboard">
    <div class="chat-layout @(SelectedChatUid != null ? "chat-active" : "")">

        <!-- COLONNE 1 : LISTE DES CHATS -->
        <div class="chat-sidebar">
            <div class="chat-list-header" style="display: flex; align-items: center; justify-content: space-between; padding: 15px; border-bottom: 1px solid var(--border); background: #f8fafc;">
                <span style="font-weight: 800; font-size: 1.1rem; color: var(--text-main);">Discussions</span>
            </div>

            <div class="chat-list">
                @if (IsLoading)
                {
                    <div style="padding: 15px; text-align: center; color: var(--text-muted);">Chargement...</div>
                }
                else
                {
                    @foreach (var conversation in Conversations)
                    {
                        <div class="chat-item @(SelectedChatUid == conversation.Key ? "active" : "")"
                             @onclick="() => SelectChat(conversation.Key)">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 6px;">
                                <span class="chat-item-name">@conversation.Value.ClientName</span>
                            </div>
                            <div class="chat-item-preview">@conversation.Value.LastMessagePreview</div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- COLONNE 2 : CHAT ACTIF -->
        <div class="chat-main">
            @if (SelectedChatUid == null)
            {
                <div class="chat-header-info" style="background:#fff; height: 100%; display: flex; align-items: center; justify-content: center;">
                    <div style="color: var(--text-muted);">
                        Sélectionnez une discussion à gauche pour commencer
                    </div>
                </div>
            }
            else
            {
                <div class="chat-header-info" style="background:#fff; flex-shrink: 0;">
                    <div style="display:flex; align-items:center; padding: 15px; border-bottom: 1px solid var(--border);">
                        <!-- Bouton retour visible uniquement sur mobile -->
                        <button class="mobile-back-btn" @onclick="CloseChat" style="background: none; border: none; font-size: 1.2rem; margin-right: 10px; cursor: pointer;">🔙</button>
                        <div style="display:flex; flex-direction:column; flex:1;">
                            <span style="font-weight:800; font-size:1.1rem;">
                                👤 @ActiveConversation.ClientName
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Zone de messages défilante -->
                <div class="chat-messages" style="display:flex; flex-direction:column; flex: 1; overflow-y: auto; padding: 15px;">
                    @foreach (var msg in ActiveConversation.Messages)
                    {
                        <div class="msg-bubble @(msg.Sender == "admin" ? "admin" : "client")">
                            <div style="font-size:0.75rem; font-weight:bold; margin-bottom:4px; opacity:0.8;">
                                @(msg.Sender == "admin" ? "Agent" : "Client")
                            </div>
                            @msg.Text
                            <span class="msg-time">@FormatTime(msg.Timestamp)</span>
                        </div>
                    }
                </div>

                <!-- Zone de saisie -->
                <form class="chat-input-container" style="display:flex; padding: 10px; background: #fff; border-top: 1px solid var(--border);" @onsubmit="SendMessage">
                    <input type="text" id="adminChatInput" placeholder="Répondre..." @bind="NewMessageText" autocomplete="off" style="flex: 1; border: 1px solid var(--border); border-radius: 20px; padding: 10px 15px; outline: none; margin-right: 10px;">
                    <button type="submit" class="btn-send" disabled="@string.IsNullOrWhiteSpace(NewMessageText)" style="background: var(--primary); color: white; border: none; border-radius: 50%; width: 40px; height: 40px; cursor: pointer;">
                        ➤
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@code {
    private bool IsLoading = true;
    private string SelectedChatUid;
    private string NewMessageText = "";

    // Modèle spécifique à l'UI pour regrouper les messages par client
    public class ChatUiModel
    {
        public string ClientName { get; set; }
        public string LastMessagePreview => Messages.LastOrDefault()?.Text ?? "Fichier/Audio joint";
        public List<ChatMessage> Messages { get; set; } = new();
    }

    private Dictionary<string, ChatUiModel> Conversations = new();

    // Récupère dynamiquement la conversation active
    private ChatUiModel ActiveConversation => SelectedChatUid != null && Conversations.ContainsKey(SelectedChatUid) ? Conversations[SelectedChatUid] : null;

    protected override async Task OnInitializedAsync()
    {
        // Simulation d'un chargement Firebase
        await Task.Delay(500);

        Conversations = new Dictionary<string, ChatUiModel>
        {
            { "uid_client_1", new ChatUiModel {
                ClientName = "Abdoulaye",
                Messages = new List<ChatMessage> {
                    new ChatMessage { Sender = "client", Text = "Bonjour, le PC est dispo ?", Timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() }
                }
            }},
            { "uid_client_2", new ChatUiModel {
                ClientName = "Lucien",
                Messages = new List<ChatMessage> {
                    new ChatMessage { Sender = "admin", Text = "Oui, il est disponible.", Timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() }
                }
            }}
        };

        IsLoading = false;
    }

    private void SelectChat(string uid)
    {
        SelectedChatUid = uid;
    }

    private void CloseChat()
    {
        SelectedChatUid = null;
    }

    private void SendMessage()
    {
        if (string.IsNullOrWhiteSpace(NewMessageText) || ActiveConversation == null) return;

        // On ajoute le message à la liste (Plus tard, on l'enverra à FirebaseService)
        ActiveConversation.Messages.Add(new ChatMessage
        {
            Sender = "admin",
            Text = NewMessageText,
            Timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()
        });

        NewMessageText = ""; // Vide le champ de texte
    }

    private string FormatTime(long timestamp)
    {
        return DateTimeOffset.FromUnixTimeMilliseconds(timestamp).LocalDateTime.ToString("HH:mm");
    }
}
