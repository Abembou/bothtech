@page "/settings"
@layout bothtech.Shared.Layout.AdminLayout
@using bothtech.Shared.Models

<PageTitle>Paramètres de l'Entreprise | Console Admin</PageTitle>

<div style="background: var(--danger-subtle); color: var(--danger); border: 1px solid var(--danger); padding: 15px; border-radius: 8px; margin-bottom: 20px;">
    <strong>⚙️ Configuration Système (@SettingsModel.Name)</strong><br>
    Les informations saisies ici modifieront l'identité visuelle et les coordonnées de l'entreprise sur toutes les pages, factures et contrats de l'application.
</div>

<section class="card" style="max-width: 900px; margin: 0 auto;">
    <div class="card-header">
        <h2 class="card-title">Identité de l'Entreprise</h2>
    </div>
    <div class="card-body">

        <!-- Le OnValidSubmit remplace votre addEventListener("submit") -->
        <EditForm Model="@SettingsModel" OnValidSubmit="SaveSettingsAsync">
            <DataAnnotationsValidator />

            <h3 style="font-size:0.9rem; color:var(--primary); margin-bottom:15px; border-bottom:1px solid var(--border); padding-bottom:5px;">1. Informations Générales</h3>

            <div class="form-grid-2">
                <div class="form-group">
                    <label>Nom de l'entreprise *</label>
                    <InputText @bind-Value="SettingsModel.Name" class="form-control" placeholder="Ex: BOTH TECH BURKINA" required />
                </div>
                <div class="form-group">
                    <label>Slogan / Activité *</label>
                    <InputText @bind-Value="SettingsModel.Slogan" class="form-control" placeholder="Ex: Vente de matériels informatiques" required />
                </div>
            </div>

            <div class="form-grid-3">
                <div class="form-group">
                    <label>N° IFU / RCCM *</label>
                    <InputText @bind-Value="SettingsModel.Ifu" class="form-control" placeholder="Ex: 0000000000X" required />
                </div>
                <div class="form-group">
                    <label>Devise Principale *</label>
                    <InputText @bind-Value="SettingsModel.Currency" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Téléphone principal *</label>
                    <InputText @bind-Value="SettingsModel.Phone" class="form-control" placeholder="Ex: +226 70 00 00 00" required />
                </div>
            </div>

            <div class="form-grid-2">
                <div class="form-group">
                    <label>Adresse physique *</label>
                    <InputText @bind-Value="SettingsModel.Address" class="form-control" placeholder="Ex: Ouagadougou, Kadiogo" required />
                </div>
                <div class="form-group">
                    <label>Pays *</label>
                    <InputText @bind-Value="SettingsModel.Country" class="form-control" placeholder="Ex: Burkina Faso" required />
                </div>
            </div>

            <div class="form-group">
                <label>Texte de pied de page (Factures) *</label>
                <InputText @bind-Value="SettingsModel.FooterText" class="form-control" placeholder="Ex: La Patrie ou la Mort, nous vaincrons" required />
            </div>

            <button type="submit" disabled="@IsSaving" class="btn btn-primary" style="width:100%; padding: 14px; font-size:1.1rem; margin-top:20px; font-weight:bold; cursor:pointer;">
                @(IsSaving ? "Sauvegarde en cours..." : "💾 Sauvegarder les Paramètres")
            </button>
        </EditForm>
    </div>
</section>

@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div id="toast" style="display:block;">@ToastMessage</div>
}

@code {
    private CompanySettings SettingsModel = new CompanySettings();
    private bool IsSaving = false;
    private string ToastMessage = "";

    protected override async Task OnInitializedAsync()
    {
        // Plus tard, nous chargerons les paramètres depuis Firebase ou MySQL ici.
        // Pour l'instant, on initialise avec des données par défaut.
        SettingsModel = new CompanySettings
        {
            Name = "Both Tech Burkina",
            Currency = "FCFA"
        };
    }

    private async Task SaveSettingsAsync()
    {
        IsSaving = true;

        // Plus tard, on appellera DbService.UpdateSettingsAsync(SettingsModel)
        await Task.Delay(1000); // Simulation d'une sauvegarde réseau

        IsSaving = false;
        await ShowToast("✅ Paramètres enregistrés avec succès !");
    }

    private async Task ShowToast(string message)
    {
        ToastMessage = message;
        StateHasChanged();
        await Task.Delay(3000);
        ToastMessage = "";
        StateHasChanged();
    }
}