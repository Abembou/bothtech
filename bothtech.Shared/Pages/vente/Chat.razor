    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                idToken = await JSRuntime.InvokeAsync<string>("eval", @"
                    (async () => {
                        const getToken = async () => {
                            try {
                                if (window.auth && window.auth.currentUser) return await window.auth.currentUser.getIdToken(true);
                                return await new Promise(resolve => {
                                    if (!window.auth) return resolve('');
                                    const unsubscribe = window.auth.onAuthStateChanged(async u => {
                                        unsubscribe();
                                        try { resolve(u ? await u.getIdToken(true) : ''); } catch(e) { resolve(''); }
                                    });
                                    setTimeout(() => { unsubscribe(); resolve(''); }, 2000);
                                });
                            } catch(err) { return ''; }
                        };
                        let token = await getToken();
                        if (token) { localStorage.setItem('bothtech_idtoken', token); return token; }
                        return localStorage.getItem('bothtech_idtoken') || '';
                    })()
                ");

                currentAdminUid = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userid") ?? "";
                currentAdminName = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_useremail") ?? "Agent";
                userRole = (await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userrole") ?? "client").ToLower().Trim();

                isAdminOrMaintenance = (userRole == "admin" || userRole == "maintenance");

                if (userRole != "admin" && userRole != "maintenance" && userRole != "client")
                {
                    LoadUserPermissionsLocal(userRole);
                }

                canReadMessages = HasPerm("messages", "lecture");
                canModifyMessages = HasPerm("messages", "modifier");

                if (userRole == "client" || (!isAdminOrMaintenance && !canReadMessages))
                {
                    NavManager.NavigateTo("/", true);
                    return;
                }

                LoadLocalData();

                if (!string.IsNullOrEmpty(idToken))
                {
                    await FetchChatsAsync();
                    _ = DataSync.PushPendingOperationsAsync(idToken);
                    _ = StartRealtimeListener();
                }

                var uri = new Uri(NavManager.Uri);
                var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
                string? uidFromUrl = query["uid"];
                if (!string.IsNullOrEmpty(uidFromUrl) && localChats.ContainsKey(uidFromUrl))
                {
                    string name = localUsers.ContainsKey(uidFromUrl) ? (localUsers[uidFromUrl].Name ?? "Client") : "Client";
                    SelectClient(uidFromUrl, name);
                }

                isLoadingData = false;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erreur initialisation Chat : {ex.Message}");
                NavManager.NavigateTo("/", true);
            }
        }
    }

    private void LoadUserPermissionsLocal(string role)
    {
        try
        {
            var localRoles = DataSync.GetAllLocal<RoleConfig>();
            string cleanRole = (role ?? "").ToLower().Trim();
            var myRoleConfig = localRoles.FirstOrDefault(r => r.Id != null && r.Id.ToLower().Trim() == cleanRole);

            if (myRoleConfig != null && !string.IsNullOrEmpty(myRoleConfig.PermissionsJson))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var parsed = JsonSerializer.Deserialize<Dictionary<string, Dictionary<string, bool>>>(myRoleConfig.PermissionsJson, options);

                if (parsed != null && parsed.Count > 0)
                {
                    currentPermissions = new Dictionary<string, Dictionary<string, bool>>(StringComparer.OrdinalIgnoreCase);
                    foreach (var module in parsed)
                    {
                        var actionDict = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);
                        foreach (var action in module.Value)
                        {
                            actionDict[action.Key] = action.Value;
                        }
                        currentPermissions[module.Key] = actionDict;
                    }
                }
                else currentPermissions = new();
            }
            else currentPermissions = new();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erreur lecture permissions chat : " + ex.Message);
            currentPermissions = new();
        }
    }

    private bool HasPerm(string module, string action)
    {
        if (isAdminOrMaintenance) return true;

        if (currentPermissions == null || currentPermissions.Count == 0)
        {
            string safeModule = module.ToLower();
            if ((userRole == "commercial" || userRole == "secretaire") && safeModule == "messages") return true;
            if (userRole == "commercial" && safeModule == "commandes") return true;
            return false;
        }

        if (currentPermissions.TryGetValue(module, out var actions) && actions.TryGetValue(action, out var allowed))
        {
            return allowed;
        }

        return false;
    }

    private void LoadLocalData()
    {
        try
        {
            var orders = DataSync.GetAllLocal<OrderModel>();
            localOrders = orders.ToDictionary(o => o.Id, o => o);

            var prods = DataSync.GetAllLocal<Product>();
            localProducts = prods.ToDictionary(p => p.Id, p => new LocalProductDto { Id = p.Id, Name = p.Name, Quantity = p.Quantity, Price = (decimal)p.Price, MaxDiscount = (decimal)(p.MaxDiscount ?? 0) });

            localUsers.Clear();

            // 1. Clients B2B
            var b2b = DataSync.GetAllLocal<UserB2BModel>();
            if (b2b != null)
            {
                foreach (var u in b2b)
                {
                    if (!string.IsNullOrEmpty(u.Id))
                    {
                        localUsers[u.Id] = new LocalUserDto { Name = u.Name ?? "", ShopName = u.ShopName ?? "", Email = u.Email ?? "", Phone = u.Phone ?? "", Address = u.Address ?? "", Role = u.Role ?? "client" };
                    }
                }
            }

            // 2. Utilisateurs Normaux (depuis StaffModel)
            var staffs = DataSync.GetAllLocal<StaffModel>();
            if (staffs != null)
            {
                foreach (var s in staffs)
                {
                    string uid = s.Id;
                    if (!string.IsNullOrEmpty(uid) && !localUsers.ContainsKey(uid))
                    {
                        // On utilise les propriétés existantes dans StaffModel pour extraire le numéro et l'adresse.
                        // (Requiert l'ajout de Phone et Address dans Models/StaffModel.cs)
                        localUsers[uid] = new LocalUserDto 
                        { 
                            Name = s.Name ?? "", 
                            Email = s.Email ?? "", 
                            Phone = "", // Pas de téléphone
                            Address = "", // Pas d'adresse
                            Role = s.Role ?? "client" 
                        };
                    }
                }
            }

            var settings = DataSync.GetAllLocal<CompanySettings>().FirstOrDefault();
            localCompanyInfos = settings ?? new CompanySettings();
        }
        catch { }
    }

    private async Task FetchChatsAsync()
    {
        if (string.IsNullOrEmpty(idToken)) return;

        try
        {
            using var client = new HttpClient();
            string ts = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds().ToString();
            var response = await client.GetAsync($"https://bothtech-4c076-default-rtdb.firebaseio.com/chats.json?auth={idToken}&_t={ts}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                if (json != "null")
                {
                    var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true, NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowReadingFromString };
                    localChats = JsonSerializer.Deserialize<Dictionary<string, ChatSession>>(json, options) ?? new();
                }
            }
        }
        catch { }
    }

    private async Task StartRealtimeListener()
    {
        if (string.IsNullOrEmpty(idToken)) return;

        string url = $"https://bothtech-4c076-default-rtdb.firebaseio.com/.json?auth={idToken}";
        try
        {
            using var client = new HttpClient();
            client.Timeout = System.Threading.Timeout.InfiniteTimeSpan;
            var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Accept.Add(new System.Net.Http.Headers.MediaTypeWithQualityHeaderValue("text/event-stream"));
            request.Options.Set(new HttpRequestOptionsKey<bool>("WebAssemblyEnableStreamingResponse"), true);

            using var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, _streamingCts.Token);
            using var stream = await response.Content.ReadAsStreamAsync();
            using var reader = new StreamReader(stream);
            bool isFirstPayload = true;

            while (!_streamingCts.IsCancellationRequested)
            {
                var line = await reader.ReadLineAsync();
                if (line == null) break;

                if (line.StartsWith("event: "))
                {
                    var eventType = line.Substring(7);
                    var dataLine = await reader.ReadLineAsync();
                    if (eventType == "put" || eventType == "patch")
                    {
                        if (isFirstPayload && dataLine != null && dataLine.Contains("\"path\":\"/\"")) { isFirstPayload = false; continue; }
                        isFirstPayload = false;
                        await InvokeAsync(async () =>
                        {
                            LoadLocalData();
                            await FetchChatsAsync();
                            if (!string.IsNullOrEmpty(selectedClientId)) SelectClient(selectedClientId, selectedClientName);
                            if (currentTab == "messages" && selectedClientId != null) await ScrollToBottom();
                            StateHasChanged();
                        });
                    }
                }
            }
        }
        catch { if (!_streamingCts.IsCancellationRequested) { await Task.Delay(5000); _ = StartRealtimeListener(); } }
    }

    private IEnumerable<string> FilteredChatUids
    {
        get { 
            return localChats.Keys.Where(uid => { 
                var latestOrder = localOrders.Values.Where(o => o.ClientId == uid || o.UserId == uid).OrderByDescending(o => o.CreatedAt).FirstOrDefault(); 
                var msgs = localChats[uid].Messages?.Values;
                long latestMsgTime = (msgs != null && msgs.Any()) ? msgs.Max(m => m.Timestamp) : 0;
                long refTime = latestOrder?.CreatedAt ?? latestMsgTime; 
                
                bool isArchived = false;
                if (latestOrder != null) {
                    isArchived = (latestOrder.Status == "validee" || latestOrder.Status == "livree" || (DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - refTime) > 5L * 24 * 60 * 60 * 1000);
                } else {
                    isArchived = (DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - refTime) > 5L * 24 * 60 * 60 * 1000;
                }
                
                return archiveFilter == "archive" ? isArchived : !isArchived; 
            }).OrderByDescending(uid => { 
                var msgs = localChats[uid].Messages?.Values;
                return (msgs != null && msgs.Any()) ? msgs.Max(m => m.Timestamp) : 0;
            }); 
        }
    }

    private void SelectClient(string clientId, string clientName)
    {
        selectedClientId = clientId;
        currentTab = "details";
        
        var clientOrders = localOrders.Values.Where(o => o.ClientId == clientId || o.UserId == clientId).OrderByDescending(o => o.CreatedAt).ToList();
        var activeOrder = clientOrders.FirstOrDefault();
        
        // On récupère une ancienne commande qui a déjà un numéro de téléphone ou une adresse pour s'en servir comme modèle
        var previousOrderWithDetails = clientOrders.FirstOrDefault(o => !string.IsNullOrWhiteSpace(o.RecipientPhone) || !string.IsNullOrWhiteSpace(o.RecipientAddress));

        if (activeOrder != null)
        {
            activeOrder.DeliveryType = "livraison";
            
            string foundPhone = previousOrderWithDetails?.RecipientPhone ?? "";
            string foundAddress = previousOrderWithDetails?.RecipientAddress ?? "";
            
            if (localUsers.ContainsKey(clientId))
            {
                var u = localUsers[clientId];
                string realName = !string.IsNullOrWhiteSpace(u.ShopName) ? u.ShopName : (!string.IsNullOrWhiteSpace(u.Name) ? u.Name : clientName);
                
                if (string.IsNullOrWhiteSpace(activeOrder.RecipientName)) activeOrder.RecipientName = realName;
                selectedClientName = realName;
                
                // Si l'utilisateur a un téléphone dans la base (ex: StaffModel ou UserB2BModel), on l'utilise.
                if (!string.IsNullOrWhiteSpace(u.Phone)) foundPhone = u.Phone;
                if (!string.IsNullOrWhiteSpace(u.Address)) foundAddress = u.Address;
            }
            else 
            { 
                selectedClientName = clientName; 
            }

            // Application intelligente des informations trouvées :
            // Si la commande actuelle n'a pas de téléphone, on met le téléphone trouvé (Base de données OU Ancienne commande)
            if (string.IsNullOrWhiteSpace(activeOrder.RecipientPhone) && !string.IsNullOrWhiteSpace(foundPhone)) 
                activeOrder.RecipientPhone = foundPhone;
            
            // Pareil pour l'adresse
            if (string.IsNullOrWhiteSpace(activeOrder.RecipientAddress) && !string.IsNullOrWhiteSpace(foundAddress)) 
                activeOrder.RecipientAddress = foundAddress;
        }
        else 
        { 
            selectedClientName = clientName; 
        }
        StateHasChanged();
    }

    private async Task SwitchTab(string tab) { currentTab = tab; StateHasChanged(); if (tab == "messages") await ScrollToBottom(); }

    private void TakeChargeTicket()
    {
        if (!canModifyMessages) return;

        var o = localOrders.Values.Where(ord => ord.ClientId == selectedClientId).OrderByDescending(ord => ord.CreatedAt).FirstOrDefault();
        if (o == null) return;

        o.Status = "en_cours";
        o.TraitePar = currentAdminName;
        DataSync.SaveLocal(o);

        var payload = new Dictionary<string, object> { { "status", "en_cours" }, { "traitePar", currentAdminName } };
        DataSync.EnqueueOperation("OrderModel", o.Id, "UPDATE", payload);

        if (!string.IsNullOrEmpty(idToken))
        {
            _ = DataSync.PushPendingOperationsAsync(idToken);
        }
    }

    private void TransferTicket()
    {
        if (!canModifyMessages) return;

        var o = localOrders.Values.Where(ord => ord.ClientId == selectedClientId).OrderByDescending(ord => ord.CreatedAt).FirstOrDefault();
        if (o == null || string.IsNullOrEmpty(selectedTransferAgent)) return;

        o.Status = "en_cours";
        o.TraitePar = selectedTransferAgent;
        DataSync.SaveLocal(o);

        var payload = new Dictionary<string, object> { { "status", "en_cours" }, { "traitePar", selectedTransferAgent } };
        DataSync.EnqueueOperation("OrderModel", o.Id, "UPDATE", payload);

        if (!string.IsNullOrEmpty(idToken))
        {
            _ = DataSync.PushPendingOperationsAsync(idToken);
        }

        currentTab = "details";
    }

    private void UpdateItemQuantity(string itemId, object? value)
    {
        if (!canModifyMessages) return;

        var o = localOrders.Values.Where(ord => ord.ClientId == selectedClientId).OrderByDescending(ord => ord.CreatedAt).FirstOrDefault();
        if (o != null && int.TryParse(value?.ToString(), out int qty)) { var item = o.Items.FirstOrDefault(i => i.Id == itemId); if (item != null) item.Quantity = qty; }
    }

    private async Task SaveChanges()
    {
        if (!canModifyMessages) return;

        var o = localOrders.Values.Where(ord => ord.ClientId == selectedClientId).OrderByDescending(ord => ord.CreatedAt).FirstOrDefault();
        if (o == null) return;

        decimal totalMaxDiscountAllowed = o.Items.Sum(i => { var mp = GetMatchingProduct(i); return mp != null ? mp.MaxDiscount * i.Quantity : 0; });
        if ((o.Discount ?? 0) > (double)totalMaxDiscountAllowed) { await JSRuntime.InvokeVoidAsync("alert", $"⚠ Réduction max : {FormatMoney((double)totalMaxDiscountAllowed)}."); return; }

        o.DeliveryType = "livraison";
        o.Total = (double)o.Items.Sum(i => i.Quantity * i.Price) + (o.DeliveryFee ?? 0) - (o.Discount ?? 0);

        DataSync.SaveLocal(o);
        DataSync.EnqueueOperation("OrderModel", o.Id, "UPDATE", o);

        if (!string.IsNullOrEmpty(idToken))
        {
            _ = DataSync.PushPendingOperationsAsync(idToken);
        }

        await JSRuntime.InvokeVoidAsync("alert", "Facture mise à jour (Synchronisation en cours).");
    }

