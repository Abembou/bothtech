    private async Task ValidateSale()
    {
        if (!canModifyMessages) return;

        var o = localOrders.Values.Where(ord => ord.ClientId == selectedClientId).OrderByDescending(ord => ord.CreatedAt).FirstOrDefault();
        if (o == null) return;

        try
        {
            foreach (var item in o.Items)
            {
                var matchedProduct = GetMatchingProduct(item);
                if (matchedProduct != null && !string.IsNullOrEmpty(matchedProduct.Id))
                {
                    int newStock = matchedProduct.Quantity - item.Quantity;
                    if (newStock < 0) newStock = 0;
                    matchedProduct.Quantity = newStock;

                    var fullProduct = DataSync.GetAllLocal<Product>().FirstOrDefault(p => p.Id == matchedProduct.Id);
                    if (fullProduct != null) { fullProduct.Quantity = newStock; DataSync.SaveLocal(fullProduct); }

                    var movement = new StockMovement
                    {
                        MovementId = Guid.NewGuid().ToString("N"),
                        ProductId = matchedProduct.Id,
                        QuantityChange = -item.Quantity,
                        MovementType = "SALE",
                        OrderId = o.Id,
                        AgentId = currentAdminUid,
                        Date = DateTime.UtcNow
                    };
                    DataSync.SaveLocal(movement);
                    DataSync.EnqueueOperation("StockMovement", movement.MovementId, "CREATE", movement);
                }
            }

            o.Status = "validee";
            DataSync.SaveLocal(o);
            DataSync.EnqueueOperation("OrderModel", o.Id, "UPDATE", new { status = "validee" });

            await SendAutoMessage("✅ *COMMANDE VALIDÉE*\nVotre paiement a été reçu et validé. Votre commande est en cours de préparation pour la livraison.");

            if (!string.IsNullOrEmpty(idToken))
            {
                _ = DataSync.PushPendingOperationsAsync(idToken);
            }

            LoadLocalData();
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"Erreur de validation : {ex.Message}"); }
    }

