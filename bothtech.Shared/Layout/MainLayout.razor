    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                string savedEmail = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_useremail") ?? "";

                if (!string.IsNullOrEmpty(savedEmail) && !AuthService.IsAuthenticated)
                {
                    string savedName = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_username") ?? "Client BothTech";
                    userPhone = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userphone") ?? "";
                    userAddress = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_useraddress") ?? "";
                    userRole = (await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userrole") ?? "client").ToLower().Trim();

                    string savedUid = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userid") ?? "";

                    if (!PlatformService.IsMaui && userRole != "client" && userRole != "maintenance")
                    {
                        await JSRuntime.InvokeVoidAsync("alert", "Votre compte nécessite l'application native. La version Web est réservée aux clients.");
                        await HandleLogout();
                        return;
                    }

                    var user = new User { Email = savedEmail, Name = savedName, Role = userRole, FirebaseUid = savedUid };
                    AuthService.RestoreSession(user);

                    await Task.Delay(200);

                    if (IsProfileIncomplete) { isProfileOpen = true; }
                    StateHasChanged();
                }

                // Chargement des permissions pour l'affichage de "Espace Équipe"
                if (userRole != "client" && !string.IsNullOrEmpty(userRole))
                {
                    LoadUserPermissionsLocal(userRole);
                }

                currentUserId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userid") ?? "";
                if (!string.IsNullOrEmpty(currentUserId)) { _ = StartClientChatListener(); }

                string idToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_idtoken") ?? "";

                if (!string.IsNullOrEmpty(idToken))
                {
                    _ = DataSync.PushPendingOperationsAsync(idToken);

                    // 👉 L'ASPIRATION DE FIREBASE RESTAURÉE ET PROTÉGÉE ICI
                    _ = Task.Run(async () =>
                    {
                        try
                        {
                            await DataSync.PullProductsFromFirebaseAsync();

                            if (userRole != "client")
                            {
                                await DataSync.PullStaffFromFirebaseAsync(idToken);
                            }

                            await InvokeAsync(StateHasChanged);
                        }
                        catch (Exception bgEx)
                        {
                            // Protège le thread d'arrière-plan en cas d'erreur de réseau ou Firebase
                            Console.WriteLine($"Erreur d'aspiration Firebase en arrière-plan : {bgEx.Message}");
                        }
                    });
                }
            }
            catch (TaskCanceledException)
            {
                // Ignorer, le composant a été fermé ou la page actualisée
            }
            catch (JSDisconnectedException)
            {
                // Ignorer, perte de connexion avec le navigateur
            }
            catch (Exception ex)
            {
                // Capture le crash SQLite pour empêcher la boucle de redirection
                System.Diagnostics.Debug.WriteLine($"Erreur globale OnAfterRender MainLayout : {ex.Message}");
            }
        }
    }

    private async Task HandleAgentLocalLogin()
    {
        authErrorMessage = "";

        try
        {
            var localStaff = DataSync.GetAllLocal<StaffModel>()
                                     .FirstOrDefault(s => s.Email != null && s.Email.ToLower() == inputEmail.ToLower() && s.LocalPassword == inputPassword);

            if (localStaff != null)
            {
                if (!localStaff.Active)
                {
                    authErrorMessage = "Ce compte a été suspendu par l'administrateur.";
                    return;
                }

                // Mise à jour des variables d'état du layout
                currentUserId = localStaff.Id;
                userEmail = localStaff.Email;
                userName = localStaff.Name ?? "Agent";
                userRole = (localStaff.Role ?? "client").ToLower().Trim();

                try { userPhone = localStaff.Phone ?? ""; } catch { }
                try { userAddress = localStaff.Address ?? ""; } catch { }

                // Sauvegarde dans le cache local
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_userid", currentUserId);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_useremail", userEmail);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_username", userName);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_userrole", userRole);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_userphone", userPhone);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_useraddress", userAddress);

                // Restauration de la session pour Blazor
                var user = new User { Email = userEmail, Name = userName, Role = userRole, FirebaseUid = currentUserId };
                AuthService.RestoreSession(user);

                await Task.Delay(300);

                // Fermeture de la modale et rechargement des permissions corrigées
                isAuthOpen = false;
                LoadUserPermissionsLocal(userRole);
                StateHasChanged();

                // Routage intelligent
                GoToAdminDashboard();
            }
            else
            {
                authErrorMessage = "Identifiants incorrects ou compte inexistant.";
            }
        }
        catch (Exception ex)
        {
            authErrorMessage = "Erreur de base de données. L'application doit être mise à jour.";
            Console.WriteLine($"Erreur : {ex.Message}");
        }
    }

