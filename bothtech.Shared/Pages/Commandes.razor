@page "/commandes"
@layout bothtech.Shared.Layout.AdminLayout
@using bothtech.Shared.Models
@using bothtech.Shared.Services
@using System.Globalization
@inject FirebaseService FirebaseService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

<PageTitle>Commandes en ligne | Console Admin</PageTitle>

<!-- MENU DES ONGLETS DE VENTE -->
<div class="ventes-tabs" style="padding: 0 15px;">
    <button class="ventes-tab-btn active">
        📋 Commandes
        @if (NewOrdersCount > 0)
        {
            <span class="tab-badge" style="display:inline-block;">@NewOrdersCount</span>
        }
    </button>
    <NavLink class="ventes-tab-btn" href="/ventecomptoir" style="text-decoration:none;">🛒 Comptoir</NavLink>
    <NavLink class="ventes-tab-btn" href="/venteb2b" style="text-decoration:none;">🏢 B2B (Gros)</NavLink>
</div>

<div style="padding: 0 15px 20px 15px;">
    <section class="card">
        <div class="card-header">
            <h2 class="card-title" style="margin: 0; font-size: 1.2rem;">Tickets & Ventes en ligne</h2>

            <select class="form-control" @bind="StatusFilter">
                <option value="all">Toutes les commandes</option>
                <option value="nouveau">Nouvelles (Devis)</option>
                <option value="en_cours">En Discussion</option>
                <option value="validee">Conclue (À livrer)</option>
                <option value="livree">Livrée</option>
                <option value="annulee">Vente Annulée</option>
            </select>
        </div>

        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th class="hide-mobile">Date</th>
                        <th>Client</th>
                        <th class="hide-mobile">Articles</th>
                        <th class="hide-mobile">Total</th>
                        <th class="hide-mobile" style="text-align: center;">Statut</th>
                        <th style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (IsLoading)
                    {
                        <tr><td colspan="6" style="text-align: center; padding: 20px;">Chargement des commandes...</td></tr>
                    }
                    else if (!FilteredOrders.Any())
                    {
                        <tr><td colspan="6" style="text-align: center; padding: 20px; color:var(--text-muted);">Aucune commande en ligne trouvée.</td></tr>
                    }
                    else
                    {
                        @foreach (var kvp in FilteredOrders)
                        {
                            var orderId = kvp.Key;
                            var order = kvp.Value;
                            string orderUid = !string.IsNullOrEmpty(order.ClientId) ? order.ClientId : order.UserId;

                            <tr>
                                <td class="hide-mobile"><small>@FormatDate(order.CreatedAt)</small></td>
                                <td>
                                    <b>@(string.IsNullOrEmpty(order.ClientName) ? order.RecipientName : order.ClientName)</b>

                                    <!-- Affichage Mobile -->
                                    <div class="mobile-only-display" style="margin-top:8px; font-size:0.85rem; line-height: 1.5; border-top:1px dashed var(--border); padding-top:8px;">
                                        <span style="color:var(--text-muted);">🕒 @FormatDate(order.CreatedAt)</span><br>
                                        <b>@FormatMoney(order.Total)</b><br>
                                        @((MarkupString)GetStatusBadge(order.Status))
                                    </div>
                                </td>
                                <td class="hide-mobile"><small>@((MarkupString)GetItemsHtml(order.Items))</small></td>
                                <td class="hide-mobile">
                                    <b>@FormatMoney(order.Total)</b>
                                    @if ((order.Type == "b2b" || order.Type == "b2b_en_ligne") && order.Reste > 0)
                                    {
                                        <br>
                            
                                        <small style="color:var(--danger); font-weight:bold;">Reste: @FormatMoney(order.Reste)</small>
                                    }
                                </td>
                                <td class="hide-mobile" style="text-align:center;">
                                    @((MarkupString)GetStatusBadge(order.Status))
                                </td>
                                <td style="text-align:right; vertical-align:middle;">
                                    <div class="action-buttons-container">
                                        @if (string.IsNullOrEmpty(order.TraitePar))
                                        {
                                            <button class="btn btn-primary btn-action" @onclick="() => TakeCharge(orderId, orderUid)" style="background: var(--primary); color: white; border: none;">✋ Prendre</button>
                                        }
                                        else if (order.TraitePar == CurrentUserName || userRole == "admin" || userRole == "maintenance")
                                        {
                                            <span style="font-size:0.75rem; color:var(--primary); font-weight:bold; text-align:center; display:block; margin-bottom:5px;">👤 @(order.TraitePar == CurrentUserName ? "Moi" : order.TraitePar)</span>
                                            <button class="btn btn-outline btn-action" @onclick="() => OpenChat(orderUid)">💬 Ouvrir</button>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning" style="text-align:center; padding: 6px;">🔒 En cours par<br>@order.TraitePar</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div id="toast" style="display:block; position: fixed; bottom: 20px; right: 20px; background: #333; color: white; padding: 10px 20px; border-radius: 5px; z-index: 9999;">@ToastMessage</div>
}

@code {
    private bool IsLoading = true;
    private Dictionary<string, OrderModel> localOrders = new();
    private string _statusFilter = "all";
    private string ToastMessage = "";

    // Identifiants de session réels
    private string CurrentUserName = "Agent";
    private string userRole = "client";
    private string idToken = "";

    private string StatusFilter
    {
        get => _statusFilter;
        set { _statusFilter = value; }
    }

    private int NewOrdersCount => localOrders.Values.Count(o => o.Status == "nouveau");

    // Filtrage dynamique
    private IEnumerable<KeyValuePair<string, OrderModel>> FilteredOrders => localOrders
        .Where(o => o.Value.Type != "comptoir" && o.Value.Type != "b2b")
        .Where(o => StatusFilter == "all" || o.Value.Status == StatusFilter)
        .OrderByDescending(o => o.Value.CreatedAt);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Récupération des vrais accès locaux
                userRole = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userrole") ?? "client";
                string email = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_useremail") ?? "Agent";
                CurrentUserName = email;
                idToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_idtoken") ?? "";

                // Sécurité : Blocage des clients
                if (userRole == "client" || userRole == "detaillant")
                {
                    NavManager.NavigateTo("/", true);
                    return;
                }

                await LoadOrdersAsync();
            }
            catch
            {
                NavManager.NavigateTo("/", true);
            }
        }
    }

    private async Task LoadOrdersAsync()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            // Appel au vrai service Firebase
            localOrders = await FirebaseService.GetOrdersAsync();
        }
        catch (Exception ex)
        {
            await ShowToast("Erreur de synchronisation : " + ex.Message);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task TakeCharge(string orderId, string targetUid)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Prendre en charge cette commande ?");
        if (!confirm) return;

        try
        {
            // 1. Mise à jour dans Firebase
            await FirebaseService.UpdateOrderStatusAndAgentAsync(orderId, "en_cours", CurrentUserName, idToken);

            // 2. Mise à jour de l'affichage local sans recharger toute la base
            if (localOrders.ContainsKey(orderId))
            {
                localOrders[orderId].TraitePar = CurrentUserName;
                localOrders[orderId].Status = "en_cours";
            }

            await ShowToast("✅ Vous avez pris en charge cette commande.");

            // 3. Redirection automatique vers le chat si possible
            if (!string.IsNullOrEmpty(targetUid))
            {
                OpenChat(targetUid);
            }
        }
        catch (Exception ex)
        {
            await ShowToast("❌ Erreur : " + ex.Message);
        }
    }

    private void OpenChat(string clientId)
    {
        if (!string.IsNullOrEmpty(clientId))
        {
            NavManager.NavigateTo($"/chat?uid={clientId}"); // Ajustez l'URL vers votre route de chat
        }
    }

    private string FormatMoney(decimal amount)
    {
        var nfi = (NumberFormatInfo)CultureInfo.GetCultureInfo("fr-FR").NumberFormat.Clone();
        nfi.NumberGroupSeparator = " ";
        return amount.ToString("N0", nfi) + " FCFA";
    }

    private string FormatDate(long timestamp)
    {
        if (timestamp < 10000000000)
            return DateTimeOffset.FromUnixTimeSeconds(timestamp).LocalDateTime.ToString("dd/MM/yyyy HH:mm");
        return DateTimeOffset.FromUnixTimeMilliseconds(timestamp).LocalDateTime.ToString("dd/MM/yyyy HH:mm");
    }

    private string GetItemsHtml(List<OrderItem> items)
    {
        if (items == null || !items.Any()) return "";
        return string.Join("<br>", items.Select(i => $"{i.Quantity}x {i.Name}"));
    }

    private string GetStatusBadge(string status)
    {
        return status switch
        {
            "validee" => "<span class=\"badge badge-primary\" style=\"background: var(--primary-subtle); color: var(--primary);\">À livrer</span>",
            "livree" => "<span class=\"badge badge-success\" style=\"background: var(--success-subtle); color: var(--success);\">Livrée</span>",
            "annulee" => "<span class=\"badge badge-danger\" style=\"background: var(--danger-subtle); color: var(--danger);\">Annulée</span>",
            "nouveau" => "<span class=\"badge badge-purple\" style=\"background: #f3e8ff; color: var(--purple);\">Nouveau Devis</span>",
            "en_cours" => "<span class=\"badge badge-info\" style=\"background: #e0f2fe; color: #0284c7;\">En discussion</span>",
            _ => $"<span class=\"badge badge-info\" style=\"background: #e2e8f0; color: #475569;\">{status}</span>"
        };
    }

    private async Task ShowToast(string message)
    {
        ToastMessage = message;
        StateHasChanged();
        await Task.Delay(3000);
        ToastMessage = "";
        StateHasChanged();
    }
}