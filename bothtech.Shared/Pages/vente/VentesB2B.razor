@page "/vente/venteb2b"
@layout bothtech.Shared.Layout.AdminLayout
@using bothtech.Shared.Models
@using bothtech.Shared.Services
@using System.Globalization
@using System.Text.Json
@inject DatabaseService DbService
@inject DataSyncService DataSync
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
<PageTitle>Ventes B2B | Console Admin</PageTitle>

<style>
    /* =========================================
       STYLES DE L'APPLICATION (ÉCRAN)
       ========================================= */
    .ventes-tab-btn {
        padding: 10px 20px;
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--text-muted);
        background: transparent;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        text-decoration: none;
        display: inline-block;
    }

    .ventes-tab-btn:hover {
        background: #f1f5f9;
        color: var(--primary);
    }

    .ventes-tab-btn.active {
        background: var(--primary);
        color: white;
        box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
    }

    .mobile-only-display { display: none; }

    @@media (max-width: 768px) {
        .hide-mobile { display: none !important; }
        .mobile-only-display { display: block; }
        .pos-line-item { flex-direction: column; align-items: stretch; }
        .pos-line-item > div { width: 100%; min-width: 100% !important; }
        .avance-container { flex-direction: column; align-items: stretch !important; gap: 12px !important; }
        .avance-container input { width: 100% !important; text-align: left !important; }
        .receipt-total { flex-direction: column; align-items: flex-end; gap: 5px; }
    }

    /* =========================================
       STYLES D'IMPRESSION (GÉNÉRATION PDF PUR)
       ========================================= */
    @@media screen {
        .only-print { display: none !important; }
    }

    @@media print {
        /* 1. Marge à 0 pour effacer l'URL du navigateur */
        @@page { size: A4; margin: 0; }

        /* 2. On cache absolument TOUT le site (Sidebar, Navbar, Formulaires) */
        body * {
            visibility: hidden;
        }

        /* 3. On remet de l'espace à l'intérieur du document pour compenser le margin: 0 */
        html, body {
            overflow: visible !important;
            height: auto !important;
            background-color: #fff !important;
            margin: 0 !important;
            padding: 15mm !important;
        }

        /* 4. On extrait la facture et on l'affiche au premier plan */
        .only-print {
            visibility: visible !important;
            position: absolute;
            top: 10mm;
            left: 10mm;
            right: 10mm;
            display: block !important;
            margin: 0;
            padding: 0;
        }

        /* 5. On rend visible tout le contenu à l'intérieur de la facture */
        .only-print * {
            visibility: visible !important;
        }

        /* Design de la Facture */
        .facture-container { font-family: 'Segoe UI', Arial, sans-serif; color: #0f172a; }
        .facture-top-bar { border-top: 8px solid #1d4ed8; width: 100%; margin-bottom: 25px; }
        .facture-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px; }
        .facture-title-box { text-align: center; margin-bottom: 40px; }
        .facture-title { display: inline-block; font-size: 1.8rem; font-weight: 900; letter-spacing: 3px; color: #0f172a; text-transform: uppercase; border-top: 3px solid #1d4ed8; border-bottom: 3px solid #1d4ed8; padding: 8px 20px; margin: 0; }
        .facture-cards { display: flex; gap: 20px; margin-bottom: 30px; }
        .facture-card { flex: 1; border: 1px solid #cbd5e1; border-radius: 8px; padding: 15px; background: #f8fafc; }
        .facture-card h4 { font-size: 0.8rem; color: #64748b; margin-top: 0; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px; }
        .facture-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        .facture-table th { background-color: #1e293b; color: white; padding: 12px 10px; text-align: left; font-size: 0.9rem; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        .facture-table td { padding: 12px 10px; border-bottom: 1px solid #e2e8f0; font-size: 0.95rem; }
        .facture-totals-wrapper { display: flex; justify-content: flex-end; margin-bottom: 30px; }
        .facture-totals-table { width: 300px; border-collapse: collapse; }
        .facture-totals-table td { padding: 10px; border: 1px solid #e2e8f0; }
        .total-row { background-color: #1d4ed8; color: white; font-weight: bold; font-size: 1.1rem; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        .amount-in-words { border-left: 4px solid #1d4ed8; padding-left: 15px; margin-bottom: 50px; font-size: 0.95rem; }
        .signatures { display: flex; justify-content: space-around; margin-top: 40px; text-align: center; }
        .signatures div { width: 40%; }
        .sig-line { border-bottom: 1px solid #cbd5e1; margin-top: 60px; margin-bottom: 10px; }

        /* Style pour le pied de page personnalisé */
        .custom-print-footer {
            position: fixed;
            bottom: 10mm;
            left: 0;
            width: 100%;
            text-align: center;
            font-size: 0.9rem;
            font-weight: 700;
            color: #1d4ed8;
            letter-spacing: 1px;
        }
    }
</style>

<!-- =========================================
     MODÈLE D'IMPRESSION (FACTURE EXACTE A4)
     ========================================= -->
@if (InvoiceToPrint != null)
{
    <div class="only-print facture-container">
        <div class="facture-top-bar"></div>

        <div class="facture-header">
            <!-- Logo et Enseigne (Données depuis CompanySettings) -->
            <div style="display: flex; align-items: center; gap: 15px;">
                <div style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; overflow:hidden;">
                    <img src="/images/Both_Tech_Burkina.jpeg" style="max-width: 100%; max-height: 100%; object-fit: contain;" alt="Logo Both Tech" />
                </div>
                <div>
                    <!-- Utilisation du nom de l'entreprise ou fallback par défaut -->
                    <h2 style="margin: 0; color: #0f172a; font-weight: 900; font-size: 1.5rem; letter-spacing: 1px;">@(CompanyInfos?.Name ?? "BOTH TECH BURKINA")</h2>
                    <p style="margin: 5px 0; color: #64748b; font-size: 0.9rem; text-transform: uppercase;">Vente de matériels informatiques</p>
                    <p style="margin: 0; color: #1d4ed8; font-weight: bold;">Réf. Facture : @InvoiceToPrint.Id?.Substring(0, 8).ToUpper()</p>
                </div>
            </div>

            <!-- Infos Entreprise Droite (Données depuis CompanySettings) -->
            <div style="text-align: right;">
                <h3 style="margin: 0; font-weight: 900; font-size: 1.2rem;">@(CompanyInfos?.Country ?? "BURKINA FASO")</h3>
                <p style="margin: 5px 0; color: #1d4ed8; font-style: italic; font-size: 0.9rem;">@(CompanyInfos?.Slogan ?? "La Patrie ou la Mort, nous vaincrons")</p>
                <p style="margin: 5px 0; font-size: 0.85rem;"><b>N° IFU :</b> @(CompanyInfos?.Ifu ?? "0000000000X")</p>
                <p style="margin: 5px 0; font-size: 0.85rem;"><b>Adresse :</b> @(CompanyInfos?.Address ?? "Ouagadougou, Kadiogo")</p>
                <p style="margin: 5px 0; font-size: 0.85rem;"><b>Tél :</b> @(CompanyInfos?.Phone ?? "+226 70 00 00 00")</p>
            </div>
        </div>

        <div class="facture-title-box">
            <h1 class="facture-title">FACTURE PARTENAIRE</h1>
        </div>

        <div class="facture-cards">
            <div class="facture-card">
                <h4>Détails du document</h4>
                <p style="margin: 5px 0;"><b>Date d'émission :</b> @FormatDate(InvoiceToPrint.CreatedAt)</p>
                <p style="margin: 5px 0; display: flex; align-items: center; gap: 8px;">
                    <b>Moyen de paiement :</b> 
                    <span style="background: #eff6ff; color: #1d4ed8; padding: 2px 8px; border-radius: 4px; font-weight: 600; font-size: 0.85rem; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important;">@FormatPaymentMethod(InvoiceToPrint.PaymentMethod)</span>
                </p>
            </div>
            <div class="facture-card">
                <h4>Facturé à</h4>
                <p style="margin: 5px 0; font-size: 1.1rem;"><b>@InvoiceToPrint.ClientName</b></p>
                <p style="margin: 5px 0;"><b>Tél :</b> @InvoiceToPrint.RecipientPhone</p>
                <p style="margin: 5px 0;"><b>Adresse :</b> @InvoiceToPrint.RecipientAddress</p>
            </div>
        </div>

        <table class="facture-table">
            <thead>
                <tr>
                    <th style="width: 5%;">N°</th>
                    <th style="width: 45%;">Désignation</th>
                    <th style="width: 10%; text-align: center;">Qté</th>
                    <th style="width: 20%; text-align: right;">PU</th>
                    <th style="width: 20%; text-align: right;">PT</th>
                </tr>
            </thead>
            <tbody>
                @if (InvoiceToPrint.Items != null)
                {
                    int index = 1;
                    foreach (var item in InvoiceToPrint.Items)
                    {
                        <tr>
                            <td style="color: #64748b;">@index</td>
                            <td>@item.ProductName</td>
                            <td style="text-align: center;">@item.Quantity</td>
                            <td style="text-align: right;">@FormatMoney(item.UnitPrice)</td>
                            <td style="text-align: right; font-weight: bold; color: #0f172a;">@FormatMoney(item.Quantity * item.UnitPrice)</td>
                        </tr>
                        index++;
                    }
                }
            </tbody>
        </table>

        <div class="facture-totals-wrapper">
            <table class="facture-totals-table">
                <tr>
                    <td style="text-align: right; font-weight: 600; text-transform: uppercase; color: #64748b;">Sous-Total :</td>
                    <td style="text-align: right; font-weight: bold; font-size: 1.05rem;">@FormatMoney(InvoiceToPrint.Total)</td>
                </tr>
                @if (InvoiceToPrint.Avance > 0 && InvoiceToPrint.Reste > 0)
                {
                    <tr>
                        <td style="text-align: right; font-weight: 600; text-transform: uppercase; color: #166534;">Avance Payée :</td>
                        <td style="text-align: right; font-weight: bold; color: #166534;">@FormatMoney(InvoiceToPrint.Avance)</td>
                    </tr>
                    <tr>
                        <td style="text-align: right; font-weight: 600; text-transform: uppercase; color: #b45309;">Reste à Payer :</td>
                        <td style="text-align: right; font-weight: bold; color: #b45309;">@FormatMoney(InvoiceToPrint.Reste)</td>
                    </tr>
                }
                <tr class="total-row">
                    <td style="text-align: right;">TOTAL FACTURE :</td>
                    <td style="text-align: right;">@FormatMoney(InvoiceToPrint.Total)</td>
                </tr>
            </table>
        </div>

        <div class="amount-in-words">
            Arrêtée la présente facture à la somme de :<br>
            <b style="color: #0f172a;">@ConvertAmountToWords(InvoiceToPrint.Total).ToUpper() FRANCS CFA.</b>
        </div>

        <div class="signatures">
            <div>
                <span style="font-size: 0.85rem; font-weight: 600; color: #64748b; letter-spacing: 1px;">LE PARTENAIRE</span>
                <div class="sig-line"></div>
                <b>@InvoiceToPrint.ClientName</b>
            </div>
            <div>
                <span style="font-size: 0.85rem; font-weight: 600; color: #64748b; letter-spacing: 1px;">LE VENDEUR</span>
                <div class="sig-line"></div>
                <b>@CurrentUserName</b>
            </div>
        </div>

        <!-- Pied de page personnalisé d'impression -->
        <div class="custom-print-footer">
            BothTech burkina la référence du numérique
        </div>
    </div>
}

<!-- =========================================
     INTERFACE UTILISATEUR (ÉCRAN)
     ========================================= -->
<div class="no-print" style="background: transparent; padding: 20px; margin: 0; overflow-x: hidden; padding-bottom: calc(85px + env(safe-area-inset-bottom, 20px)); font-family: 'Plus Jakarta Sans', sans-serif;">

    <!-- MENU DES ONGLETS DE VENTE -->
    <div style="display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 2px solid var(--border); padding-bottom: 10px; flex-wrap: wrap;">
        <NavLink class="ventes-tab-btn" href="/vente/commandes" style="text-decoration:none;">📋 Commandes en ligne</NavLink>
        <NavLink class="ventes-tab-btn" href="/vente/ventecomptoir" style="text-decoration:none;">🛒 Vente Comptoir</NavLink>
        <NavLink class="ventes-tab-btn" href="/vente/venteb2b" Match="NavLinkMatch.All" style="text-decoration:none;">🏢 Ventes B2B (Gros)</NavLink>
    </div>

    @if (!IsFormView)
    {
        <!-- VUE 1 : HISTORIQUE DES VENTES B2B -->
        <div style="padding: 0 10px 20px 10px;">
            <section class="card">
                <div class="card-header">
                    <div style="display: flex; align-items: center; gap: 15px; width: 100%; flex-wrap: wrap;">
                        @if (canAddB2B)
                        {
                            <button class="btn btn-primary" style="background: var(--success); color: white; border: none; font-weight: bold; cursor: pointer; padding: 14px 15px; flex: 1; min-width: 200px;" @onclick="OpenNewSale">
                                + Nouvelle Vente B2B
                            </button>
                        }
                        <h2 class="card-title hide-mobile" style="margin:0;">Historique B2B</h2>
                    </div>
                    <div class="search-filters" style="margin-top: 15px;">
                        <input type="search" placeholder="Rechercher (Client ou Réf)..." class="form-control" @bind="SearchQuery" @bind:event="oninput" style="width: 100%;">
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th class="hide-mobile">Date / Réf</th>
                                <th>Client / Détails</th>
                                <th class="hide-mobile">Montant</th>
                                <th style="text-align:right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (IsLoading)
                            {
                                <tr><td colspan="4" style="text-align:center; padding:20px;">Chargement...</td></tr>
                            }
                            else if (!FilteredHistory.Any())
                            {
                                <tr><td colspan="4" style="text-align:center; padding:20px; color:var(--text-muted);">Aucune vente B2B locale trouvée.</td></tr>
                            }
                            else
                            {
                                @foreach (var order in FilteredHistory)
                                {
                                    <tr>
                                        <td class="hide-mobile">
                                            <small style="color:var(--text-muted);">@FormatDate(order.CreatedAt)</small><br>
                                            <b style="color:var(--primary);">#@order.Id?.Substring(0, 6).ToUpper()</b>
                                        </td>
                                        <td>
                                            <b>@order.ClientName</b>

                                            <!-- Affichage Mobile Optimisé (Carte) -->
                                            <div class="mobile-only-display" style="margin-top:8px; font-size:0.85rem; border-top:1px dashed var(--border); padding-top:8px; line-height: 1.6;">
                                                <span style="color:var(--text-muted);">@FormatDate(order.CreatedAt)</span><br>
                                                <b style="color:var(--primary);">#@order.Id?.Substring(0, 6).ToUpper()</b><br>
                                                <span style="font-weight: bold; color: var(--text-main); font-size: 1rem;">@FormatMoney(order.Total)</span><br>
                                                
                                                @if (order.Reste > 0)
                                                {
                                                    <span class="badge badge-warning" style="background:#fef08a; color:#854d0e; padding:4px 8px; border-radius:8px; font-weight:bold; display: inline-block; margin-top: 4px;">Partiel (Reste: @FormatMoney(order.Reste))</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success" style="background:#dcf8c6; color:#166534; padding:4px 8px; border-radius:8px; font-weight:bold; display: inline-block; margin-top: 4px;">Soldé</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="hide-mobile">
                                            <b>@FormatMoney(order.Total)</b><br>
                                            @if (order.Reste > 0)
                                            {
                                                <small style="color:var(--danger); font-weight:bold;">Reste: @FormatMoney(order.Reste)</small>
                                            }
                                        </td>
                                        <td style="text-align:right; white-space: nowrap; vertical-align: middle;">
                                            <div class="hide-mobile" style="margin-bottom: 5px;">
                                                @if (order.Reste > 0)
                                                {
                                                    <span class="badge badge-warning" style="background:#fef08a; color:#854d0e; padding:6px 10px; border-radius:8px; font-weight:bold;">Partiel</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success" style="background:#dcf8c6; color:#166534; padding:6px 10px; border-radius:8px; font-weight:bold;">Soldé</span>
                                                }
                                            </div>
                                            <button class="btn btn-outline btn-action" style="padding: 6px 12px; font-size: 1.2rem;" @onclick="() => PrintInvoice(order)" title="Imprimer Facture B2B">🖨️</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }
    else
    {
        <!-- VUE 2 : CAISSE B2B (GROS) -->
        <div style="padding: 0 10px 20px 10px;">
            <section class="card caisse-card">
                <div class="card-header" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px;">
                    <h2 class="card-title" style="margin:0; font-size: 1.1rem;">🏢 Nouvelle Vente B2B</h2>
                    <button type="button" class="btn btn-outline" style="cursor: pointer; flex-shrink: 0;" @onclick="CloseNewSale">🔙 Retour</button>
                </div>

                <div class="card-body caisse-body">
                    <!-- SÉLECTION DU CLIENT -->
                    <div style="background:#f8fafc; padding:15px; border-radius:8px; border:1px solid var(--border); margin-bottom:20px;">
                        <h3 style="font-size:0.95rem; margin-bottom:12px; color:var(--primary);">Sélection du Détaillant</h3>

                        @if (SelectedClient == null)
                        {
                            <input type="search" class="form-control" placeholder="Rechercher par nom/tél..." value="@_clientSearchQuery" @oninput="OnClientSearchInput">
                            @if (SuggestedClients.Any())
                            {
                                <div style="margin-top:10px; border:1px solid var(--border); border-radius:6px; background:white; max-height:200px; overflow-y:auto;">
                                    @foreach (var c in SuggestedClients)
                                    {
                                        <div style="padding:12px; border-bottom:1px solid #eee; cursor:pointer;" @onclick="() => SelectClient(c)">
                                            <b style="font-size: 1rem;">@c.Name</b> <br/>
                                            <span style="color:var(--text-muted); font-size:0.85rem;">📞 @c.Phone</span>
                                        </div>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(_clientSearchQuery))
                            {
                                <div style="margin-top:10px; padding:10px; color:var(--danger); font-size:0.85rem;">Aucun détaillant trouvé.</div>
                            }
                        }
                        else
                        {
                            <div style="display:flex; justify-content:space-between; align-items:center; background:#dcf8c6; padding:12px; border-radius:8px; border:1px solid #b0e59a;">
                                <div style="overflow: hidden;">
                                    <b style="color:#166534; font-size:1rem;">@SelectedClient.Name</b><br />
                                    <span style="color:#14532d; font-size:0.85rem; display: block; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">📞 @SelectedClient.Phone | 📍 @SelectedClient.Address</span>
                                </div>
                                <button class="btn btn-outline" style="color:var(--danger); border:none; background:transparent; font-size:1.5rem; cursor:pointer; padding: 0 10px;" @onclick="ResetClient" title="Changer de client">✖</button>
                            </div>
                        }
                    </div>

                    <!-- LIGNES DE COMMANDE -->
                    <div>
                        @foreach (var line in B2bLines)
                        {
                            <div class="pos-line-item" style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:15px; background:#fff; padding:15px; border:1px solid var(--border); border-radius:8px; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                                <div style="flex:2; min-width:200px;">
                                    <label style="font-size:0.8rem; font-weight:bold; display:block; margin-bottom:5px;">Article (Prix Gros)</label>
                                    <select class="form-control" value="@line.ProductFirebaseId" @onchange="@(e => OnProductSelected(line, e.Value?.ToString() ?? ""))" style="width: 100%;">
                                        <option value="">-- Choisir --</option>
                                        @foreach (var p in _catalog)
                                        {
                                            int displayPrice = (p.PartnerPrice.HasValue && p.PartnerPrice > 0) ? p.PartnerPrice.Value : p.Price;
                                            <option value="@p.Id">@p.Name - @FormatMoney(displayPrice) (Stock: @p.Quantity)</option>
                                        }
                                    </select>
                                </div>
                                <div class="pos-line-inputs" style="display:flex; gap:10px; flex:1; min-width:150px;">
                                    <div style="flex:1;">
                                        <label style="font-size:0.8rem; font-weight:bold; display:block; margin-bottom:5px;">Qté</label>
                                        <input type="number" class="form-control" value="@line.Quantity" min="1" max="@line.MaxStock" @onchange="@(e => OnQuantityChanged(line, e.Value))" style="text-align:center; width: 100%;">
                                    </div>
                                    <div style="flex:2;">
                                        <label style="font-size:0.8rem; font-weight:bold; display:block; margin-bottom:5px;">Total Ligne</label>
                                        <input type="text" class="form-control" value="@FormatMoney(line.LineTotal)" disabled style="font-weight:bold; background:#f1f5f9; color:var(--primary); width: 100%;">
                                    </div>
                                </div>
                                <button class="btn btn-outline" @onclick="() => B2bLines.Remove(line)" style="color:var(--danger); border-color:var(--danger-subtle); font-weight:bold; width: 100%; margin-top: 5px;">🗑️ Supprimer</button>
                            </div>
                        }
                    </div>

                    <button class="btn btn-outline" @onclick="AddLine" style="width:100%; margin-top:10px; border-style:dashed; cursor: pointer; padding: 14px; font-weight: 600; color:var(--primary); border-color:var(--primary-subtle);">+ Ajouter un article</button>

                    <!-- BLOC DES TOTAUX ET AVANCE -->
                    <div class="receipt-block" style="margin-top:25px; padding: 15px; border-radius: 8px; border: 1px solid var(--border); background: #fafafa;">
                        <div class="receipt-row" style="font-size:1.1rem; display:flex; justify-content:space-between; margin-bottom:15px; align-items: center;">
                            <span style="font-weight: 600;">Total (Gros):</span>
                            <span style="font-weight: bold; color:var(--primary); font-size: 1.2rem;">@FormatMoney(SubTotal)</span>
                        </div>

                        <div style="background: #fffbeb; padding: 15px; border-radius: 6px; border: 1px solid #fde68a; margin-bottom: 15px;">
                            <div class="avance-container" style="display:flex; justify-content:space-between; align-items:center;">
                                <span style="font-size:0.95rem; color:#b45309; font-weight: 600;">Avance payée :</span>
                                <input type="number" class="form-control" style="width:150px; text-align:right; font-weight:bold;" placeholder="Montant versé" min="0" max="@SubTotal" @bind="AvanceValue">
                            </div>
                        </div>

                        <div class="receipt-total" style="font-size: 1.1rem; border-top: 2px solid var(--border); padding-top: 15px; display:flex; justify-content:space-between;">
                            <span style="font-weight: 600;">RESTE (Crédit):</span>
                            <span style="font-weight:bold; color:var(--danger); font-size: 1.2rem;">@FormatMoney(ResteAPayer)</span>
                        </div>
                    </div>

                    <div class="form-group" style="margin-top:20px; margin-bottom: 10px;">
                        <label style="font-weight: bold; display:block; margin-bottom: 8px;">Mode d'encaissement (Avance) *</label>
                        <select class="form-control" @bind="SalePaymentMethod" style="width: 100%;">
                            <option value="espece">Espèce (Cash)</option>
                            <option value="mobile_money">Mobile Money</option>
                            <option value="virement">Virement Bancaire</option>
                        </select>
                    </div>
                </div>

                <div class="caisse-footer" style="padding-top: 10px;">
                    <button class="btn btn-success" disabled="@IsProcessing" @onclick="SubmitSale" style="width:100%; background:var(--success); color:white; border:none; padding:16px; font-size:1.15rem; font-weight:bold; cursor: pointer; border-radius: 8px;">
                        @(IsProcessing ? "Enregistrement..." : "✅ Valider Vente B2B")
                    </button>
                </div>
            </section>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div id="toast" style="display:block; position: fixed; bottom: 20px; right: 20px; left: 20px; text-align: center; background: #333; color: white; padding: 12px; border-radius: 8px; z-index: 9999; box-shadow: 0 4px 6px rgba(0,0,0,0.3);">@ToastMessage</div>
}

@code {
    private bool IsLoading = true;
    private bool IsFormView = false;
    private bool IsProcessing = false;
    private string ToastMessage = "";
    private string SearchQuery = "";
    
    // Variables pour l'impression
    private OrderModel? InvoiceToPrint = null;
    private string CurrentUserName = "Agent BothTech";
    private CompanySettings? CompanyInfos = new CompanySettings();

    // Auth & Sync
    private string idToken = "";
    private string CurrentUserId = "";
    private string userRole = "client";

    // Gestion des permissions
    private bool isAdminOrMaintenance = false;
    private bool canReadB2B = false;
    private bool canAddB2B = false;
    private Dictionary<string, Dictionary<string, bool>> currentPermissions = new();

    // Données Locales
    private List<Product> _catalog = new();
    private List<OrderModel> _historyOrders = new();
    private List<UserB2BModel> _b2bClients = new();

    // État du formulaire B2B
    private UserB2BModel? SelectedClient = null;
    private string _clientSearchQuery = "";

    private void OnClientSearchInput(ChangeEventArgs e)
    {
        _clientSearchQuery = e.Value?.ToString() ?? "";
        SelectedClient = null;
    }

    private string SalePaymentMethod = "espece";
    private double? _avanceValue;
    private double? AvanceValue
    {
        get => _avanceValue;
        set { _avanceValue = (value.HasValue && value > SubTotal) ? SubTotal : value; }
    }

    private List<B2bLineItem> B2bLines = new();

    public class B2bLineItem
    {
        public string ProductFirebaseId { get; set; } = "";
        public string ProductName { get; set; } = "";
        public int Quantity { get; set; } = 1;
        public int UnitPrice { get; set; }
        public int MaxStock { get; set; }
        public int LineTotal => Quantity * UnitPrice;
    }

    private int SubTotal => B2bLines.Sum(l => l.Quantity * l.UnitPrice);
    private double ResteAPayer => SubTotal - (_avanceValue ?? SubTotal);

    private IEnumerable<OrderModel> FilteredHistory => _historyOrders
        .Where(o => string.IsNullOrWhiteSpace(SearchQuery) ||
                    (!string.IsNullOrEmpty(o.ClientName) && o.ClientName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(o.Id) && o.Id.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(o => o.CreatedAt);

    private IEnumerable<UserB2BModel> SuggestedClients => string.IsNullOrWhiteSpace(_clientSearchQuery)
        ? Array.Empty<UserB2BModel>()
        : _b2bClients.Where(c => (!string.IsNullOrEmpty(c.Name) && c.Name.Contains(_clientSearchQuery, StringComparison.OrdinalIgnoreCase)) ||
                                 (!string.IsNullOrEmpty(c.Phone) && c.Phone.Contains(_clientSearchQuery)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                idToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_idtoken") ?? "";
                CurrentUserId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userid") ?? "";
                userRole = (await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userrole") ?? "client").ToLower().Trim();
                
                isAdminOrMaintenance = (userRole == "admin" || userRole == "maintenance");

                if (!isAdminOrMaintenance && userRole != "client")
                {
                    LoadUserPermissionsLocal(userRole);
                }

                canReadB2B = HasPerm("b2b", "lecture");
                canAddB2B = HasPerm("b2b", "ajouter");

                if (userRole == "client" || (!isAdminOrMaintenance && !canReadB2B))
                {
                    NavManager.NavigateTo("/", true);
                    return;
                }

                LoadLocalData();

                // Extraction du Vrai Nom de l'agent depuis la base SQLite au lieu de l'Email
                try
                {
                    var staffs = DataSync.GetAllLocal<StaffModel>() ?? new List<StaffModel>();
                    var currentUser = staffs.FirstOrDefault(s => s.Id == CurrentUserId);

                    if (currentUser != null && !string.IsNullOrWhiteSpace(currentUser.Name))
                    {
                        CurrentUserName = currentUser.Name;
                    }
                    else
                    {
                        CurrentUserName = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_useremail") ?? "Agent BothTech";
                    }
                }
                catch { CurrentUserName = "Agent BothTech"; }

                StateHasChanged();

                if (!string.IsNullOrEmpty(idToken))
                {
                    _ = Task.Run(async () =>
                    {
                        try { await DataSync.PushPendingOperationsAsync(idToken); }
                        catch (Exception syncEx) { Console.WriteLine($"[Synchro ignorée] {syncEx.Message}"); }
                    });
                }
            }
            catch (Microsoft.AspNetCore.Components.NavigationException)
            {
                throw;
            }
            catch (Exception ex)
            {
                Console.WriteLine("Erreur Init Vente B2B : " + ex.Message);
                await ShowToast("Erreur système : " + ex.Message);
            }
            finally
            {
                IsLoading = false;
                StateHasChanged();
            }
        }
    }

    private void LoadUserPermissionsLocal(string role)
    {
        try
        {
            var localRoles = DataSync.GetAllLocal<RoleConfig>();
            string cleanRole = (role ?? "").ToLower().Trim();
            var myRoleConfig = localRoles.FirstOrDefault(r => r.Id != null && r.Id.ToLower().Trim() == cleanRole);

            if (myRoleConfig != null && !string.IsNullOrEmpty(myRoleConfig.PermissionsJson))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var parsed = JsonSerializer.Deserialize<Dictionary<string, Dictionary<string, bool>>>(myRoleConfig.PermissionsJson, options);

                if (parsed != null && parsed.Count > 0)
                {
                    currentPermissions = new Dictionary<string, Dictionary<string, bool>>(StringComparer.OrdinalIgnoreCase);
                    foreach (var module in parsed)
                    {
                        var actionDict = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);
                        foreach (var action in module.Value)
                        {
                            actionDict[action.Key] = action.Value;
                        }
                        currentPermissions[module.Key] = actionDict;
                    }
                }
                else currentPermissions = new();
            }
            else currentPermissions = new();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erreur lecture permissions B2B : " + ex.Message);
            currentPermissions = new();
        }
    }

    private bool HasPerm(string module, string action)
    {
        if (isAdminOrMaintenance) return true;

        if (currentPermissions == null || currentPermissions.Count == 0)
        {
            string safeModule = module.ToLower();
            if ((userRole == "commercial" || userRole == "comptable" || userRole == "secretaire") && safeModule == "b2b") return true;
            return false;
        }

        if (currentPermissions.TryGetValue(module, out var actions) && actions.TryGetValue(action, out var allowed))
        {
            return allowed;
        }

        return false;
    }

    private void LoadLocalData()
    {
        try { _catalog = DataSync.GetAllLocal<Product>() ?? new List<Product>(); }
        catch { _catalog = new List<Product>(); }

        try { _b2bClients = (DataSync.GetAllLocal<UserB2BModel>() ?? new List<UserB2BModel>()).Where(u => u.Role == "detaillant" && u.Active).ToList(); }
        catch { _b2bClients = new List<UserB2BModel>(); }

        try { _historyOrders = (DataSync.GetAllLocal<OrderModel>() ?? new List<OrderModel>()).Where(o => o.Type == "b2b").ToList(); }
        catch { _historyOrders = new List<OrderModel>(); }

        try { CompanyInfos = DataSync.GetAllLocal<CompanySettings>().FirstOrDefault() ?? new CompanySettings(); }
        catch { CompanyInfos = new CompanySettings(); }
    }

    private void OpenNewSale()
    {
        if (!canAddB2B)
        {
            _ = ShowToast("❌ Vous n'avez pas l'autorisation d'ajouter une vente B2B.");
            return;
        }

        _clientSearchQuery = "";
        SelectedClient = null;
        AvanceValue = null;
        SalePaymentMethod = "espece";
        B2bLines.Clear();
        AddLine();
        IsFormView = true;
    }

    private void CloseNewSale() { IsFormView = false; }

    private void SelectClient(UserB2BModel client)
    {
        SelectedClient = client;
        _clientSearchQuery = client.Name ?? "Client Inconnu";
    }

    private void ResetClient()
    {
        SelectedClient = null;
        _clientSearchQuery = "";
    }

    private void AddLine() { B2bLines.Add(new B2bLineItem()); }

    private void OnProductSelected(B2bLineItem line, string productId)
    {
        line.ProductFirebaseId = productId;
        var p = _catalog.FirstOrDefault(x => x.Id == productId);
        if (p != null)
        {
            line.ProductName = p.Name ?? "Produit inconnu";
            line.UnitPrice = (p.PartnerPrice.HasValue && p.PartnerPrice > 0) ? p.PartnerPrice.Value : p.Price;
            line.MaxStock = p.Quantity;
            if (line.Quantity > line.MaxStock) line.Quantity = line.MaxStock;
        }
        else
        {
            line.UnitPrice = 0;
            line.MaxStock = 0;
        }
    }

    private void OnQuantityChanged(B2bLineItem line, object? value)
    {
        if (int.TryParse(value?.ToString(), out int qty))
        {
            line.Quantity = qty > line.MaxStock ? line.MaxStock : (qty < 1 ? 1 : qty);
        }
    }

    private async Task SubmitSale()
    {
        if (!canAddB2B)
        {
            await ShowToast("❌ Vous n'avez pas l'autorisation d'ajouter une vente.");
            return;
        }

        if (SelectedClient == null)
        {
            await ShowToast("⚠️ Veuillez rechercher et sélectionner un détaillant.");
            return;
        }

        var validLines = B2bLines.Where(l => !string.IsNullOrEmpty(l.ProductFirebaseId) && l.Quantity > 0).ToList();
        if (!validLines.Any())
        {
            await ShowToast("⚠️ Veuillez ajouter au moins un produit.");
            return;
        }

        IsProcessing = true;
        StateHasChanged();

        try
        {
            string orderId = "B2B-" + DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

            var order = new OrderModel
            {
                Id = orderId,
                Type = "b2b",
                UserId = SelectedClient.Id,
                ClientName = SelectedClient.Name,
                RecipientPhone = SelectedClient.Phone,
                RecipientAddress = SelectedClient.Address,
                Total = SubTotal,
                Avance = _avanceValue ?? SubTotal,
                Reste = ResteAPayer,
                PaymentMethod = SalePaymentMethod,
                CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
                Status = ResteAPayer > 0 ? "partiel" : "payee",
                Items = validLines.Select(l => new OrderItem
                {
                    ProductFirebaseId = l.ProductFirebaseId,
                    ProductName = l.ProductName,
                    UnitPrice = l.UnitPrice,
                    Quantity = l.Quantity
                }).ToList()
            };

            DataSync.SaveLocal(order);
            DataSync.EnqueueOperation("OrderModel", orderId, "CREATE", order);
            _historyOrders.Insert(0, order);

            foreach (var line in validLines)
            {
                var movement = new StockMovement
                {
                    MovementId = Guid.NewGuid().ToString("N"),
                    ProductId = line.ProductFirebaseId,
                    QuantityChange = -line.Quantity,
                    MovementType = "SALE_B2B",
                    OrderId = orderId,
                    AgentId = CurrentUserId,
                    Date = DateTime.UtcNow
                };

                DataSync.SaveLocal(movement);
                DataSync.EnqueueOperation("StockMovement", movement.MovementId, "CREATE", movement);

                var localProduct = _catalog.FirstOrDefault(x => x.Id == line.ProductFirebaseId);
                if (localProduct != null)
                {
                    localProduct.Quantity -= line.Quantity;
                    DataSync.SaveLocal(localProduct);
                }
            }

            _ = DataSync.PushPendingOperationsAsync(idToken);

            await ShowToast("✅ Vente B2B enregistrée et stock déduit !");
            
            await PrintInvoice(order);
            
            IsFormView = false;
        }
        catch (Exception ex)
        {
            await ShowToast("❌ Erreur de sauvegarde : " + ex.Message);
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task PrintInvoice(OrderModel order)
    {
        InvoiceToPrint = order;
        StateHasChanged(); 
        await Task.Delay(300); // Laisse au navigateur le temps d'appliquer les CSS
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private string FormatMoney(double? amountNullable)
    {
        double amount = amountNullable ?? 0;
        var nfi = (NumberFormatInfo)CultureInfo.GetCultureInfo("fr-FR").NumberFormat.Clone();
        nfi.NumberGroupSeparator = " ";
        return amount.ToString("N0", nfi) + " FCFA";
    }

    private string FormatDate(long timestamp)
    {
        try { return DateTimeOffset.FromUnixTimeMilliseconds(timestamp).LocalDateTime.ToString("dd/MM/yyyy à HH:mm"); }
        catch { return "-"; }
    }
    
    private string FormatPaymentMethod(string? method)
    {
        return method switch
        {
            "espece" => "Espèces",
            "mobile_money" => "Mobile Money",
            "virement" => "Virement Bancaire",
            _ => "Espèces"
        };
    }

    private async Task ShowToast(string message)
    {
        ToastMessage = message;
        StateHasChanged();
        await Task.Delay(3000);
        ToastMessage = "";
        StateHasChanged();
    }

    private string ConvertAmountToWords(double? amount)
    {
        if (!amount.HasValue || amount.Value == 0) return "ZÉRO";
        long val = (long)Math.Floor(amount.Value);
        return NumberToWords(val);
    }

    private static string NumberToWords(long number)
    {
        if (number == 0) return "zéro";
        if (number < 0) return "moins " + NumberToWords(Math.Abs(number));

        string words = "";
        if ((number / 1000000) > 0)
        {
            words += NumberToWords(number / 1000000) + " million ";
            number %= 1000000;
        }
        if ((number / 1000) > 0)
        {
            if (number / 1000 == 1) words += "mille ";
            else words += NumberToWords(number / 1000) + " mille ";
            number %= 1000;
        }
        if ((number / 100) > 0)
        {
            if (number / 100 == 1) words += "cent ";
            else words += NumberToWords(number / 100) + " cent ";
            number %= 100;
        }
        if (number > 0)
        {
            if (words != "") words += "";
            var unitsMap = new[] { "zéro", "un", "deux", "trois", "quatre", "cinq", "six", "sept", "huit", "neuf", "dix", "onze", "douze", "treize", "quatorze", "quinze", "seize", "dix-sept", "dix-huit", "dix-neuf" };
            var tensMap = new[] { "zéro", "dix", "vingt", "trente", "quarante", "cinquante", "soixante", "soixante-dix", "quatre-vingt", "quatre-vingt-dix" };

            if (number < 20) words += unitsMap[number];
            else
            {
                words += tensMap[number / 10];
                if ((number % 10) > 0) words += "-" + unitsMap[number % 10];
            }
        }
        return words.Trim();
    }
}