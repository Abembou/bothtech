    /* Formatage de la date à partir d'un timestamp UNIX (NOUVEAU) */
    private string FormatDate(long timestamp)
    {
        try
        {
            return DateTimeOffset.FromUnixTimeMilliseconds(timestamp).LocalDateTime.ToString("dd/MM/yyyy HH:mm");
        }
        catch
        {
            return "";
        }
    }

    private string EncryptMessage(string plainText) { if (string.IsNullOrEmpty(plainText)) return ""; using Aes aes = Aes.Create(); aes.Key = encryptionKey; aes.IV = encryptionIv; ICryptoTransform encryptor = aes.CreateEncryptor(aes.Key, aes.IV); using MemoryStream ms = new MemoryStream(); using CryptoStream cs = new CryptoStream(ms, encryptor, CryptoStreamMode.Write); using (StreamWriter sw = new StreamWriter(cs)) { sw.Write(plainText); } return Convert.ToBase64String(ms.ToArray()); }
    private string DecryptMessage(string cipherText) { if (string.IsNullOrEmpty(cipherText)) return ""; try { using Aes aes = Aes.Create(); aes.Key = encryptionKey; aes.IV = encryptionIv; ICryptoTransform decryptor = aes.CreateDecryptor(aes.Key, aes.IV); using MemoryStream ms = new MemoryStream(Convert.FromBase64String(cipherText)); using CryptoStream cs = new CryptoStream(ms, decryptor, CryptoStreamMode.Read); using StreamReader sr = new StreamReader(cs); return sr.ReadToEnd(); } catch { return "Erreur de déchiffrement"; } }

    private async Task HandleGoogleLogin() { try { authErrorMessage = "Connexion Google..."; StateHasChanged(); await AuthService.LoginWithGoogleAsync(); string userRole = "client"; await DataSync.PullProductsFromFirebaseAsync(); isAuthOpen = false; } catch (Exception ex) { authErrorMessage = ex.Message; StateHasChanged(); } }
    private async Task HandleAuth0Login() { try { authErrorMessage = "Connexion Auth0..."; StateHasChanged(); await AuthService.LoginWithAuth0Async(); string userRole = "client"; await DataSync.PullProductsFromFirebaseAsync(); isAuthOpen = false; } catch (Exception ex) { authErrorMessage = ex.Message; StateHasChanged(); } }

    private async Task HandleFileUpload(InputFileChangeEventArgs e) { var file = e.File; if (file != null) { selectedFileName = file.Name; try { using var ms = new MemoryStream(); await file.OpenReadStream(15000000).CopyToAsync(ms); selectedFileUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}"; } catch { selectedFileName = "Erreur fichier"; } StateHasChanged(); } }
    private void RemoveAttachment() { selectedFileName = ""; selectedFileUrl = ""; }

    private async Task StartRecording() { try { chatMessage = "Initialisation..."; StateHasChanged(); bool success = await JSRuntime.InvokeAsync<bool>("audioChat.startRecording"); if (success) { isRecording = true; recordingSeconds = 0; chatMessage = ""; recordingTimer = new System.Threading.Timer((_) => { recordingSeconds++; InvokeAsync(StateHasChanged); }, null, 1000, 1000); } else { chatMessage = "⚠ Micro refusé."; } } catch (Exception ex) { chatMessage = $"⚠️ Erreur: {ex.Message}"; } StateHasChanged(); }
    private async Task CancelRecording() { isRecording = false; recordingTimer?.Dispose(); recordingSeconds = 0; try { await JSRuntime.InvokeVoidAsync("audioChat.cancelRecording"); } catch { } StateHasChanged(); }
    private void SetVoiceInfoMessage() => chatMessage = "Le chat vocal est sur mobile.";

    private async Task TogglePlayAudio(ChatMessageItem msg) { if (msg.IsPlaying) { msg.IsPlaying = false; msg.PlaybackTimer?.Dispose(); } else { msg.IsPlaying = true; if (msg.AudioProgress >= 100) msg.AudioProgress = 0; try { if (!string.IsNullOrEmpty(msg.AttachmentDataUrl)) await JSRuntime.InvokeVoidAsync("audioChat.playAudio", msg.AttachmentDataUrl); } catch { } int step = 100 / (msg.AudioDuration > 0 ? msg.AudioDuration : 1); msg.PlaybackTimer = new System.Threading.Timer((_) => { msg.AudioProgress += step; if (msg.AudioProgress >= 100) { msg.AudioProgress = 100; msg.IsPlaying = false; msg.PlaybackTimer?.Dispose(); } InvokeAsync(StateHasChanged); }, null, 1000, 1000); } }
    private async Task ScrollChatToBottom() { try { await Task.Delay(100); await JSRuntime.InvokeVoidAsync("eval", "var c = document.getElementById('clientChatContainer'); if(c) c.scrollTop = c.scrollHeight;"); } catch { } }

    private async Task LancerAppelUssd(string rawUssd)
    {
        try
        {
            string encodedUssd = rawUssd.Replace("*", "%2A").Replace("#", "%23");

#if ANDROID || IOS || MACCATALYST || WINDOWS
            await Microsoft.Maui.ApplicationModel.Launcher.Default.OpenAsync(new Uri($"tel:{encodedUssd}"));
#else
            await JSRuntime.InvokeVoidAsync("open", $"tel:{encodedUssd}", "_self");
#endif
        }
        catch { await JSRuntime.InvokeVoidAsync("alert", "Composez le code manuellement."); }
    }

    public void Dispose() { CartService.OnCartChanged -= StateHasChanged; AuthStateProvider.AuthenticationStateChanged -= HandleAuthStateChanged; recordingTimer?.Dispose(); foreach (var msg in chatHistory) msg.PlaybackTimer?.Dispose(); try { if (!_chatCts.IsCancellationRequested) { _chatCts.Cancel(); } } catch { } _chatCts.Dispose(); }
