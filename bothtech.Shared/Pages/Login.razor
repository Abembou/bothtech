@page "/login"
@using bothtech.Shared.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Connexion - Both Tech</PageTitle>

<div class="login-container" style="max-width: 400px; margin: 80px auto; padding: 30px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); background-color: white; text-align: center;">
    <h2 style="margin-bottom: 25px;">Connexion</h2>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div style="color: white; background-color: #e74c3c; padding: 10px; border-radius: 5px; margin-bottom: 15px;">
            @_errorMessage
        </div>
    }

    <!-- Boutons de connexion externe (Google / Auth0) -->
    <div style="display: flex; flex-direction: column; gap: 15px; margin-bottom: 25px;">

        <!-- Bouton Google -->
        <!-- Bouton Google -->
        <button type="button" class="btn" @onclick="HandleGoogleLogin" style="...">
            <img src="https://www.google.com/favicon.ico" alt="Google" width="20" height="20" />
            Continuer avec Google
        </button>

        <!-- Bouton Auth0 -->
        <button type="button" class="btn" @onclick="HandleAuth0Login" style="...">
            <img src="https://cdn.auth0.com/website/bob/up/apple-touch-icon-black.png" alt="Auth0" width="20" height="20" style="filter: brightness(0) invert(1);" />
            Continuer avec Auth0
        </button>
    </div>

    <div style="display: flex; align-items: center; margin-bottom: 25px;">
        <hr style="flex: 1; border: none; border-top: 1px solid #ddd;" />
        <span style="padding: 0 10px; color: #888; font-size: 0.9em;">OU</span>
        <hr style="flex: 1; border: none; border-top: 1px solid #ddd;" />
    </div>

    <!-- Formulaire Email/Mot de passe classique -->
    <div style="margin-bottom: 15px;">
        <input type="email" @bind="_email" placeholder="Adresse email" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" />
    </div>
    <div style="margin-bottom: 20px;">
        <input type="password" @bind="_password" placeholder="Mot de passe" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" />
    </div>

    <button class="btn btn-primary" @onclick="HandleEmailLogin" disabled="@_isLoading" style="width: 100%; padding: 10px; font-weight: bold; border-radius: 5px; border: none; background-color: #007bff; color: white; cursor: pointer;">
        @if (_isLoading)
        {
            <span>Connexion en cours...</span>
        }
        else
        {
            <span>Se connecter</span>
        }
    </button>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string _errorMessage = "";
    private bool _isLoading = false;

    private async Task HandleEmailLogin()
    {
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _errorMessage = "Veuillez remplir tous les champs.";
            return;
        }

        _isLoading = true;
        _errorMessage = "";

        try
        {
            bool success = await AuthService.LoginAsync(_email, _password);
            if (success) NavigationManager.NavigateTo("/");
            else _errorMessage = "Identifiants incorrects.";
        }
        catch (Exception)
        {
            _errorMessage = "Une erreur est survenue.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleGoogleLogin()
    {
        _isLoading = true;
        _errorMessage = "";
        try
        {
            await AuthService.LoginWithGoogleAsync();
            // L'application sera redirigée vers Google, on ne force pas la navigation ici
        }
        catch (Exception)
        {
            _errorMessage = "Erreur de connexion avec Google.";
            _isLoading = false;
        }
    }

    private async Task HandleAuth0Login()
    {
        _isLoading = true;
        _errorMessage = "";
        try
        {
            await AuthService.LoginWithAuth0Async();
            // L'application sera redirigée vers Auth0
        }
        catch (Exception)
        {
            _errorMessage = "Erreur de connexion avec Auth0.";
            _isLoading = false;
        }
    }
}