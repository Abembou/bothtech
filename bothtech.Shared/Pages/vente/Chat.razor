        var msg = new { senderId = currentAdminUid, senderName = currentAdminName, text = EncryptMessage(text), timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(), isAudio = false };

        if (!localChats.ContainsKey(selectedClientId)) localChats[selectedClientId] = new ChatSession { Messages = new() };
