@page "/admin/accords"
@layout bothtech.Shared.Layout.AdminLayout
@using bothtech.Shared.Models
@using System.Globalization

<PageTitle>Accords & Validations | Console Admin</PageTitle>

<!-- ONGLETS UNIFIÉS -->
<div class="accord-tabs" style="display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 2px solid var(--border); padding-bottom: 10px; flex-wrap: wrap;">
    <button class="accord-tab-btn @(ActiveTab == "accords" ? "active" : "")" @onclick='() => ActiveTab = "accords"'>Opérations & Accords</button>
    <button class="accord-tab-btn @(ActiveTab == "prets" ? "active" : "")" style="@(ActiveTab == "prets" ? "background: var(--warning); color: white;" : "color: var(--warning);")" @onclick='() => ActiveTab = "prets"'>Validation Prêts</button>
    <button class="accord-tab-btn @(ActiveTab == "roles" ? "active" : "")" style="@(ActiveTab == "roles" ? "background: #9333ea; color: white;" : "")" @onclick='() => ActiveTab = "roles"'>Matrice des Rôles</button>
</div>

<!-- Avertissement de sécurité global -->
<div style="background: var(--danger-subtle); color: var(--danger); border: 1px solid var(--danger); padding: 15px; border-radius: 8px; margin-bottom: 20px;">
    <strong>🔒 Espace Hautement Sécurisé</strong><br>
    Cette page est exclusivement réservée à l'Administrateur Général ou à la Maintenance. Toute action validée ici est définitive et engage la responsabilité de la Direction.
</div>

@if (ActiveTab == "accords")
{
    <!-- TAB 1 : CONFIGURATION MESSAGES WHATSAPP -->
    <section class="card" style="margin-top: 20px;">
        <div class="card-header"><h2 class="card-title">Messages & Contacts (Boutique)</h2></div>
        <div class="card-body">
            <div style="background: #eff6ff; padding: 15px; border-radius: 8px; margin-bottom: 15px; font-size: 0.85rem; color: #1d4ed8; border: 1px solid #bfdbfe;">
                💡 <b>Astuce :</b> Utilisez le mot-clé <code>{company}</code> dans le texte. Le système le remplacera automatiquement par le vrai nom de votre entreprise lors de l'envoi au client.
            </div>
            <EditForm Model="Settings" OnValidSubmit="SaveSettings">
                <div class="form-group" style="margin-bottom: 20px; background: #f8fafc; padding: 15px; border-radius: 8px; border: 1px solid var(--border);">
                    <label style="color: #0f172a; font-weight: bold;">Numéro WhatsApp de Réception des Commandes *</label>
                    <InputText @bind-Value="Settings.WhatsappContact" class="form-control" required placeholder="Ex: 22670000000 (Sans le '+')" />
                </div>
                <div class="form-group" style="margin-bottom: 15px;">
                    <label>Message de bienvenue (Client standard) *</label>
                    <InputTextArea @bind-Value="Settings.WelcomeClient" class="form-control" rows="4" required />
                </div>
                <div class="form-group" style="margin-bottom: 15px;">
                    <label>Message de bienvenue (Partenaire B2B) *</label>
                    <InputTextArea @bind-Value="Settings.WelcomeB2B" class="form-control" rows="4" required />
                </div>
                <button type="submit" disabled="@IsProcessing" class="btn btn-primary" style="width: 100%; padding: 14px; font-size: 1.05rem; font-weight:bold; cursor:pointer;">
                    @(IsProcessing ? "Sauvegarde en cours..." : "💾 Enregistrer les Configurations")
                </button>
            </EditForm>
        </div>
    </section>
}
else if (ActiveTab == "prets")
{
    <!-- TAB 2 : VALIDATION DES PRÊTS -->
    <section class="card">
        <div class="card-header"><h2 class="card-title">Avances & Prêts en attente</h2></div>
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Date / Réf</th>
                        <th>Employé</th>
                        <th class="hide-mobile">Montant demandé</th>
                        <th class="hide-mobile">Motif</th>
                        <th style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!PendingLoans.Any())
                    {
                        <tr><td colspan="5" style="text-align:center; padding:30px; color:var(--success); font-weight:bold;">Aucun prêt en attente de validation.</td></tr>
                    }
                    else
                    {
                        @foreach (var pret in PendingLoans)
                        {
                            <tr>
                                <td>
                                    @FormatDate(pret.CreatedAt)<br>
                                    <small style="color:#64748b;">#@pret.FirebaseId?.Substring(0, 6).ToUpper()</small>
                                </td>
                                <td>
                                    <strong>@pret.AgentName</strong><br>

                                    <div class="mobile-only-display" style="margin-top:4px; font-size:0.85rem; border-top:1px dashed var(--border); padding-top:4px;">
                                        <b style="color:var(--danger);">@FormatMoney(pret.MontantInitial)</b><br>
                                        <span style="color:var(--text-muted);">@(string.IsNullOrEmpty(pret.Motif) ? "Non précisé" : pret.Motif)</span>
                                    </div>
                                </td>
                                <td class="hide-mobile" style="color:var(--danger); font-weight:bold;">@FormatMoney(pret.MontantInitial)</td>
                                <td class="hide-mobile">@(string.IsNullOrEmpty(pret.Motif) ? "Non précisé" : pret.Motif)</td>
                                <td style="text-align: right; min-width: 120px;">
                                    <button class="btn btn-outline" style="color:var(--success); border-color:var(--success); margin-bottom:4px; width:100%; cursor:pointer;" @onclick="() => ProcessLoan(pret, true)">✅ Accepter</button>
                                    <button class="btn btn-outline" style="color:var(--danger); border-color:var(--danger-subtle); width:100%; cursor:pointer;" @onclick="() => ProcessLoan(pret, false)">❌ Rejeter</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
}
else if (ActiveTab == "roles")
{
    <!-- TAB 3 : MATRICE DES RÔLES -->
    <section class="card">
        <div class="card-header" style="display:flex; justify-content:space-between; align-items:center;">
            <h2 class="card-title">Permissions du système</h2>
            <button class="btn btn-primary" disabled="@IsProcessing" style="background:#9333ea; border-color:#9333ea;" @onclick="SaveRolesMatrix">
                @(IsProcessing ? "Sauvegarde..." : "💾 Sauvegarder la Matrice")
            </button>
        </div>

        <div style="padding: 15px; background: #f3e8ff; color: #6b21a8; font-size: 0.85rem; border-bottom: 1px solid var(--border);">
            Cochez les cases pour autoriser un rôle à accéder ou modifier un module spécifique. <b>Attention : Les rôles "Admin" et "Maintenance" ont tous les droits par défaut et ne peuvent pas être restreints ici.</b>
        </div>

        <div class="table-responsive" style="max-height: 65vh; overflow: auto;">
            <table class="custom-table" style="font-size: 0.85rem;">
                <thead>
                    <tr>
                        <th style="background: #f8fafc; position: sticky; left: 0; z-index: 11;">Module \ Rôle</th>
                        @foreach (var role in RolesList)
                        {
                            <th style="background: #f8fafc; text-transform: capitalize; text-align: center;">@role</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var module in ModulesDef)
                    {
                        <tr style="background:#f1f5f9;">
                            <td colspan="@(RolesList.Count + 1)" style="text-align:left; font-weight:bold; color:var(--primary); padding-top:15px;">
                                @module.Label
                            </td>
                        </tr>
                        @foreach (var action in module.Actions)
                        {
                            <tr>
                                <td style="text-align: left; font-weight: bold; background: #fff; position: sticky; left: 0; z-index: 5;">
                                    Droit de <span style="text-transform:capitalize;">@action</span>
                                </td>
                                @foreach (var role in RolesList)
                                {
                                    <td style="text-align: center;">
                                        <!-- BINDING BIDIRECTIONNEL DIRECT SUR LE DICTIONNAIRE -->
                                        <input type="checkbox" style="width: 18px; height: 18px; cursor: pointer; accent-color: var(--primary);"
                                               checked="@IsPermissionGranted(role, module.Id, action)"
                                               @onchange="@(e => TogglePermission(role, module.Id, action, e.Value))" />
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div id="toast" style="display:block;">@ToastMessage</div>
}

@code {
    private string ActiveTab = "accords";
    private bool IsProcessing = false;
    private string ToastMessage = "";

    // --- TAB 1 : ACCORDS ---
    public class AccordsSettings
    {
        public string WhatsappContact { get; set; } = "22670000000";
        public string WelcomeClient { get; set; } = "👋 **Bienvenue chez {company} !**\n\nNous avons bien reçu votre sélection d'articles. Un conseiller va vous répondre dans quelques instants pour discuter de votre devis.";
        public string WelcomeB2B { get; set; } = "👋 **Espace Partenaire**\n\nVotre commande B2B a bien été transmise à l'administration de **{company}**. Un conseiller va traiter votre demande de réapprovisionnement.";
    }
    private AccordsSettings Settings = new();

    // --- TAB 2 : PRÊTS ---
    private List<Loan> _allLoans = new();
    private IEnumerable<Loan> PendingLoans => _allLoans.Where(l => l.Status == "en_attente_validation" || l.Status == "en_attente").OrderByDescending(l => l.CreatedAt);

    // --- TAB 3 : MATRICE DES RÔLES ---
    private List<string> RolesList = new() { "commercial", "secretaire", "comptable", "rh", "livreur", "chauffeur", "gardien", "partenaire" };

    public class ModuleDefinition
    {
        public string Id { get; set; }
        public string Label { get; set; }
        public List<string> Actions { get; set; }
    }

    private List<ModuleDefinition> ModulesDef = new()
    {
        new ModuleDefinition { Id = "produits", Label = "📦 Stocks & Produits", Actions = new() { "lecture", "ajouter", "modifier", "supprimer" } },
        new ModuleDefinition { Id = "commandes", Label = "🛒 Commandes Ligne", Actions = new() { "lecture", "modifier" } },
        new ModuleDefinition { Id = "comptoir", Label = "🏪 Vente Comptoir", Actions = new() { "lecture", "ajouter" } },
        new ModuleDefinition { Id = "b2b", Label = "🤝 Vente B2B", Actions = new() { "lecture", "ajouter" } },
        new ModuleDefinition { Id = "comptabilite", Label = "💰 Comptabilité & Caisse", Actions = new() { "lecture", "ajouter", "supprimer" } },
        new ModuleDefinition { Id = "equipe", Label = "👥 Ressources Humaines", Actions = new() { "lecture", "ajouter", "modifier", "supprimer" } },
        new ModuleDefinition { Id = "avis", Label = "⭐ Avis Clients", Actions = new() { "lecture", "supprimer" } },
        new ModuleDefinition { Id = "messages", Label = "💬 Chat Clients", Actions = new() { "lecture", "modifier" } }
    };

    // Dictionnaire tridimensionnel : [Role][Module][Action] = bool
    private Dictionary<string, Dictionary<string, Dictionary<string, bool>>> RolesMatrixData = new();

    protected override async Task OnInitializedAsync()
    {
        // Initialisation de la matrice à faux par défaut
        foreach (var role in RolesList)
        {
            RolesMatrixData[role] = new();
            foreach (var mod in ModulesDef)
            {
                RolesMatrixData[role][mod.Id] = new();
                foreach (var action in mod.Actions)
                {
                    RolesMatrixData[role][mod.Id][action] = false;
                }
            }
        }

        // Simulation réseau
        await Task.Delay(300);

        // Simulation d'un prêt en attente
        _allLoans.Add(new Loan { FirebaseId = "-Pabc", AgentName = "Ouedraogo Ali", MontantInitial = 25000, Status = "en_attente", CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() });
    }

    // --- LOGIQUE TAB 1 ---
    private async Task SaveSettings()
    {
        IsProcessing = true;
        await Task.Delay(500); // Save to DB
        IsProcessing = false;
        await ShowToast("✅ Configurations mises à jour avec succès !");
    }

    // --- LOGIQUE TAB 2 ---
    private async Task ProcessLoan(Loan loan, bool isAccepted)
    {
        string textAction = isAccepted ? "ACCEPTER" : "REJETER";
        // En Blazor, on utilise souvent des modals personnalisés, mais on peut simuler l'action ici
        loan.Status = isAccepted ? "valide_admin" : "rejete";
        await ShowToast($"Demande {(isAccepted ? "acceptée" : "rejetée")} avec succès.");
    }

    // --- LOGIQUE TAB 3 ---
    private bool IsPermissionGranted(string role, string moduleId, string action)
    {
        if (RolesMatrixData.ContainsKey(role) && RolesMatrixData[role].ContainsKey(moduleId) && RolesMatrixData[role][moduleId].ContainsKey(action))
        {
            return RolesMatrixData[role][moduleId][action];
        }
        return false;
    }

    private void TogglePermission(string role, string moduleId, string action, object isChecked)
    {
        if (isChecked is bool checkValue)
        {
            RolesMatrixData[role][moduleId][action] = checkValue;
        }
    }

    private async Task SaveRolesMatrix()
    {
        IsProcessing = true;
        // On enverrait `RolesMatrixData` à Firebase ici
        await Task.Delay(500);
        IsProcessing = false;
        await ShowToast("✅ Matrice des rôles mise à jour !");
    }

    // --- UTILITAIRES ---
    private string FormatMoney(double amount)
    {
        var nfi = (NumberFormatInfo)CultureInfo.GetCultureInfo("fr-FR").NumberFormat.Clone();
        nfi.NumberGroupSeparator = " ";
        return amount.ToString("N0", nfi) + " FCFA";
    }

    private string FormatDate(long timestamp)
    {
        return DateTimeOffset.FromUnixTimeMilliseconds(timestamp).LocalDateTime.ToString("dd/MM/yyyy");
    }

    private async Task ShowToast(string message)
    {
        ToastMessage = message;
        StateHasChanged();
        await Task.Delay(3000);
        ToastMessage = "";
        StateHasChanged();
    }
}