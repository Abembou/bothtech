@page "/admin/commandes"
@layout bothtech.Shared.Layout.AdminLayout
@using bothtech.Shared.Models
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Commandes en ligne | Console Admin</PageTitle>

<!-- MENU DES ONGLETS DE VENTE -->
<div class="ventes-tabs" style="padding: 0 15px;">
    <button class="ventes-tab-btn active">
        📋 Commandes 
        @if (NewOrdersCount > 0)
        {
            <span class="tab-badge" style="display:inline-block;">@NewOrdersCount</span>
        }
    </button>
    <NavLink class="ventes-tab-btn" href="/admin/ventes-comptoir" style="text-decoration:none;">🛒 Comptoir</NavLink>
    <NavLink class="ventes-tab-btn" href="/admin/ventes-b2b" style="text-decoration:none;">🏢 B2B (Gros)</NavLink>
</div>

<div style="padding: 0 15px 20px 15px;">
    <section class="card">
        <div class="card-header">
            <h2 class="card-title" style="margin: 0; font-size: 1.2rem;">Tickets & Ventes en ligne</h2>
            
            <!-- Le @bind="StatusFilter" déclenche le rafraîchissement automatique de la liste -->
            <select class="form-control" @bind="StatusFilter">
                <option value="all">Toutes les commandes</option>
                <option value="nouveau">Nouvelles (Devis)</option>
                <option value="en_cours">En Discussion</option>
                <option value="validee">Conclue (À livrer)</option>
                <option value="livree">Livrée</option>
                <option value="annulee">Vente Annulée</option>
            </select>
        </div>
        
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th class="hide-mobile">Date</th>
                        <th>Client</th>
                        <th class="hide-mobile">Articles</th>
                        <th class="hide-mobile">Total</th>
                        <th class="hide-mobile" style="text-align: center;">Statut</th>
                        <th style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (IsLoading)
                    {
                        <tr><td colspan="6" style="text-align: center; padding: 20px;">Chargement...</td></tr>
                    }
                    else if (!FilteredOrders.Any())
                    {
                        <tr><td colspan="6" style="text-align: center; padding: 20px; color:var(--text-muted);">Aucune commande en ligne trouvée.</td></tr>
                    }
                    else
                    {
                        @foreach (var order in FilteredOrders)
                        {
                            <tr>
                                <td class="hide-mobile"><small>@FormatDate(order.CreatedAt)</small></td>
                                <td>
                                    <b>@(string.IsNullOrEmpty(order.ClientName) ? order.RecipientName : order.ClientName)</b>
                                    
                                    <!-- Affichage Mobile -->
                                    <div class="mobile-only-display" style="margin-top:8px; font-size:0.85rem; line-height: 1.5; border-top:1px dashed var(--border); padding-top:8px;">
                                        <span style="color:var(--text-muted);">🕒 @FormatDate(order.CreatedAt)</span><br>
                                        <b>@FormatMoney(order.Total)</b><br>
                                        @((MarkupString)GetStatusBadge(order.Status))
                                    </div>
                                </td>
                                <td class="hide-mobile"><small>@((MarkupString)GetItemsHtml(order.Items))</small></td>
                                <td class="hide-mobile"><b>@FormatMoney(order.Total)</b></td>
                                <td class="hide-mobile" style="text-align:center;">
                                    @((MarkupString)GetStatusBadge(order.Status))
                                </td>
                                <td style="text-align:right; vertical-align:middle;">
                                    <div class="action-buttons-container">
                                        
                                        <!-- CORRECTION : Ajout de Context="authState" -->
                                        <AuthorizeView Roles="admin, maintenance, commercial" Context="authState">
                                            <Authorized>
                                                @if (string.IsNullOrEmpty(order.TraitePar))
                                                {
                                                    <button class="btn btn-primary btn-action" @onclick="() => TakeCharge(order)">✋ Prendre</button>
                                                }
                                                // CORRECTION : Remplacement de context.User par authState.User
                                                else if (order.TraitePar == CurrentUserName || authState.User.IsInRole("admin") || authState.User.IsInRole("maintenance"))
                                                {
                                                    <span style="font-size:0.75rem; color:var(--primary); font-weight:bold; text-align:center;">👤 @(order.TraitePar == CurrentUserName ? "Moi" : order.TraitePar)</span>
                                                    <button class="btn btn-outline btn-action" @onclick="() => OpenChat(order.ClientId)">💬 Ouvrir discussion</button>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning" style="text-align:center; padding: 6px;">🔒 En cours par<br>@order.TraitePar</span>
                                                }
                                            </Authorized>
                                            <NotAuthorized>
                                                <span class="badge badge-warning">Lecture seule</span>
                                            </NotAuthorized>
                                        </AuthorizeView>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div id="toast" style="display:block;">@ToastMessage</div>
}

@code {
    private bool IsLoading = true;
    private List<Order> _allOrders = new();
    private string _statusFilter = "all";
    private string ToastMessage = "";
    
    // Le nom de l'utilisateur connecté sera récupéré via l'AuthService plus tard
    private string CurrentUserName = "Dodoyéo Issouf"; 

    // Propriété liée au menu déroulant. Quand elle change, l'interface se rafraîchit.
    private string StatusFilter
    {
        get => _statusFilter;
        set { _statusFilter = value; }
    }

    private int NewOrdersCount => _allOrders.Count(o => o.Status == "nouveau");

    // Filtrage des commandes en temps réel avec LINQ
    private IEnumerable<Order> FilteredOrders => _allOrders
        .Where(o => o.Type != "comptoir" && o.Type != "b2b") // Exclut les ventes locales/gros
        .Where(o => StatusFilter == "all" || o.Status == StatusFilter)
        .OrderByDescending(o => o.CreatedAt);

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500); // Simulation réseau

        // Simulation de données
        _allOrders = new List<Order>
        {
            new Order { 
                FirebaseId = "-P123", 
                ClientId = "uid_client_1",
                ClientName = "Abembou Issouf", 
                Total = 250000, 
                Status = "nouveau", 
                Type = "en_ligne",
                CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
                Items = new List<OrderItem> { new OrderItem { ProductName = "Dell XPS 13", Quantity = 1 } }
            }
        };

        IsLoading = false;
    }

    private async Task TakeCharge(Order order)
    {
        order.TraitePar = CurrentUserName;
        order.Status = "en_cours";
        await ShowToast("Vous avez pris en charge cette commande.");
    }

    private void OpenChat(string clientId)
    {
        // Dans l'application complète, on utilise NavigationManager pour changer de page
        // NavigationManager.NavigateTo($"/admin/chat?uid={clientId}");
    }

    private string FormatMoney(int amount)
    {
        var nfi = (NumberFormatInfo)CultureInfo.GetCultureInfo("fr-FR").NumberFormat.Clone();
        nfi.NumberGroupSeparator = " ";
        return amount.ToString("N0", nfi) + " FCFA";
    }

    private string FormatDate(long timestamp)
    {
        return DateTimeOffset.FromUnixTimeMilliseconds(timestamp).LocalDateTime.ToString("dd/MM/yyyy HH:mm");
    }

    private string GetItemsHtml(List<OrderItem> items)
    {
        if (items == null || !items.Any()) return "";
        return string.Join("<br>", items.Select(i => $"{i.Quantity}x {i.ProductName}"));
    }

    private string GetStatusBadge(string status)
    {
        return status switch
        {
            "validee" => "<span class=\"badge badge-primary\">À livrer</span>",
            "livree" => "<span class=\"badge badge-success\">Livrée</span>",
            "annulee" => "<span class=\"badge badge-danger\">Annulée</span>",
            "nouveau" => "<span class=\"badge badge-purple\">Nouveau Devis</span>",
            "en_cours" => "<span class=\"badge badge-info\">En discussion</span>",
            _ => $"<span class=\"badge badge-info\">{status}</span>"
        };
    }

    private async Task ShowToast(string message)
    {
        ToastMessage = message;
        StateHasChanged();
        await Task.Delay(3000);
        ToastMessage = "";
        StateHasChanged();
    }
}