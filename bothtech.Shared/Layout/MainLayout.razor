    private async Task HandleForgotPassword()
    {
        if (string.IsNullOrWhiteSpace(forgotPasswordEmail))
        {
            _isResetSuccess = false;
            authErrorMessage = "Veuillez entrer votre adresse email.";
            return;
        }

        _isSendingReset = true;
        authErrorMessage = "";
        StateHasChanged();

        try
        {
            // Vérification locale pour s'assurer que c'est bien un agent
            var staffExists = DataSync.GetAllLocal<StaffModel>()
                                      .Any(s => s.Email != null && s.Email.ToLower() == forgotPasswordEmail.ToLower());

            if (!staffExists)
            {
                _isResetSuccess = false;
                authErrorMessage = "Aucun agent ne correspond à cette adresse email.";
                _isSendingReset = false;
                StateHasChanged();
                return;
            }

            // Appel de la fonction JS de réinitialisation Firebase
            await JSRuntime.InvokeVoidAsync("window.sendPasswordReset", forgotPasswordEmail);

            _isResetSuccess = true;
            authErrorMessage = "Un email de réinitialisation vous a été envoyé. Veuillez vérifier votre boîte de réception.";
        }
        catch (Exception ex)
        {
            _isResetSuccess = false;
            // Traduction des erreurs fréquentes de Firebase
            if (ex.Message.Contains("user-not-found"))
            {
                authErrorMessage = "Compte introuvable dans le système d'authentification en ligne.";
            }
            else if (ex.Message.Contains("network-request-failed"))
            {
                authErrorMessage = "Erreur réseau. Vérifiez votre connexion internet pour effectuer cette action.";
            }
            else
            {
                authErrorMessage = $"Une erreur est survenue : {ex.Message}";
            }
        }
        finally
        {
            _isSendingReset = false;
            StateHasChanged();
        }
    }

    private void LoadUserPermissionsLocal(string role)
    {
        try
        {
            var localRoles = DataSync.GetAllLocal<RoleConfig>();
            string cleanRole = (role ?? "").ToLower().Trim();
            var myRoleConfig = localRoles.FirstOrDefault(r => r.Id != null && r.Id.ToLower().Trim() == cleanRole);

            if (myRoleConfig != null && !string.IsNullOrEmpty(myRoleConfig.PermissionsJson))
            {
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var parsed = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, Dictionary<string, bool>>>(myRoleConfig.PermissionsJson, options);

                if (parsed != null && parsed.Count > 0)
                {
                    // Reconstruction pour ignorer la casse des clés (ex: "Produits" == "produits")
                    currentPermissions = new Dictionary<string, Dictionary<string, bool>>(StringComparer.OrdinalIgnoreCase);
                    foreach (var module in parsed)
                    {
                        var actionDict = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);
                        foreach (var action in module.Value)
                        {
                            actionDict[action.Key] = action.Value;
                        }
                        currentPermissions[module.Key] = actionDict;
                    }
                }
                else
                {
                    currentPermissions = new();
                }
            }
            else
            {
                currentPermissions = new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erreur lecture permissions locales : " + ex.Message);
            currentPermissions = new();
        }
    }

    private bool HasPerm(string module, string action)
    {
        // 1. Accès total pour les admins
        if (userRole == "admin" || userRole == "maintenance") return true;

        // 2. Sécurité de secours si la base de données locale des rôles est vide
        if (currentPermissions == null || currentPermissions.Count == 0)
        {
            if (userRole == "comptable" && module.ToLower() == "comptabilite") return true;
            if (userRole == "commercial" && (module.ToLower() == "produits" || module.ToLower() == "commandes" || module.ToLower() == "b2b" || module.ToLower() == "comptoir")) return true;
            if (userRole == "livreur" && module.ToLower() == "commandes") return true;
            if (userRole == "rh" && module.ToLower() == "equipe") return true;
            if (userRole == "secretaire" && (module.ToLower() == "commandes" || module.ToLower() == "messages")) return true;
            return false;
        }

        // 3. Vérification stricte via le dictionnaire insensible à la casse
        if (currentPermissions.TryGetValue(module, out var actions) && actions.TryGetValue(action, out var allowed))
        {
            return allowed;
        }

        return false;
    }

    private void GoToAdminDashboard()
    {
        if (userRole == "client") return;

        string targetUrl = "/";

        if (userRole == "admin" || userRole == "maintenance")
        {
            targetUrl = "/admin/stock";
        }
        else
        {
            // Vérification intelligente basée sur n'importe quel droit actif
            if (HasAnyPerm("produits")) targetUrl = "/admin/stock";
            else if (HasAnyPerm("commandes") || HasAnyPerm("comptoir") || HasAnyPerm("b2b")) targetUrl = "/vente/commandes";
            else if (HasAnyPerm("comptabilite")) targetUrl = "/comptabilite/comptabilite";
            else if (HasAnyPerm("equipe")) targetUrl = "/rh/equipe";
            else if (HasAnyPerm("messages")) targetUrl = "/vente/chat";
            else if (HasAnyPerm("avis")) targetUrl = "/admin/avis";
            else
            {
                // L'agent n'a AUCUN droit, on le déconnecte au lieu de le forcer sur /admin/stock
                _ = JSRuntime.InvokeVoidAsync("alert", "Vous n'avez aucun droit d'accès configuré. Déconnexion automatique.");
                _ = HandleLogout();
                return;
            }
        }

        NavManager.NavigateTo(targetUrl);
    }

    // Nouvelle méthode dédiée au routage global
    private bool HasAnyPerm(string module)
    {
        if (userRole == "admin" || userRole == "maintenance") return true;

        if (currentPermissions != null && currentPermissions.TryGetValue(module, out var actions))
        {
            return actions.Values.Any(allowed => allowed == true);
        }

        // Sécurité de secours si la base locale est vide
        if (currentPermissions == null || currentPermissions.Count == 0)
        {
            string safeModule = module.ToLower();
            if (userRole == "comptable" && safeModule == "comptabilite") return true;
            if (userRole == "commercial" && (safeModule == "produits" || safeModule == "commandes" || safeModule == "b2b" || safeModule == "comptoir")) return true;
            if (userRole == "livreur" && safeModule == "commandes") return true;
            if (userRole == "rh" && safeModule == "equipe") return true;
            if (userRole == "secretaire" && (safeModule == "commandes" || safeModule == "messages")) return true;
        }

        return false;
    }

    private async Task StartClientChatListener()
    {
        _chatCts.Cancel();
        _chatCts = new CancellationTokenSource();

        string token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_idtoken") ?? "";
        if (string.IsNullOrEmpty(currentUserId) || string.IsNullOrEmpty(token)) return;

        string url = $"https://bothtech-4c076-default-rtdb.firebaseio.com/chats/{currentUserId}/messages.json?auth={token}";

        try
        {
            await ReloadChatHistoryAsync(currentUserId, token);

            using var client = new HttpClient();
            client.Timeout = System.Threading.Timeout.InfiniteTimeSpan;

            var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Accept.Add(new System.Net.Http.Headers.MediaTypeWithQualityHeaderValue("text/event-stream"));
            request.Options.Set(new HttpRequestOptionsKey<bool>("WebAssemblyEnableStreamingResponse"), true);

            using var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, _chatCts.Token);
            using var stream = await response.Content.ReadAsStreamAsync();
            using var reader = new StreamReader(stream);

            while (!_chatCts.IsCancellationRequested)
            {
                var line = await reader.ReadLineAsync();
                if (line == null) break;

                if (line.StartsWith("event: "))
                {
                    var eventType = line.Substring(7);
                    var dataLine = await reader.ReadLineAsync();
                    if (eventType == "put" || eventType == "patch")
                    {
                        await InvokeAsync(() => ReloadChatHistoryAsync(currentUserId, token));
                    }
                }
            }
        }
        catch { if (!_chatCts.IsCancellationRequested) { await Task.Delay(5000); _ = StartClientChatListener(); } }
    }

    private async Task ReloadChatHistoryAsync(string uid, string token)
    {
        try
        {
            var localSession = DataSync.GetAllLocal<ChatSession>().FirstOrDefault(s => s.Id == uid);
            if (localSession != null && localSession.Messages != null)
            {
                var newList = localSession.Messages.Values.Select(m => new ChatMessageItem
                {
                    SenderId = m.SenderId ?? "",
                    SenderName = m.SenderName ?? "",
                    EncryptedText = m.Text ?? "",
                    Timestamp = m.Timestamp,
                    IsAudio = m.IsAudio,
                    AudioDuration = m.AudioDuration,
                    AttachmentDataUrl = m.AttachmentDataUrl ?? "",
                    AttachmentName = m.AttachmentName ?? ""
                }).ToList();
                chatHistory = newList;
                StateHasChanged();
            }

            string url = $"https://bothtech-4c076-default-rtdb.firebaseio.com/chats/{uid}/messages.json?auth={token}";
            using var client = new HttpClient();
            var response = await client.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                if (!string.IsNullOrEmpty(json) && json != "null")
                {
                    var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    var messagesDict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, FirebaseMessageDto>>(json, options);

                    if (messagesDict != null)
                    {
                        var newList = messagesDict.Values.Select(kvp => new ChatMessageItem
                        {
                            SenderId = kvp.senderId ?? "",
                            SenderName = kvp.senderName ?? "",
                            EncryptedText = kvp.text ?? "",
                            Timestamp = kvp.timestamp,
                            IsAudio = kvp.isAudio,
                            AudioDuration = kvp.audioDuration,
                            AttachmentDataUrl = kvp.attachmentDataUrl ?? "",
                            AttachmentName = kvp.attachmentName ?? ""
                        }).ToList();
                        chatHistory = newList;
                        await InvokeAsync(StateHasChanged);
                        await ScrollChatToBottom();

                        var updatedSession = new ChatSession { Id = uid, Messages = messagesDict.ToDictionary(k => k.Key, v => new ChatMessageFirebase { SenderId = v.Value.senderId, SenderName = v.Value.senderName, Text = v.Value.text, Timestamp = v.Value.timestamp, IsAudio = v.Value.isAudio, AudioDuration = v.Value.audioDuration, AttachmentDataUrl = v.Value.attachmentDataUrl, AttachmentName = v.Value.attachmentName }) };
                        DataSync.SaveLocal(updatedSession);
                    }
                }
            }
        }
        catch { }
    }

    private async void HandleAuthStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            var authState = await task;
            if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
            {
                await LoadUserProfile(authState.User);
            }
            else
            {
                userEmail = "";
                userName = "";
                userRole = "client";
                isProfileOpen = false;
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
            // La page a été quittée avant la fin, on ignore l'erreur
        }
        catch (JSDisconnectedException)
        {
            // Le navigateur s'est déconnecté, on ignore
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Erreur inattendue AuthStateChanged : {ex.Message}");
        }
    }

    private async Task LoadUserProfile(System.Security.Claims.ClaimsPrincipal user)
    {
        try
        {
            userName = user.Identity?.Name ?? "Client BothTech";
            var emailClaim = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Email || c.Type == "email");
            userEmail = emailClaim?.Value ?? "client@bothtech.bf";

            currentUserId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userid") ?? "";
            string token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_idtoken") ?? "";

            // Préchargement local (offline)
            var localUser = DataSync.GetAllLocal<UserB2BModel>().FirstOrDefault(u => u.Id == currentUserId);
            if (localUser != null) { userPhone = localUser.Phone ?? ""; userAddress = localUser.Address ?? ""; }

            if (!string.IsNullOrEmpty(currentUserId) && !string.IsNullOrEmpty(token))
            {
                try
                {
                    using var client = new HttpClient();

                    // 1. On interroge Firebase pour voir si le compte existe déjà
                    var response = await client.GetAsync($"https://bothtech-4c076-default-rtdb.firebaseio.com/users/{currentUserId}.json?auth={token}");

                    if (response.IsSuccessStatusCode)
                    {
                        var jsonUser = await response.Content.ReadAsStringAsync();

                        if (string.IsNullOrEmpty(jsonUser) || jsonUser == "null")
                        {
                            // =====================================================================
                            // PREMIÈRE CONNEXION DU COMPTE (N'EXISTE PAS ENCORE DANS /USERS)
                            // =====================================================================

                            string inviteKey = userEmail.Trim().ToLower().Replace(".", ",");
                            var inviteResponse = await client.GetAsync($"https://bothtech-4c076-default-rtdb.firebaseio.com/invitations/{inviteKey}.json?auth={token}");
                            string inviteJson = await inviteResponse.Content.ReadAsStringAsync();

                            if (inviteResponse.IsSuccessStatusCode && !string.IsNullOrEmpty(inviteJson) && inviteJson != "null")
                            {
                                // --- CAS A : L'EMAIL EST DANS LES INVITATIONS (Membre de l'équipe) ---
                                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                                var invitedStaff = System.Text.Json.JsonSerializer.Deserialize<StaffModel>(inviteJson, options);

                                if (invitedStaff != null)
                                {
                                    // On récupère les données de l'invitation
                                    userRole = invitedStaff.Role?.ToLower().Trim() ?? "client";
                                    if (!string.IsNullOrEmpty(invitedStaff.Name)) userName = invitedStaff.Name;
                                    if (!string.IsNullOrEmpty(invitedStaff.Phone1)) userPhone = invitedStaff.Phone1;
                                    if (!string.IsNullOrEmpty(invitedStaff.Address)) userAddress = invitedStaff.Address;

                                    // CRUCIAL : On crée un objet anonyme en minuscules pour respecter les règles ".validate" de Firebase !
                                    var finalUserPayload = new
                                    {
                                        id = currentUserId,
                                        email = userEmail.ToLower(),
                                        name = userName,
                                        role = userRole,
                                        sexe = invitedStaff.Sexe ?? "Masculin",
                                        phone1 = invitedStaff.Phone1 ?? "",
                                        phone2 = invitedStaff.Phone2 ?? "",
                                        address = invitedStaff.Address ?? "",
                                        emergencyName = invitedStaff.EmergencyName ?? "",
                                        emergencyPhone = invitedStaff.EmergencyPhone ?? "",
                                        active = true,
                                        createdAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()
                                    };

                                    var putContent = new StringContent(System.Text.Json.JsonSerializer.Serialize(finalUserPayload), System.Text.Encoding.UTF8, "application/json");
                                    await client.PutAsync($"https://bothtech-4c076-default-rtdb.firebaseio.com/users/{currentUserId}.json?auth={token}", putContent);

                                    // On supprime l'invitation Firebase
                                    await client.DeleteAsync($"https://bothtech-4c076-default-rtdb.firebaseio.com/invitations/{inviteKey}.json?auth={token}");

                                    // On nettoie l'invitation de SQLite s'il y en avait une
                                    DataSync.DeleteLocal<StaffModel>(inviteKey);
                                }
                            }
                            else
                            {
                                // --- CAS B : NOUVEAU CLIENT CLASSIQUE ---
                                userRole = "client";
                                var newClient = new
                                {
                                    id = currentUserId,
                                    email = userEmail.ToLower(),
                                    name = userName,
                                    role = "client",
                                    active = true,
                                    createdAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()
                                };

                                var putContent = new StringContent(System.Text.Json.JsonSerializer.Serialize(newClient), System.Text.Encoding.UTF8, "application/json");
                                await client.PutAsync($"https://bothtech-4c076-default-rtdb.firebaseio.com/users/{currentUserId}.json?auth={token}", putContent);
                            }
                        }
                        else
                        {
                            // =====================================================================
                            // LE COMPTE EXISTAIT DÉJÀ
                            // =====================================================================
                            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                            var dbUser = System.Text.Json.JsonSerializer.Deserialize<LocalUserDto>(jsonUser, options);
                            if (dbUser != null)
                            {
                                userPhone = dbUser.Phone ?? "";
                                userAddress = dbUser.Address ?? "";
                                if (!string.IsNullOrEmpty(dbUser.Role)) userRole = dbUser.Role.ToLower().Trim();
                                if (!string.IsNullOrEmpty(dbUser.Name)) userName = dbUser.Name;
                            }
                        }

                        // Sauvegarde dans SQLite (Cache local)
                        DataSync.SaveLocal(new UserB2BModel { Id = currentUserId, Email = userEmail, Name = userName, Phone = userPhone, Address = userAddress, Role = userRole });
                    }
                }
                catch { }
            }

            // Vérification des Claims
            var roleClaim = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "role");
            if (roleClaim != null && !string.IsNullOrEmpty(roleClaim.Value)) { if (userRole == "client") userRole = roleClaim.Value.ToLower().Trim(); }

            // Blocage des admins sur la version Web
            if (!PlatformService.IsMaui && userRole != "client" && userRole != "maintenance")
            {
                await JSRuntime.InvokeVoidAsync("alert", "L'accès administratif est restreint. Veuillez vous connecter depuis l'application Mobile ou Windows.");
                await HandleLogout(); return;
            }

            await SaveUserToLocalStorage();

            LoadUserPermissionsLocal(userRole);

            // Redirection intelligente pour le staff
            if (userRole != "client")
            {
                GoToAdminDashboard();
                return;
            }

            if (IsProfileIncomplete) { isAuthOpen = false; isProfileOpen = true; } else { isAuthOpen = false; isProfileOpen = false; }
            if (!string.IsNullOrEmpty(currentUserId) && !string.IsNullOrEmpty(token)) { _ = StartClientChatListener(); }
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Le composant a été détruit ou la page actualisée pendant l'exécution.
            // On ignore silencieusement pour éviter le crash.
        }
        catch (JSDisconnectedException)
        {
            // La connexion avec le navigateur a été perdue.
            // On ignore silencieusement.
        }
        catch (Exception ex)
        {
            // Capture toute autre erreur inattendue sans faire crasher l'application
            System.Diagnostics.Debug.WriteLine($"Erreur inattendue dans LoadUserProfile : {ex.Message}");
        }
    }

    private async Task SaveUserToLocalStorage()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_useremail", userEmail);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_username", userName);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_userphone", userPhone);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_useraddress", userAddress);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_userrole", userRole);
        }
        catch { }
    }

    private async Task SaveProfileOfflineFirst()
    {
        if (IsProfileIncomplete) return;
        await SaveUserToLocalStorage();

        try
        {
            string uid = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userid") ?? "";
            string token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_idtoken") ?? "";

            if (!string.IsNullOrEmpty(uid))
            {
                var payload = new Dictionary<string, object>
                {
                    { "email", userEmail }, { "name", userName }, { "phone", userPhone }, { "address", userAddress }
                };

                DataSync.SaveLocal(new UserB2BModel { Id = uid, Email = userEmail, Name = userName, Phone = userPhone, Address = userAddress, Role = userRole });
                DataSync.EnqueueOperation("StaffModel", uid, "UPDATE", payload);

                if (!string.IsNullOrEmpty(token)) _ = DataSync.PushPendingOperationsAsync(token);
            }
        }
        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Erreur synchro profil : {ex.Message}"); }
        isProfileOpen = false; CloseAll();
    }

    private async Task SubmitOrderOfflineFirst()
    {
        if (!AuthService.IsAuthenticated) { isCartOpen = false; OpenAuth(); return; }
        if (string.IsNullOrWhiteSpace(userPhone) || string.IsNullOrWhiteSpace(userAddress)) { isCartOpen = false; isProfileOpen = true; StateHasChanged(); return; }

        isSubmittingOrder = true;
        StateHasChanged();

        try
        {
            string uid = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userid") ?? Guid.NewGuid().ToString();
            string token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_idtoken") ?? "";

            var newOrder = new OrderModel
            {
                Id = Guid.NewGuid().ToString("N"),
                ClientId = uid,
                ClientName = userName,
                Type = "en_ligne",
                Status = "nouveau",
                Total = CartService.GetTotal(),
                CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
                RecipientName = userName,
                RecipientPhone = userPhone,
                RecipientAddress = userAddress,
                Items = CartService.CartItems.Select(c => new OrderItem { Name = c.ProductName, ProductFirebaseId = c.ProductFirebaseId, Quantity = c.Quantity, UnitPrice = c.UnitPrice }).ToList()
            };

            DataSync.SaveLocal(newOrder);
            DataSync.EnqueueOperation("OrderModel", newOrder.Id, "CREATE", newOrder);

            string orderSummary = $"🛒 *NOUVELLE COMMANDE*\n👤 Client : {userName}\n📞 Tél : {userPhone}\n📍 Adresse : {userAddress}\n\n*Articles demandés :*\n";
            foreach (var item in CartService.CartItems) orderSummary += $"- {item.ProductName} (x{item.Quantity})\n";
            orderSummary += $"\n💰 *Total : {CartService.GetTotal():N0} FCFA*";

            var firebaseMessage = new { senderId = uid, senderName = userName, text = EncryptMessage(orderSummary), timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(), isAudio = false };

            string msgId = Guid.NewGuid().ToString("N");
            DataSync.EnqueueOperation("chats", $"{uid}/messages/{msgId}", "UPDATE", firebaseMessage);

            if (!string.IsNullOrEmpty(token)) _ = DataSync.PushPendingOperationsAsync(token);

            CartService.ClearCart();
            isCartOpen = false;
            isChatOpen = true;

            chatHistory.Add(new ChatMessageItem { SenderId = uid, SenderName = userName, EncryptedText = EncryptMessage(orderSummary), Timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() });
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Erreur transmission : " + ex.Message);
        }
        finally
        {
            isSubmittingOrder = false;
            StateHasChanged();
        }
    }

    private async Task SendMessageOfflineFirst()
    {
        string uid = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userid") ?? "";
        string token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_idtoken") ?? "";
        if (string.IsNullOrEmpty(uid)) { await JSRuntime.InvokeVoidAsync("alert", "Veuillez vous reconnecter."); return; }

        if (isRecording)
        {
            string? audioBase64 = null;
            int duration = recordingSeconds;
            isRecording = false; recordingTimer?.Dispose(); recordingSeconds = 0;

            try { chatMessage = "Traitement audio..."; StateHasChanged(); audioBase64 = await JSRuntime.InvokeAsync<string>("audioChat.stopRecording"); chatMessage = ""; } catch { }

            if (!string.IsNullOrEmpty(audioBase64))
            {
                var audioPayload = new { senderId = uid, senderName = userName, text = "", timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(), isAudio = true, audioDuration = duration > 0 ? duration : 1, attachmentDataUrl = audioBase64 };
                string msgId = Guid.NewGuid().ToString("N");
                DataSync.EnqueueOperation("chats", $"{uid}/messages/{msgId}", "UPDATE", audioPayload);
                if (!string.IsNullOrEmpty(token)) _ = DataSync.PushPendingOperationsAsync(token);
            }
        }
        else if (!string.IsNullOrWhiteSpace(chatMessage) || !string.IsNullOrEmpty(selectedFileName))
        {
            var textPayload = new { senderId = uid, senderName = userName, text = EncryptMessage(chatMessage), timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(), isAudio = false, attachmentName = selectedFileName, attachmentDataUrl = selectedFileUrl };
            string msgId = Guid.NewGuid().ToString("N");

            chatHistory.Add(new ChatMessageItem { SenderId = uid, SenderName = userName, EncryptedText = textPayload.text, Timestamp = textPayload.timestamp, AttachmentName = textPayload.attachmentName, AttachmentDataUrl = textPayload.attachmentDataUrl });

            DataSync.EnqueueOperation("chats", $"{uid}/messages/{msgId}", "UPDATE", textPayload);
            if (!string.IsNullOrEmpty(token)) _ = DataSync.PushPendingOperationsAsync(token);

            chatMessage = ""; selectedFileName = ""; selectedFileUrl = "";
            await ScrollChatToBottom();
        }
        StateHasChanged();
    }

    private string GetInitials(string name) { if (string.IsNullOrWhiteSpace(name)) return "U"; return name.Substring(0, 1).ToUpper(); }
