@page "/vente/commandes"
@layout bothtech.Shared.Layout.AdminLayout
@using bothtech.Shared.Models
@using bothtech.Shared.Services
@using System.Globalization
@using System.Net.Http
@using System.IO
@using System.Threading
@using System.Text.Json
@inject DataSyncService DataSync
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Commandes en ligne | Console Admin</PageTitle>

<style>
    .ventes-tab-btn {
        padding: 10px 20px;
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--text-muted);
        background: transparent;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        text-decoration: none;
        display: inline-block;
    }

        .ventes-tab-btn:hover {
            background: #f1f5f9;
            color: var(--primary);
        }

        .ventes-tab-btn.active {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
        }

    @@keyframes pulse-green {
        0% {
            background-color: #dcf8c6;
        }

        50% {
            background-color: #b0e59a;
        }

        100% {
            background-color: #dcf8c6;
        }
    }

    .new-order-row {
        animation: pulse-green 2s infinite;
    }

    @@media (max-width: 768px) {
        .hide-mobile {
            display: none !important;
        }
    }
</style>

<div style="background: transparent; padding: 20px; margin: 0; overflow-x: hidden; padding-bottom: calc(85px + env(safe-area-inset-bottom, 20px)); font-family: 'Plus Jakarta Sans', sans-serif;">

    <!-- MENU DES ONGLETS DE VENTE -->
    <div style="display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 2px solid var(--border); padding-bottom: 10px; flex-wrap: wrap;">
        <NavLink class="ventes-tab-btn" href="/vente/commandes" Match="NavLinkMatch.All" style="text-decoration:none;">📋 Commandes en ligne</NavLink>
        <NavLink class="ventes-tab-btn" href="/vente/ventecomptoir" style="text-decoration:none;">🛒 Vente Comptoir</NavLink>
        <NavLink class="ventes-tab-btn" href="/vente/venteb2b" style="text-decoration:none;">🏢 Ventes B2B (Gros)</NavLink>
    </div>

    <div style="padding: 0 15px 20px 15px;">
        <section class="card">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <h2 class="card-title" style="margin: 0; font-size: 1.2rem;">Tickets & Ventes en ligne</h2>
                    @if (NewOrdersCount > 0)
                    {
                        <span class="badge" style="background: #ef4444; color: white; padding: 4px 8px; border-radius: 12px; font-weight: bold; font-size: 0.8rem;">
                            @NewOrdersCount Nouveaux
                        </span>
                    }
                </div>

                <select class="form-control" @bind="StatusFilter" style="max-width: 200px;">
                    <option value="all">Toutes les commandes</option>
                    <option value="nouveau">Nouvelles (Devis)</option>
                    <option value="en_cours">En Discussion</option>
                    <option value="validee">Conclue (À livrer)</option>
                    <option value="livree">Livrée</option>
                    <option value="annulee">Vente Annulée</option>
                </select>
            </div>

            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th class="hide-mobile">Date</th>
                            <th>Client</th>
                            <th class="hide-mobile">Articles</th>
                            <th class="hide-mobile">Total</th>
                            <th class="hide-mobile" style="text-align: center;">Statut</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr><td colspan="6" style="text-align: center; padding: 20px;">Chargement des commandes...</td></tr>
                        }
                        else if (!FilteredOrders.Any())
                        {
                            <tr><td colspan="6" style="text-align: center; padding: 20px; color:var(--text-muted);">Aucune commande en ligne trouvée.</td></tr>
                        }
                        else
                        {
                            @foreach (var kvp in FilteredOrders)
                            {
                                var orderId = kvp.Key;
                                var order = kvp.Value;
                                string orderUid = !string.IsNullOrEmpty(order.ClientId) ? order.ClientId : order.UserId;
                                bool isNew = order.Status == "nouveau";

                                <tr class="@(isNew ? "new-order-row" : "")">
                                    <td class="hide-mobile"><small>@FormatDate(order.CreatedAt)</small></td>
                                    <td>
                                        <b>@(string.IsNullOrEmpty(order.ClientName) ? order.RecipientName : order.ClientName)</b>
                                        <div class="mobile-only-display" style="margin-top:8px; font-size:0.85rem; line-height: 1.5; border-top:1px dashed var(--border); padding-top:8px;">
                                            <span style="color:var(--text-muted);">🕒 @FormatDate(order.CreatedAt)</span><br>
                                            <b>@FormatMoney(order.Total)</b><br>
                                            @((MarkupString)GetStatusBadge(order.Status))
                                        </div>
                                    </td>
                                    <td class="hide-mobile"><small>@((MarkupString)GetItemsHtml(order.Items))</small></td>
                                    <td class="hide-mobile">
                                        <b>@FormatMoney(order.Total)</b>
                                        @if ((order.Type == "b2b" || order.Type == "b2b_en_ligne") && order.Reste > 0)
                                        {
                                            <br>
                                            <small style="color:var(--danger); font-weight:bold;">Reste: @FormatMoney(order.Reste)</small>
                                        }
                                    </td>
                                    <td class="hide-mobile" style="text-align:center;">
                                        @((MarkupString)GetStatusBadge(order.Status))
                                    </td>
                                    <td style="text-align:right; vertical-align:middle;">
                                        <div class="action-buttons-container" style="display: flex; gap: 5px; justify-content: flex-end;">
                                            @if (canModifyCommandes)
                                            {
                                                @if (order.Status == "nouveau" && string.IsNullOrEmpty(order.TraitePar))
                                                {
                                                    <button class="btn btn-primary" @onclick="() => TakeCharge(orderId, orderUid)" style="background: var(--primary); color: white; border: none; padding: 5px 10px; font-size: 0.85rem;">✋ Prendre</button>
                                                }
                                                else if (order.TraitePar == CurrentUserName || isAdminOrMaintenance)
                                                {
                                                    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:5px;">
                                                        <span style="font-size:0.75rem; color:var(--primary); font-weight:bold;">👤 @(order.TraitePar == CurrentUserName ? "Moi" : order.TraitePar)</span>
                                                        <div style="display:flex; gap:5px;">
                                                            <button class="btn btn-outline" @onclick="() => OpenChat(orderUid)" style="padding: 4px 8px; font-size: 0.85rem;">💬 Chat</button>
                                                            @if (order.Status == "en_cours")
                                                            {
                                                                <button class="btn btn-success" @onclick="@(() => ChangeOrderStatus(orderId, "validee"))" style="padding: 4px 8px; font-size: 0.85rem; border:none; background:#22c55e; color:white;">Valider</button>
                                                                <button class="btn btn-danger" @onclick="@(() => ChangeOrderStatus(orderId, "annulee"))" style="padding: 4px 8px; font-size: 0.85rem; border:none; background:#ef4444; color:white;">Annuler</button>
                                                            }
                                                            else if (order.Status == "validee")
                                                            {
                                                                <button class="btn btn-success" @onclick="@(() => ChangeOrderStatus(orderId, "livree"))" style="padding: 4px 8px; font-size: 0.85rem; border:none; background:#10b981; color:white;">Livrer</button>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning" style="text-align:center; padding: 6px;">🔒 Par<br>@order.TraitePar</span>
                                                }
                                            }
                                            else
                                            {
                                                <div style="display:flex; flex-direction:column; align-items:flex-end; gap:5px;">
                                                    @if (!string.IsNullOrEmpty(order.TraitePar))
                                                    {
                                                        <span style="font-size:0.75rem; color:var(--text-muted); font-weight:bold;">👤 @order.TraitePar</span>
                                                    }
                                                    <span class="badge badge-secondary" style="padding: 4px 8px; background: #e2e8f0; color: #475569; border-radius: 6px; font-size: 0.8rem;">Lecture Seule</span>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    @if (!string.IsNullOrEmpty(ToastMessage))
    {
        <div id="toast" style="display:block; position: fixed; bottom: 20px; right: 20px; background: #333; color: white; padding: 10px 20px; border-radius: 5px; z-index: 9999;">@ToastMessage</div>
    }
</div>

@code {
    private bool IsLoading = true;
    private Dictionary<string, OrderModel> localOrders = new();
    private string _statusFilter = "all";
    private string ToastMessage = "";

    private string CurrentUserName = "Agent";
    private string userRole = "client";
    private string idToken = "";

    private bool isAdminOrMaintenance = false;
    private bool canModifyCommandes = false;
    private Dictionary<string, Dictionary<string, bool>> currentPermissions = new();

    private CancellationTokenSource _ordersCts = new();

    private string StatusFilter
    {
        get => _statusFilter;
        set { _statusFilter = value; }
    }

    private int NewOrdersCount => localOrders.Values.Count(o => o.Status == "nouveau");

    private IEnumerable<KeyValuePair<string, OrderModel>> FilteredOrders => localOrders
        .Where(o => o.Value.Type != "comptoir" && o.Value.Type != "b2b")
        .Where(o => StatusFilter == "all" || o.Value.Status == StatusFilter)
        .OrderByDescending(o => o.Value.CreatedAt);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                idToken = await JSRuntime.InvokeAsync<string>("eval", @"
                    (async () => {
                        const getToken = async () => {
                            try {
                                if (window.auth && window.auth.currentUser) return await window.auth.currentUser.getIdToken(true);
                                return await new Promise(resolve => {
                                    if (!window.auth) return resolve('');
                                    const unsubscribe = window.auth.onAuthStateChanged(async u => {
                                        unsubscribe();
                                        try { resolve(u ? await u.getIdToken(true) : ''); } catch(e) { resolve(''); }
                                    });
                                    setTimeout(() => { unsubscribe(); resolve(''); }, 2000);
                                });
                            } catch(err) { return ''; }
                        };
                        let token = await getToken();
                        if (token) { localStorage.setItem('bothtech_idtoken', token); return token; }
                        return localStorage.getItem('bothtech_idtoken') || '';
                    })()
                ");

                userRole = (await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userrole") ?? "client").ToLower().Trim();
                CurrentUserName = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_useremail") ?? "Agent";
                isAdminOrMaintenance = (userRole == "admin" || userRole == "maintenance");

                if (!isAdminOrMaintenance && userRole != "client")
                {
                    LoadUserPermissionsLocal(userRole);
                }

                canModifyCommandes = HasPerm("commandes", "modifier");

                if (userRole == "client" && !isAdminOrMaintenance)
                {
                    NavManager.NavigateTo("/", true);
                    return;
                }

                // 1. On charge TOUJOURS les commandes locales (SQLite) pour les agents hors-ligne
                LoadLocalOrders();

                // 2. On lance la synchronisation Firebase UNIQUEMENT si on a un jeton
                if (!string.IsNullOrEmpty(idToken))
                {
                    await PullOrdersFromFirebaseAsync();
                    _ = DataSync.PushPendingOperationsAsync(idToken);
                    _ = StartRealtimeOrdersListener();
                }
                else
                {
                    Console.WriteLine("Mode Agent Local ou Hors-ligne : Synchronisation Firebase désactivée pour cette session.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("Erreur Init Commandes : " + ex.Message);
                NavManager.NavigateTo("/", true);
            }
            finally
            {
                IsLoading = false;
                StateHasChanged();
            }
        }
    }

    private void LoadUserPermissionsLocal(string role)
    {
        try
        {
            var localRoles = DataSync.GetAllLocal<RoleConfig>();
            string cleanRole = role.ToLower().Trim();
            var myRoleConfig = localRoles.FirstOrDefault(r => r.Id != null && r.Id.ToLower().Trim() == cleanRole);

            if (myRoleConfig != null && !string.IsNullOrEmpty(myRoleConfig.PermissionsJson))
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var parsed = JsonSerializer.Deserialize<Dictionary<string, Dictionary<string, bool>>>(myRoleConfig.PermissionsJson, options);

                if (parsed != null && parsed.Count > 0)
                {
                    currentPermissions = new Dictionary<string, Dictionary<string, bool>>(StringComparer.OrdinalIgnoreCase);
                    foreach (var module in parsed)
                    {
                        var actionDict = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);
                        foreach (var action in module.Value)
                        {
                            actionDict[action.Key] = action.Value;
                        }
                        currentPermissions[module.Key] = actionDict;
                    }
                }
                else currentPermissions = new();
            }
            else currentPermissions = new();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erreur lecture permissions commandes : " + ex.Message);
            currentPermissions = new();
        }
    }

    private bool HasPerm(string module, string action)
    {
        if (isAdminOrMaintenance) return true;

        if (currentPermissions == null || currentPermissions.Count == 0)
        {
            string safeModule = module.ToLower();
            string safeAction = action.ToLower();

            if (userRole == "commercial" && (safeModule == "commandes" || safeModule == "comptoir" || safeModule == "b2b")) return true;
            if (userRole == "livreur" && safeModule == "commandes" && safeAction == "modifier") return true;
            if (userRole == "secretaire" && (safeModule == "commandes" || safeModule == "messages")) return true;
            return false;
        }

        if (currentPermissions.TryGetValue(module, out var actions) && actions.TryGetValue(action, out var allowed))
        {
            return allowed;
        }

        return false;
    }

    private void LoadLocalOrders()
    {
        try
        {
            var orders = DataSync.GetAllLocal<OrderModel>();
            localOrders = orders.ToDictionary(o => o.Id, o => o);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erreur lecture SQLite : " + ex.Message);
        }
    }

    private async Task PullOrdersFromFirebaseAsync()
    {
        try
        {
            string url = $"https://bothtech-4c076-default-rtdb.firebaseio.com/orders.json?auth={idToken}&orderBy=\"createdAt\"&limitToLast=100";
            using var client = new HttpClient();
            var response = await client.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                if (!string.IsNullOrEmpty(json) && json != "null")
                {
                    var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    var fetchedOrders = JsonSerializer.Deserialize<Dictionary<string, OrderModel>>(json, options);

                    if (fetchedOrders != null)
                    {
                        foreach (var kvp in fetchedOrders)
                        {
                            var order = kvp.Value;
                            order.Id = kvp.Key;
                            DataSync.SaveLocal(order);
                        }
                        LoadLocalOrders();
                    }
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Console.WriteLine("Mode Hors-Ligne : Impossible d'aspirer depuis Firebase (Pas de Token ou Token expiré).");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erreur Pull Firebase : " + ex.Message);
        }
    }

    private async Task StartRealtimeOrdersListener()
    {
        if (string.IsNullOrEmpty(idToken)) return;

        string url = $"https://bothtech-4c076-default-rtdb.firebaseio.com/orders.json?auth={idToken}&orderBy=\"createdAt\"&limitToLast=100";

        try
        {
            using var client = new HttpClient();
            client.Timeout = System.Threading.Timeout.InfiniteTimeSpan;
            var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Accept.Add(new System.Net.Http.Headers.MediaTypeWithQualityHeaderValue("text/event-stream"));
            request.Options.Set(new HttpRequestOptionsKey<bool>("WebAssemblyEnableStreamingResponse"), true);

            using var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, _ordersCts.Token);
            using var stream = await response.Content.ReadAsStreamAsync();
            using var reader = new StreamReader(stream);

            bool isFirstPayload = true;

            while (!_ordersCts.IsCancellationRequested)
            {
                var line = await reader.ReadLineAsync();
                if (line == null) break;

                if (line.StartsWith("event: "))
                {
                    var eventType = line.Substring(7);
                    var dataLine = await reader.ReadLineAsync();

                    if (eventType == "put" || eventType == "patch")
                    {
                        if (isFirstPayload && dataLine != null && dataLine.Contains("\"path\":\"/\""))
                        {
                            isFirstPayload = false;
                            continue;
                        }

                        isFirstPayload = false;

                        await InvokeAsync(async () =>
                        {
                            int oldCount = NewOrdersCount;
                            await PullOrdersFromFirebaseAsync();

                            if (NewOrdersCount > oldCount)
                            {
                                await PlayNotificationSound();
                            }
                        });
                    }
                }
            }
        }
        catch (TaskCanceledException) { }
        catch (Exception)
        {
            if (!_ordersCts.IsCancellationRequested)
            {
                await Task.Delay(5000);
                _ = StartRealtimeOrdersListener();
            }
        }
    }

    private async Task TakeCharge(string orderId, string targetUid)
    {
        if (!canModifyCommandes) { await ShowToast("❌ Action non autorisée."); return; }

        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Prendre en charge cette commande et démarrer la discussion ?");
        if (!confirm) return;

        try
        {
            if (localOrders.TryGetValue(orderId, out var order))
            {
                order.Status = "en_cours";
                order.TraitePar = CurrentUserName;

                DataSync.SaveLocal(order);

                var payload = new Dictionary<string, object>
                {
                    { "status", "en_cours" },
                    { "traitePar", CurrentUserName }
                };
                DataSync.EnqueueOperation("OrderModel", orderId, "UPDATE", payload);

                if (!string.IsNullOrEmpty(idToken))
                {
                    _ = DataSync.PushPendingOperationsAsync(idToken);
                }

                await ShowToast("✅ Prise en charge réussie.");
                if (!string.IsNullOrEmpty(targetUid)) OpenChat(targetUid);
            }
        }
        catch (Exception ex)
        {
            await ShowToast("❌ Erreur : " + ex.Message);
        }
    }

    private async Task ChangeOrderStatus(string orderId, string newStatus)
    {
        if (!canModifyCommandes) { await ShowToast("❌ Action non autorisée."); return; }

        string statusText = newStatus == "validee" ? "Valider la commande (À livrer)" : newStatus == "livree" ? "Marquer comme Livrée" : "Annuler la commande";
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Voulez-vous {statusText.ToLower()} ?");
        if (!confirm) return;

        try
        {
            if (localOrders.TryGetValue(orderId, out var order))
            {
                order.Status = newStatus;
                DataSync.SaveLocal(order);

                var payload = new Dictionary<string, object> { { "status", newStatus } };
                DataSync.EnqueueOperation("OrderModel", orderId, "UPDATE", payload);

                if (newStatus == "validee" && order.Items != null)
                {
                    var catalog = DataSync.GetAllLocal<Product>();

                    foreach (var item in order.Items)
                    {
                        var movement = new StockMovement
                        {
                            MovementId = Guid.NewGuid().ToString("N"),
                            ProductId = item.ProductFirebaseId,
                            QuantityChange = -item.Quantity,
                            MovementType = "WEB_ORDER",
                            OrderId = order.Id,
                            AgentId = CurrentUserName,
                            Date = DateTime.UtcNow
                        };

                        DataSync.SaveLocal(movement);
                        DataSync.EnqueueOperation("StockMovement", movement.MovementId, "CREATE", movement);

                        var localProduct = catalog.FirstOrDefault(p => p.Id == item.ProductFirebaseId);
                        if (localProduct != null)
                        {
                            localProduct.Quantity -= item.Quantity;
                            DataSync.SaveLocal(localProduct);
                        }
                    }
                    await ShowToast("✅ Commande validée et stock déduit !");
                }
                else
                {
                    await ShowToast($"✅ Commande {newStatus}.");
                }

                if (!string.IsNullOrEmpty(idToken))
                {
                    _ = DataSync.PushPendingOperationsAsync(idToken);
                }
            }
        }
        catch (Exception ex)
        {
            await ShowToast("❌ Erreur : " + ex.Message);
        }
    }

    private void OpenChat(string clientId)
    {
        if (!string.IsNullOrEmpty(clientId))
        {
            NavManager.NavigateTo($"/vente/chat?uid={clientId}");
        }
    }

    private string FormatMoney(double amount)
    {
        var nfi = (NumberFormatInfo)CultureInfo.GetCultureInfo("fr-FR").NumberFormat.Clone();
        nfi.NumberGroupSeparator = " ";
        return amount.ToString("N0", nfi) + " FCFA";
    }

    private string FormatMoney(double? amount)
    {
        if (!amount.HasValue) return "0 FCFA";
        return FormatMoney(amount.Value);
    }

    private string FormatDate(long timestamp)
    {
        if (timestamp < 10000000000)
            return DateTimeOffset.FromUnixTimeSeconds(timestamp).LocalDateTime.ToString("dd/MM/yyyy HH:mm");
        return DateTimeOffset.FromUnixTimeMilliseconds(timestamp).LocalDateTime.ToString("dd/MM/yyyy HH:mm");
    }

    private string GetItemsHtml(List<OrderItem> items)
    {
        if (items == null || !items.Any()) return "";
        return string.Join("<br>", items.Select(i => $"{i.Quantity}x {i.Name ?? i.ProductName}"));
    }

    private string GetStatusBadge(string status)
    {
        return status switch
        {
            "validee" => "<span class=\"badge badge-primary\" style=\"background: var(--primary-subtle); color: var(--primary); padding: 4px 8px; border-radius:12px;\">À livrer</span>",
            "livree" => "<span class=\"badge badge-success\" style=\"background: var(--success-subtle); color: var(--success); padding: 4px 8px; border-radius:12px;\">Livrée</span>",
            "annulee" => "<span class=\"badge badge-danger\" style=\"background: var(--danger-subtle); color: var(--danger); padding: 4px 8px; border-radius:12px;\">Annulée</span>",
            "nouveau" => "<span class=\"badge badge-purple\" style=\"background: #f3e8ff; color: var(--purple); padding: 4px 8px; border-radius:12px; font-weight:bold;\">Nouveau Devis</span>",
            "en_cours" => "<span class=\"badge badge-info\" style=\"background: #e0f2fe; color: #0284c7; padding: 4px 8px; border-radius:12px;\">En discussion</span>",
            _ => $"<span class=\"badge badge-info\" style=\"background: #e2e8f0; color: #475569; padding: 4px 8px; border-radius:12px;\">{status}</span>"
        };
    }

    private async Task PlayNotificationSound()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = ctx.createOscillator();
                    const gainNode = ctx.createGain();
                    osc.connect(gainNode);
                    gainNode.connect(ctx.destination);
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(880, ctx.currentTime);
                    gainNode.gain.setValueAtTime(0.5, ctx.currentTime);
                    gainNode.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.5);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.5);
                } catch(e){}
            ");
        }
        catch { }
    }

    private async Task ShowToast(string message)
    {
        ToastMessage = message;
        StateHasChanged();
        await Task.Delay(3000);
        ToastMessage = "";
        StateHasChanged();
    }

    public void Dispose()
    {
        try { if (!_ordersCts.IsCancellationRequested) _ordersCts.Cancel(); } catch { }
        _ordersCts.Dispose();
    }
}