@inherits LayoutComponentBase
@implements IDisposable
@using bothtech.Shared.Services
@using bothtech.Shared.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Security.Cryptography
@using System.Text
@using System.IO
@inject FirebaseService FirebaseService

@inject CartService CartService
@inject NavigationManager NavManager
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject IPlatformService PlatformService

<!-- ✅ STYLE AJOUTÉ : Force le panier et le chat à avoir exactement la même taille (Panneau latéral) -->
<style>
    .cart-drawer-panel, .chat-window {
        width: 100vw !important;
        max-width: 400px !important; /* Largeur commune */
        height: 100vh !important; /* Hauteur commune (tout l'écran) */
        max-height: 100vh !important;
        position: fixed !important;
        top: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        display: flex !important;
        flex-direction: column !important;
        border-radius: 0 !important; /* Supprime les bords arrondis flottants du chat */
        background-color: white !important;
        box-shadow: -4px 0 15px rgba(0,0,0,0.1) !important;
        z-index: 1001 !important;
    }

        /* Animation de masquage si les classes CSS externes le gèrent différemment */
        .chat-window:not(.open) {
            transform: translateX(100%) !important;
        }
</style>

<div>
    <!-- EN-TÊTE GLOBAL -->
    <header class="site-header">
        <div class="top-announcement">
            <div class="marquee-content">
                <span>⚡ Garantie 6 à 12 mois | Retrait & Livraison Partout au Burkina</span>
            </div>
        </div>

        <nav class="nav-container">
            <div class="flex-between w-full">
                <a href="/" class="brand-logo flex-center gap-10" style="text-decoration:none;">
                    <img src="_content/bothtech.Shared/images/Both_Tech_Burkina.jpeg" alt="Logo Both Tech Burkina" class="brand-logo-img">
                    <span class="brand-text">Both Tech Burkina</span>
                </a>
                <div class="header-actions">
                    @if (userRole == "maintenance" || userRole == "admin")
                    {
                        <button class="btn-outline admin-nav-btn" @onclick="GoToAdminStock" aria-label="Console d'administration" style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 6px; font-weight: bold; border: 1px solid var(--primary); color: var(--primary); cursor: pointer; background: transparent;">
                            <span class="icon" aria-hidden="true">🛠️</span>
                            <span class="hide-text-mobile">Admin</span>
                        </button>
                    }

                    <AuthorizeView>
                        <Authorized>
                            <button class="btn-outline admin-nav-btn user-avatar-btn" @onclick="OpenProfile" aria-label="Mon profil" title="@userName">
                                <span class="user-initials">@GetInitials(userName)</span>
                            </button>
                        </Authorized>
                        <NotAuthorized>
                            <button class="btn-outline admin-nav-btn" @onclick="OpenAuth" aria-label="Connexion à mon compte">
                                <span class="icon" aria-hidden="true">👤</span>
                                <span class="hide-text-mobile">Connexion</span>
                            </button>
                        </NotAuthorized>
                    </AuthorizeView>

                    <button class="cart-trigger-btn" @onclick="OpenCart" aria-label="Ouvrir le panier">
                        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                        @if (CartService.GetItemCount() > 0)
                        {
                            <span class="cart-badge">@CartService.GetItemCount()</span>
                        }
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <!-- BOUTON TÉLÉCHARGEMENT ANDROID CENTRÉ -->
    @if (!PlatformService.IsMaui)
    {
        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 15px; background-color: #f8f9fa; border-bottom: 1px solid #eee;">
            <a href="/bothtech.apk" download="BothTech_Burkina.apk" class="btn btn-success" style="background-color: #25d366; color: white; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: bold; display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: fit-content;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4483-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993.0001.5511-.4482.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.2536 13.8533 7.8 12 7.8s-3.5902.4536-5.1367 1.1503l-2.0224-3.503a.4159.4159 0 00-.5676-.1521.4159.4159 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3431-4.1021-2.6892-7.5743-6.1185-9.4396"></path>
                </svg>
                Télécharger l'application Android
            </a>
            <p style="font-size: 0.85rem; color: #666; margin-top: 8px; text-align: center;">
                *Nécessite d'autoriser l'installation d'applications inconnues
            </p>
        </div>
    }

    <main class="main-content" style="padding: 0; padding-bottom: 50px;">
        @Body
    </main>

    <!-- PANIER LATÉRAL -->
    <aside class="cart-drawer @(isCartOpen ? "open" : "")">
        <div class="cart-drawer-overlay" @onclick="CloseAll"></div>
        <div class="cart-drawer-panel" @onclick:stopPropagation="true">
            <header class="cart-header">
                <span id="cartTitle">Ma Sélection</span>
                <button class="close-btn" @onclick="CloseAll">&times;</button>
            </header>
            <div class="cart-items" style="flex: 1; overflow-y: auto;">
                @if (!CartService.CartItems.Any())
                {
                    <p style="text-align: center; padding: 20px; color: var(--text-muted);">Votre panier est vide.</p>
                }
                else
                {
                    @foreach (var item in CartService.CartItems)
                    {
                        <div class="cart-item" style="display: flex; align-items: center; border-bottom: 1px solid #eee; padding: 15px 10px;">
                            <div style="flex: 1;">
                                <h4 style="font-size: 0.95rem; margin: 0 0 8px 0; color: #333;">@item.ProductName</h4>
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div style="display:flex; align-items:center; border: 1px solid #ddd; border-radius: 4px; overflow: hidden;">
                                        <button type="button" style="background:#f8f9fa; border:none; padding:4px 10px; cursor:pointer;" @onclick="() => CartService.UpdateQuantity(item.ProductFirebaseId, -1)">-</button>
                                        <span style="font-weight: bold; width: 30px; text-align: center;">@item.Quantity</span>
                                        <button type="button" style="background:#f8f9fa; border:none; border-left:1px solid #ddd; padding:4px 10px; cursor:pointer;" @onclick="() => CartService.UpdateQuantity(item.ProductFirebaseId, 1)">+</button>
                                    </div>
                                    <span style="font-size: 0.85rem; color: var(--gray-600);">x @item.UnitPrice.ToString("N0") F</span>
                                </div>
                            </div>
                            <div style="font-weight: bold; margin: 0 15px;">
                                @item.TotalPrice.ToString("N0") F
                            </div>
                            <button class="close-btn" style="color: var(--danger); font-size: 1.5rem; background:none; border:none; cursor:pointer;" @onclick="() => CartService.RemoveFromCart(item.ProductFirebaseId)">&times;</button>
                        </div>
                    }
                }
            </div>
            <footer class="cart-footer">
                <div class="cart-total-row">
                    <span>Total</span>
                    <span>@CartService.GetTotal().ToString("N0") FCFA</span>
                </div>
                <button class="btn btn-primary w-full"
                        disabled="@(!CartService.CartItems.Any() || isSubmittingOrder)"
                        style="background: var(--primary); border: none; padding: 12px; font-weight: bold;"
                        @onclick="SubmitOrderDirectly">
                    @(isSubmittingOrder ? "Transmission en cours..." : "Valider la commande")
                </button>
            </footer>
        </div>
    </aside>

    <!-- MODALE AUTHENTIFICATION -->
    <div class="modal-overlay @(isAuthOpen ? "open" : "")" @onclick="CloseAll">
        <div class="modal-card" @onclick:stopPropagation="true">
            <header class="modal-header">
                <h3 class="brand-text">Both Tech Burkina</h3>
                <button class="close-btn" @onclick="CloseAll">&times;</button>
            </header>
            <div class="modal-body">
                <p class="text-center text-muted mb-24" style="line-height: 1.5; font-size: 0.95rem;">
                    Connectez-vous avec votre compte sécurisé. S'il n'existe pas, il sera créé automatiquement.
                </p>

                @if (!string.IsNullOrEmpty(authErrorMessage))
                {
                    <div class="alert-danger" style="background-color: #f8d7da; color: #721c24; padding: 10px; border-radius: 6px; margin-bottom: 15px; font-size: 0.85rem;">
                        @authErrorMessage
                    </div>
                }

                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <button type="button" class="btn btn-social" @onclick="HandleGoogleLogin">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M21.35 11.1h-9.17v2.73h5.4c-.23 1.3-1.63 3.82-5.4 3.82-3.25 0-5.9-2.7-5.9-6.05s2.65-6.05 5.9-6.05c1.86 0 3.1.8 3.8 1.47l2.13-2.05C16.5 3.5 14.4 2.6 11.8 2.6 6.6 2.6 2.4 6.8 2.4 12s4.2 9.4 9.4 9.4c5.4 0 9.02-3.8 9.02-9.17 0-.67-.07-1.12-.13-1.63z" /></svg>
                        Continuer avec Google
                    </button>
                    <button type="button" class="btn btn-social auth0" @onclick="HandleAuth0Login">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M21.57 8.05c-.32-.78-.77-1.5-1.32-2.12-.55-.63-1.2-1.16-1.95-1.58-.75-.42-1.58-.73-2.48-.94-.9-.21-1.85-.31-2.82-.31-1.85 0-3.51.3-4.99.91-1.48.61-2.77 1.48-3.86 2.61-1.09 1.13-1.94 2.49-2.55 4.09-.61 1.6-.92 3.37-.92 5.31 0 1.94.31 3.71.92 5.31.61 1.6 1.46 2.96 2.55 4.09 1.09 1.13 2.38 2 3.86 2.61 1.48.61 3.14.91 4.99.91.97 0 1.92-.1 2.82-.31.9-.21 1.73-.52 2.48-.94.75-.42 1.4-.95 1.95-1.58.55-.62 1-1.34 1.32-2.12.32-.78.48-1.63.48-2.56 0-.93-.16-1.78-.48-2.56zm-9.57 9.15c-2.95 0-5.35-2.4-5.35-5.35s2.4-5.35 5.35-5.35 5.35 2.4 5.35 5.35-2.4 5.35-5.35 5.35z" /></svg>
                        Continuer avec Auth0
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODALE PROFIL -->
    <div class="modal-overlay @(isProfileOpen ? "open" : "")" @onclick="CloseAll">
        <div class="modal-card" @onclick:stopPropagation="true">
            <header class="modal-header">
                <h3>Mon profil & Livraison</h3>
                @if (!IsProfileIncomplete)
                {
                    <button class="close-btn" @onclick="CloseAll">&times;</button>
                }
            </header>
            <div class="modal-body">
                @if (IsProfileIncomplete)
                {
                    <div class="alert-danger" role="alert" style="display:block; background:#f8d7da; color:#721c24; padding:10px; border-radius:6px; font-size:0.85rem; margin-bottom:12px; font-weight:bold;">
                        ⚠ Vous devez obligatoirement renseigner votre téléphone et votre adresse pour utiliser l'application.
                    </div>
                }
                else
                {
                    <div class="alert-warning" role="alert" style="display:block; background:#fef3c7; color:#92400e; padding:10px; border-radius:6px; font-size:0.85rem; margin-bottom:12px;">
                        💡 Gardez vos informations de livraison à jour.
                    </div>
                }

                <form @onsubmit="SaveProfile" @onsubmit:preventDefault="true">
                    <label style="font-size: 0.8rem; font-weight: bold; color: var(--gray-600);">Email (Compte)</label>
                    <input type="email" class="form-input" disabled @bind-value="userEmail" placeholder="Chargement...">

                    <label style="font-size: 0.8rem; font-weight: bold; color: var(--gray-600);">Nom complet</label>
                    <input type="text" class="form-input" disabled @bind-value="userName" placeholder="Chargement...">

                    <label style="font-size: 0.8rem; font-weight: bold; color: var(--gray-600);">Téléphone (WhatsApp / Appel) *</label>
                    <input type="tel" class="form-input" required placeholder="Ex: +226 70 00 00 00" @bind-value="userPhone">

                    <label style="font-size: 0.8rem; font-weight: bold; color: var(--gray-600);">Adresse de livraison *</label>
                    <input type="text" class="form-input" required placeholder="Ex: Ouagadougou, Ouaga 2000" @bind-value="userAddress">

                    <button type="submit" class="btn btn-primary mt-10 mb-14 w-full" disabled="@IsProfileIncomplete">Enregistrer et Continuer</button>

                    <button type="button" class="btn btn-outline w-full" style="color:var(--danger); border-color:var(--danger);" @onclick="HandleLogout">Se déconnecter</button>
                </form>
            </div>
        </div>
    </div>

    <!-- WIDGET CHAT -->
    <AuthorizeView>
        <Authorized>
            <!-- ✅ AJOUT : Le bouton est masqué si isCartOpen est vrai -->
            @if (!isCartOpen)
            {
                <button class="chat-widget-btn" @onclick="ToggleChat">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"></path></svg>
                </button>
            }

            <aside class="chat-window @(isChatOpen ? "open" : "")" @onclick:stopPropagation="true">
                <header class="chat-header" style="display:flex; justify-content:space-between; align-items:center;">
                    <div><span>Service Client</span><div style="font-size:0.7rem; color:#e0f2f1;">🔒 Chiffré de bout en bout</div></div>
                    <button class="close-btn" @onclick="CloseAll" style="background:transparent; color:white;">&times;</button>
                </header>
                <div class="chat-messages" style="display: flex; flex-direction: column; flex: 1; overflow-y: auto; padding: 15px;">
                    <div class="msg-bubble admin mt-10" style="align-self: flex-start; background-color: #fff; padding: 8px 12px; border-radius: 12px; margin-bottom: 5px; border: 1px solid #eee;">
                        Bonjour ! Votre commande a bien été transmise. Comment pouvons-nous vous aider ?
                    </div>
                    @foreach (var msg in chatHistory)
                    {
                        <div class="msg-bubble user mt-10" style="align-self: flex-end; background-color: #dcf8c6; padding: 8px 12px; border-radius: 12px; margin-bottom: 5px; max-width: 85%;">
                            @if (msg.IsAudio)
                            {
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <button type="button" @onclick="() => TogglePlayAudio(msg)" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--primary);">
                                        @(msg.IsPlaying ? "⏸" : "▶")
                                    </button>
                                    <div style="width: 120px; height: 5px; background: #b0d8a4; border-radius: 5px; overflow: hidden; position: relative;">
                                        <div style="width: @(msg.AudioProgress)%; height: 100%; background: var(--primary); transition: width 0.2s;"></div>
                                    </div>
                                    <span style="font-size: 0.8rem; color: #54656f;">00:@(msg.AudioDuration.ToString("D2"))</span>
                                </div>
                            }
                            else
                            {
                                @if (!string.IsNullOrEmpty(msg.EncryptedText))
                                {
                                    <span style="display: block; margin-bottom: 5px;">@DecryptMessage(msg.EncryptedText)</span>
                                }
                                @if (!string.IsNullOrEmpty(msg.AttachmentName))
                                {
                                    <div style="margin-top: 5px; padding-top: 5px; border-top: 1px solid rgba(0,0,0,0.1);">
                                        @if (!string.IsNullOrEmpty(msg.AttachmentDataUrl))
                                        {
                                            <img src="@msg.AttachmentDataUrl" alt="@msg.AttachmentName" style="max-width: 100%; max-height: 200px; border-radius: 8px; display: block; margin-bottom: 8px;" />
                                        }
                                        else
                                        {
                                            <span style="font-size: 0.85rem; color: #54656f;">📎 @msg.AttachmentName</span>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(selectedFileName))
                {
                    <div class="chat-attachment-preview" style="display:flex; align-items:center; background:#e9edef; padding:8px; margin:0 10px 10px 10px; border-radius:8px;">
                        @if (!string.IsNullOrEmpty(selectedFileUrl))
                        {
                            <img src="@selectedFileUrl" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px; margin-right: 8px;" />
                        }
                        <span style="flex:1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size:0.85rem;">@selectedFileName</span>
                        <button type="button" @onclick="RemoveAttachment" style="color:red; font-weight:bold; background:none; border:none; cursor:pointer; font-size: 1.2rem;">&times;</button>
                    </div>
                }

                <form class="chat-input-area" @onsubmit="SendMessage" @onsubmit:preventDefault="true">
                    @if (isRecording)
                    {
                        <button type="button" class="chat-action-btn" style="color: #dc3545;" @onclick="CancelRecording">🗑️</button>
                        <div class="chat-text-input" style="color: #dc3545; display: flex; align-items: center; font-weight: bold; animation: pulse 1.5s infinite;">🔴 00:@(recordingSeconds.ToString("D2"))</div>
                        <button type="button" class="chat-send-btn" @onclick="SendMessage">➤</button>
                    }
                    else
                    {
                        <InputFile OnChange="HandleFileUpload" hidden id="chat-file-upload" accept="image/jpeg, image/jpg, image/png, application/pdf" />
                        <label for="chat-file-upload" class="chat-action-btn">📎</label>
                        <input type="text" class="chat-text-input" placeholder="Message chiffré..." autocomplete="off" @bind="chatMessage" @bind:event="oninput">
                        @if (PlatformService.IsMaui)
                        {
                            <button type="button" class="chat-action-btn" @onclick="StartRecording">🎤</button>
                        }
                        else
                        {
                            <button type="button" class="chat-action-btn" @onclick="SetVoiceInfoMessage">ℹ️</button>
                        }
                        <button type="submit" class="chat-send-btn">➤</button>
                    }
                </form>
            </aside>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private bool isCartOpen = false;
    private bool isAuthOpen = false;
    private bool isProfileOpen = false;
    private bool isChatOpen = false;
    private bool isSubmittingOrder = false;

    private string userEmail = "";
    private string userName = "";
    private string userPhone = "";
    private string userAddress = "";
    private string userRole = "client";
    private string authErrorMessage = "";

    // Clé secrète fixe (32 octets) et Vecteur d'initialisation (16 octets) partagés avec l'Admin
    private readonly byte[] encryptionKey = System.Text.Encoding.UTF8.GetBytes("BothTechSecretKeyForChat2026!@#$");
    private readonly byte[] encryptionIv = System.Text.Encoding.UTF8.GetBytes("BothTechInitVect");

    private bool IsProfileIncomplete => string.IsNullOrWhiteSpace(userPhone) || string.IsNullOrWhiteSpace(userAddress);

    protected override void OnInitialized()
    {
        CartService.OnCartChanged += StateHasChanged;
        AuthStateProvider.AuthenticationStateChanged += HandleAuthStateChanged;

        using (var rng = RandomNumberGenerator.Create())
        {
            rng.GetBytes(encryptionKey);
            rng.GetBytes(encryptionIv);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                string savedEmail = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_useremail") ?? "";

                if (!string.IsNullOrEmpty(savedEmail) && !AuthService.IsAuthenticated)
                {
                    string savedName = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_username") ?? "Client BothTech";
                    userPhone = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userphone") ?? "";
                    userAddress = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_useraddress") ?? "";

                    string savedRole = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userrole") ?? "client";
                    userRole = savedRole.ToLower().Trim();

                    if (userRole != "client" && userRole != "detaillant" && userRole != "maintenance")
                    {
                        NavManager.NavigateTo("/stock", true);
                        return;
                    }

                    var user = new User
                    {
                        Email = savedEmail,
                        Name = savedName,
                        Role = userRole,
                        FirebaseUid = ""
                    };

                    AuthService.RestoreSession(user);

                    if (IsProfileIncomplete)
                    {
                        isProfileOpen = true;
                    }

                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Erreur OnAfterRender : {ex.Message}");
            }
        }
    }

    private async void HandleAuthStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
        {
            await LoadUserProfile(authState.User);
        }
        else
        {
            userEmail = "";
            userName = "";
            userRole = "client";
            isProfileOpen = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadUserProfile(System.Security.Claims.ClaimsPrincipal user)
    {
        userName = user.Identity?.Name ?? "Client BothTech";
        var emailClaim = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Email || c.Type == "email");
        userEmail = emailClaim?.Value ?? "client@bothtech.bf";

        var roleClaim = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "role");
        if (roleClaim != null && !string.IsNullOrEmpty(roleClaim.Value))
        {
            userRole = roleClaim.Value.ToLower().Trim();
        }
        else
        {
            try
            {
                string savedRole = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userrole");
                if (!string.IsNullOrEmpty(savedRole))
                {
                    userRole = savedRole.ToLower().Trim();
                }
            }
            catch
            {
                if (string.IsNullOrEmpty(userRole))
                {
                    userRole = "client";
                }
            }
        }

        await SaveUserToLocalStorage();

        if (IsProfileIncomplete)
        {
            isAuthOpen = false;
            isProfileOpen = true;
        }

        StateHasChanged();
    }

    private async Task SaveUserToLocalStorage()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_useremail", userEmail);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_username", userName);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_userphone", userPhone);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_useraddress", userAddress);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bothtech_userrole", userRole);
        }
        catch { }
    }

