    public class ChatMessageItem { public string EncryptedText { get; set; } = ""; public string AttachmentName { get; set; } = ""; public string AttachmentDataUrl { get; set; } = ""; public bool IsAudio { get; set; } = false; public int AudioDuration { get; set; } = 0; public bool IsPlaying { get; set; } = false; public int AudioProgress { get; set; } = 0; public System.Threading.Timer? PlaybackTimer { get; set; } }

    private List<ChatMessageItem> chatHistory = new();
    private string chatMessage = "";
    private string selectedFileName = "";
    private string selectedFileUrl = "";
    private bool isRecording = false;
    private int recordingSeconds = 0;
    private System.Threading.Timer? recordingTimer;

    private string EncryptMessage(string plainText) { if (string.IsNullOrEmpty(plainText)) return ""; using Aes aes = Aes.Create(); aes.Key = encryptionKey; aes.IV = encryptionIv; ICryptoTransform encryptor = aes.CreateEncryptor(aes.Key, aes.IV); using MemoryStream ms = new MemoryStream(); using CryptoStream cs = new CryptoStream(ms, encryptor, CryptoStreamMode.Write); using (StreamWriter sw = new StreamWriter(cs)) { sw.Write(plainText); } return Convert.ToBase64String(ms.ToArray()); }
    private string DecryptMessage(string cipherText) { if (string.IsNullOrEmpty(cipherText)) return ""; try { using Aes aes = Aes.Create(); aes.Key = encryptionKey; aes.IV = encryptionIv; ICryptoTransform decryptor = aes.CreateDecryptor(aes.Key, aes.IV); using MemoryStream ms = new MemoryStream(Convert.FromBase64String(cipherText)); using CryptoStream cs = new CryptoStream(ms, decryptor, CryptoStreamMode.Read); using StreamReader sr = new StreamReader(cs); return sr.ReadToEnd(); } catch { return "Erreur de déchiffrement"; } }

    private async Task SendMessage()
    {
        if (isRecording)
        {
            string? audioBase64 = null;
            int duration = recordingSeconds;

            isRecording = false;
            recordingTimer?.Dispose();
            recordingSeconds = 0;

            try
            {
                chatMessage = "Traitement de l'audio...";
                StateHasChanged();

                audioBase64 = await JSRuntime.InvokeAsync<string>("audioChat.stopRecording");
                chatMessage = "";
            }
            catch (Exception ex)
            {
                chatMessage = "Erreur création audio: " + ex.Message;
            }

            if (!string.IsNullOrEmpty(audioBase64))
            {
                chatHistory.Add(new ChatMessageItem
                {
                    IsAudio = true,
                    AudioDuration = duration > 0 ? duration : 1,
                    AttachmentDataUrl = audioBase64
                });
            }
        }
        else if (!string.IsNullOrWhiteSpace(chatMessage) || !string.IsNullOrEmpty(selectedFileName))
        {
            chatHistory.Add(new ChatMessageItem
            {
                EncryptedText = EncryptMessage(chatMessage),
                AttachmentName = selectedFileName,
                AttachmentDataUrl = selectedFileUrl
            });
            chatMessage = "";
            selectedFileName = "";
            selectedFileUrl = "";
        }

        StateHasChanged();
    }

    private async Task StartRecording()
    {
        try
        {
            chatMessage = "Initialisation du micro...";
            StateHasChanged();

            bool success = await JSRuntime.InvokeAsync<bool>("audioChat.startRecording");

            if (success)
            {
                isRecording = true;
                recordingSeconds = 0;
                chatMessage = "";

                recordingTimer = new System.Threading.Timer((_) =>
                {
                    recordingSeconds++;
                    InvokeAsync(StateHasChanged);
                }, null, 1000, 1000);
            }
            else
            {
                chatMessage = "⚠️ Erreur: Micro refusé par Android.";
            }
        }
        catch (Exception ex)
        {
            chatMessage = $"⚠️ Erreur JS: {ex.Message}";
        }

        StateHasChanged();
    }

    private async Task CancelRecording()
    {
        isRecording = false;
        recordingTimer?.Dispose();
        recordingSeconds = 0;
        try
        {
            await JSRuntime.InvokeVoidAsync("audioChat.cancelRecording");
        }
        catch { }

        StateHasChanged();
    }

    private async Task TogglePlayAudio(ChatMessageItem msg)
    {
        if (msg.IsPlaying)
        {
            msg.IsPlaying = false;
            msg.PlaybackTimer?.Dispose();
        }
        else
        {
            msg.IsPlaying = true;
            if (msg.AudioProgress >= 100) msg.AudioProgress = 0;
            try { if (!string.IsNullOrEmpty(msg.AttachmentDataUrl)) await JSRuntime.InvokeVoidAsync("audioChat.playAudio", msg.AttachmentDataUrl); } catch { }

            int step = 100 / (msg.AudioDuration > 0 ? msg.AudioDuration : 1);
            msg.PlaybackTimer = new System.Threading.Timer((_) =>
            {
                msg.AudioProgress += step;
                if (msg.AudioProgress >= 100)
                {
                    msg.AudioProgress = 100;
                    msg.IsPlaying = false;
                    msg.PlaybackTimer?.Dispose();
                }
                InvokeAsync(StateHasChanged);
            }, null, 1000, 1000);
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            selectedFileName = file.Name;
            try
            {
                using var ms = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: 15000000).CopyToAsync(ms);
                var buffer = ms.ToArray();

                selectedFileUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
            }
            catch (Exception ex)
            {
                selectedFileName = "Erreur fichier";
                Console.WriteLine($"Erreur Fichier : {ex.Message}");
            }
            StateHasChanged();
        }
    }

    private void RemoveAttachment() { selectedFileName = ""; selectedFileUrl = ""; }
    private async Task SubmitOrderDirectly()
    {
        if (!AuthService.IsAuthenticated) { isCartOpen = false; OpenAuth(); return; }
        if (string.IsNullOrWhiteSpace(userPhone) || string.IsNullOrWhiteSpace(userAddress)) { isCartOpen = false; isProfileOpen = true; StateHasChanged(); return; }

        isSubmittingOrder = true;
        StateHasChanged();

        try
        {
            // 1. Récupération des infos du client
            string uid = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_userid") ?? Guid.NewGuid().ToString();
            string token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_idtoken") ?? "";

            // 2. Création de la commande officielle (pour le tableau "Ventes")
            var newOrder = new OrderModel
            {
                Id = Guid.NewGuid().ToString(),
                ClientId = uid,
                ClientName = userName,
                Type = "en_ligne",
                Status = "nouveau", // Allume le badge rouge chez l'admin
                Total = CartService.GetTotal(),
                CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
                Items = CartService.CartItems.Select(c => new OrderItem
                {
                    Name = c.ProductName,
                    Quantity = c.Quantity,
                    Price = c.UnitPrice
                }).ToList()
            };

            await FirebaseService.AddOrderAsync(newOrder, token);

            // 3. Création du message automatique pour le Chat de l'équipe
            string orderSummary = $"🛒 *NOUVELLE COMMANDE*\n👤 Client : {userName}\n📞 Tél : {userPhone}\n📍 Adresse : {userAddress}\n\n*Articles demandés :*\n";
            foreach (var item in CartService.CartItems) orderSummary += $"- {item.ProductName} (x{item.Quantity})\n";
            orderSummary += $"\n💰 *Total : {CartService.GetTotal():N0} FCFA*";

            // L'objet qui part dans Firebase
            var firebaseMessage = new
            {
                senderId = uid,
                senderName = userName,
                text = EncryptMessage(orderSummary),
                timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
                isAudio = false
            };

            await FirebaseService.SendChatMessageAsync(uid, firebaseMessage, token);

            // 4. Affichage local sur le téléphone du client pour qu'il le voie
            chatHistory.Add(new ChatMessageItem { EncryptedText = firebaseMessage.text });

            // 5. Nettoyage du panier
            CartService.ClearCart();
            isCartOpen = false;
            isChatOpen = true;
        }
        catch (Exception ex)
        {
            // Si Firebase renvoie une erreur d'autorisation ou de permission (Jeton expiré ou invalide)
            if (ex.Message.Contains("Permission denied") || ex.Message.Contains("Unauthorized") || ex.Message.Contains("401"))
            {
                await JSRuntime.InvokeVoidAsync("alert", "Votre session a expiré pour des raisons de sécurité. Veuillez vous reconnecter pour valider la commande.");

                // On nettoie la session expirée
                AuthService.Logout();
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "bothtech_idtoken");

                // On ferme le panier et on ouvre la fenêtre de connexion
                isCartOpen = false;
                OpenAuth();
            }
            else
            {
                authErrorMessage = "Erreur transmission : " + ex.Message;
                await JSRuntime.InvokeVoidAsync("alert", authErrorMessage);
            }
        }
        finally
        {
            isSubmittingOrder = false;
            StateHasChanged();
        }
    }
