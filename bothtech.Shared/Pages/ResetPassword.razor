@page "/reset-password"
@using bothtech.Shared.Services
@using bothtech.Shared.Models
@inject NavigationManager NavManager
@inject AuthService AuthService
@inject DataSyncService DataSync
@inject IJSRuntime JSRuntime

<PageTitle>Nouveau mot de passe - Both Tech Burkina</PageTitle>

<div style="max-width: 400px; margin: 80px auto; padding: 30px; border-radius: 12px; box-shadow: 0 8px 25px rgba(0,0,0,0.1); background-color: white;">

    <header style="text-align: center; margin-bottom: 25px;">
        <h3 class="brand-text" style="font-size: 1.5rem; color: var(--primary); margin: 0 0 10px 0;">Both Tech Burkina</h3>
        <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">Création de votre nouveau mot de passe</p>
    </header>

    <div class="modal-body">
        @if (_isSuccess)
        {
            <div style="background-color: #dcf8c6; color: #166534; padding: 15px; border-radius: 8px; text-align: center; font-weight: bold;">
                🎉 Mot de passe mis à jour avec succès !<br /><br />
                <span style="font-size: 0.85rem; font-weight: normal;">Connexion automatique en cours...</span>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert-danger" style="background-color: #f8d7da; color: #721c24; padding: 10px; border-radius: 6px; margin-bottom: 15px; font-size: 0.85rem; text-align: center;">
                    @_errorMessage
                </div>
            }

            <form @onsubmit="HandleResetPassword" style="display: flex; flex-direction: column; gap: 15px;">
                <input type="password" @bind="_newPassword" placeholder="Nouveau mot de passe" required minlength="6" class="form-control" style="padding: 12px; border-radius: 8px; border: 1px solid #ccc; width: 100%; box-sizing: border-box;" />
                <input type="password" @bind="_confirmPassword" placeholder="Confirmer le mot de passe" required minlength="6" class="form-control" style="padding: 12px; border-radius: 8px; border: 1px solid #ccc; width: 100%; box-sizing: border-box;" />

                <button type="submit" disabled="@_isLoading" class="btn btn-primary" style="background: var(--primary, #0056b3); color: white; padding: 12px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 10px;">
                    @(_isLoading ? "Mise à jour en cours..." : "Enregistrer le mot de passe")
                </button>
            </form>

            <div style="text-align: center; margin-top: 20px;">
                <a href="/login" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: underline;">Retour à la connexion</a>
            </div>
        }
    </div>
</div>

@code {
    // 👇 NOUVELLE MÉTHODE BLazor NATIVE POUR LIRE L'URL 👇
    [SupplyParameterFromQuery(Name = "oobCode")]
    public string? OobCode { get; set; }

    private string _newPassword = "";
    private string _confirmPassword = "";
    private string _errorMessage = "";
    private bool _isLoading = false;
    private bool _isSuccess = false;

    protected override void OnInitialized()
    {
        // On vérifie directement la propriété alimentée par Blazor
        if (string.IsNullOrEmpty(OobCode))
        {
            _errorMessage = "Lien invalide ou incomplet. Veuillez cliquer sur le lien reçu par email.";
        }
    }

    private async Task HandleResetPassword()
    {
        if (string.IsNullOrEmpty(OobCode)) return;

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "Les mots de passe ne correspondent pas.";
            return;
        }

        _isLoading = true;
        _errorMessage = "";
        StateHasChanged();

        try
        {
            // 1. Validation du code et changement du mot de passe de base dans Firebase Auth
            string userEmail = await AuthService.ConfirmPasswordResetAsync(OobCode, _newPassword);

            // 2. Connexion silencieuse pour générer une session et récupérer le profil
            var user = await AuthService.LoginOrRegisterAsync(userEmail, _newPassword);
            string token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "bothtech_idtoken");

            // 3. LA CLÉ DE L'OFFLINE-FIRST : Mise à jour de "localPassword" dans la Realtime Database
            var payload = new Dictionary<string, object> { { "localPassword", _newPassword } };
            DataSync.EnqueueOperation("StaffModel", user.FirebaseUid, "UPDATE", payload);

            // On force l'envoi immédiat (Push) vers Firebase Realtime DB
            if (!string.IsNullOrEmpty(token))
            {
                await DataSync.PushPendingOperationsAsync(token);
            }

            // 4. Mise à jour instantanée de la base SQLite locale pour autoriser la connexion offline
            var localStaffList = DataSync.GetAllLocal<StaffModel>();
            var localStaff = localStaffList.FirstOrDefault(s => s.Id == user.FirebaseUid);
            if (localStaff != null)
            {
                localStaff.LocalPassword = _newPassword;
                DataSync.SaveLocal(localStaff);
            }

            _isSuccess = true;
            StateHasChanged();

            // 5. Redirection automatique vers le Layout Principal qui routera l'agent
            await Task.Delay(2500);
            NavManager.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}