@code {
    // Blazor va automatiquement chercher "?code=..." dans l'URL et le mettre dans cette variable !
    [SupplyParameterFromQuery(Name = "code")]
    public string Code { get; set; }

    // Remplacement de OnInitializedAsync par OnAfterRenderAsync
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // On s'assure que le code s'exécute uniquement après le premier rendu complet
        if (firstRender)
        {
            // 1. On vérifie si Blazor a bien trouvé le paramètre "code" dans l'URL
            if (!string.IsNullOrEmpty(Code))
            {
                // 2. On passe le code à notre service pour valider la connexion
                bool success = await AuthService.HandleAuth0CallbackAsync(Code);

                if (success)
                {
                    // 3. Redirection fluide vers l'accueil
                    NavigationManager.NavigateTo("/");
                }
                else
                {
                    NavigationManager.NavigateTo("/login");
                }
            }
            else
            {
                // S'il n'y a pas de code (ex: l'utilisateur a annulé), on le renvoie au login
                NavigationManager.NavigateTo("/login");
            }
        }
    }
} *@