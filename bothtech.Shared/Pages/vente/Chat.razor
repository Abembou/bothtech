        localChats[selectedClientId].Messages[msgId] = new ChatMessageFirebase { SenderId = currentAdminUid, SenderName = currentAdminName, Text = msg.text, Timestamp = msg.timestamp, IsAudio = false };

        DataSync.EnqueueOperation("chats", $"{selectedClientId}/messages/{msgId}", "UPDATE", msg);

        if (!string.IsNullOrEmpty(idToken))
        {
            _ = DataSync.PushPendingOperationsAsync(idToken);
        }

        await SwitchTab("messages");
    }

