    private AudioPlaybackState GetAudioState(long ts) { if (!audioStates.ContainsKey(ts)) audioStates[ts] = new AudioPlaybackState(); return audioStates[ts]; }
    private async Task TogglePlayAudio(dynamic msg) { long ts = (long)msg.Timestamp; var state = GetAudioState(ts); if (state.IsPlaying) { state.IsPlaying = false; state.Timer?.Dispose(); } else { state.IsPlaying = true; if (state.Progress >= 100) state.Progress = 0; try { string audioUrl = (string)msg.AttachmentDataUrl; if (!string.IsNullOrEmpty(audioUrl)) await JSRuntime.InvokeVoidAsync("audioChat.playAudio", audioUrl); } catch { } int duration = 5; try { duration = (int)msg.AudioDuration > 0 ? (int)msg.AudioDuration : 5; } catch { } int step = 100 / duration; state.Timer = new System.Threading.Timer((_) => { state.Progress += step; if (state.Progress >= 100) { state.Progress = 100; state.IsPlaying = false; state.Timer?.Dispose(); } InvokeAsync(StateHasChanged); }, null, 1000, 1000); } }

