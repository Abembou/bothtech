                        <div class="chat-input-container">
                            <input type="text" @bind="newMessageText" @bind:event="oninput" @onkeyup="HandleKeyUp" class="form-control" placeholder="Répondre..." style="border-radius: 20px;">
                            <button class="btn btn-primary" @onclick="SendMessageAsync" style="border-radius: 50%; width: 40px; height: 40px;">➤</button>
