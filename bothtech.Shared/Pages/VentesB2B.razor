@page "/venteb2b"
@layout bothtech.Shared.Layout.AdminLayout
@using bothtech.Shared.Models
@using bothtech.Shared.Services
@using System.Globalization
@inject DatabaseService DbService

<PageTitle>Ventes B2B | Console Admin</PageTitle>

<!-- MENU DES ONGLETS DE VENTE -->
<div class="ventes-tabs ventes-tabs-top" style="padding: 0 10px;">
    <NavLink class="ventes-tab-btn" href="/commandes" style="text-decoration:none;">📋 Commandes en ligne</NavLink>
    <NavLink class="ventes-tab-btn" href="/ventecomptoir" style="text-decoration:none;">🛒 Vente Comptoir</NavLink>
    <button class="ventes-tab-btn active">🏢 Ventes B2B (Gros)</button>
</div>

@if (!IsFormView)
{
    <!-- VUE 1 : HISTORIQUE DES VENTES B2B -->
    <div style="padding: 0 10px 20px 10px;">
        <section class="card">
            <div class="card-header">
                <div style="display: flex; align-items: center; gap: 15px; width: 100%;">
                    <button class="btn btn-primary" style="background: var(--success); color: white; border: none; font-weight: bold; cursor: pointer; padding: 14px 15px; flex: 1;" @onclick="OpenNewSale">
                        + Nouvelle Vente B2B
                    </button>
                    <h2 class="card-title hide-mobile" style="margin:0;">Historique B2B</h2>
                </div>
                <div class="search-filters">
                    <input type="search" placeholder="Réf. / Partenaire..." class="form-control" @bind="SearchQuery" @bind:event="oninput">
                </div>
            </div>
            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th class="hide-mobile">Date / Réf</th>
                            <th>Détaillant</th>
                            <th class="hide-mobile">Montant</th>
                            <th style="text-align:right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr><td colspan="4" style="text-align:center; padding:20px;">Chargement...</td></tr>
                        }
                        else if (!FilteredHistory.Any())
                        {
                            <tr><td colspan="4" style="text-align:center; padding:20px; color:var(--text-muted);">Aucune vente B2B trouvée.</td></tr>
                        }
                        else
                        {
                            @foreach (var order in FilteredHistory)
                            {
                                <tr>
                                    <td class="hide-mobile">
                                        <small style="color:var(--text-muted);">@FormatDate(order.CreatedAt)</small><br>
                                        <b style="color:var(--primary);">#@order.Id?.Substring(0, 6).ToUpper()</b>
                                    </td>
                                    <td>
                                        <b>@order.ClientName</b><br>
                                        <small style="color:var(--text-muted);">@(string.IsNullOrEmpty(order.ClientPhone) ? "Pas de tél" : order.ClientPhone)</small>

                                        <!-- Affichage Mobile -->
                                        <div class="mobile-only-display" style="margin-top:5px; font-size:0.8rem; border-top:1px dashed var(--border); padding-top:5px;">
                                            <span style="color:var(--text-muted);">@FormatDate(order.CreatedAt)</span> - <b style="color:var(--primary);">#@order.Id?.Substring(0, 6).ToUpper()</b><br>
                                            <b style="color: var(--text-main);">@FormatMoney(order.Total)</b>
                                            @if (order.Reste > 0)
                                            {
                                                <br>
                                
                                                <span style="color:var(--danger); font-size:0.75rem; font-weight:bold;">Reste: @FormatMoney(order.Reste)</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="hide-mobile">
                                        <b>@FormatMoney(order.Total)</b>
                                        @if (order.Reste > 0)
                                        {
                                            <br>
                            
                                            <span style="color:var(--danger); font-size:0.75rem; font-weight:bold;">Reste: @FormatMoney(order.Reste)</span>
                                        }
                                    </td>
                                    <td style="text-align:right;">
                                        <button class="btn btn-outline btn-action">🖨️ Facture</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}
else
{
    <!-- VUE 2 : CAISSE B2B -->
    <div style="padding: 0 10px 20px 10px;">
        <section class="card caisse-card">
            <div class="card-header">
                <h2 class="card-title" style="margin:0; font-size: 1.1rem;">🛒 Saisir Vente B2B</h2>
                <button type="button" class="btn btn-outline" style="cursor: pointer;" @onclick="CloseNewSale">🔙 Retour</button>
            </div>

            <div class="card-body caisse-body">

                <!-- AUTO-COMPLÉTION BLAZOR -->
                <div class="form-group autocomplete-container" style="position: relative;">
                    <label style="color:var(--primary); font-weight:bold; display:block; margin-bottom:8px;">Rechercher le Partenaire *</label>
                    <input type="text" class="form-control" placeholder="Nom ou Téléphone..."
                           @bind="ClientSearchQuery" @bind:event="oninput" autocomplete="off"
                           style="border-color: @(SelectedClient != null ? "var(--success)" : "var(--border)")">

                    @if (SuggestedClients.Any() && SelectedClient == null)
                    {
                        <div class="autocomplete-suggestions" style="display: block; position: absolute; top: 100%; left: 0; right: 0; background: #fff; border: 1px solid var(--border); border-radius: 6px; max-height: 200px; overflow-y: auto; z-index: 1000; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
                            @foreach (var client in SuggestedClients)
                            {
                                <div style="padding: 12px 15px; cursor: pointer; border-bottom: 1px solid #f1f5f9; font-size: 0.9rem;"
                                     @onclick="() => SelectClient(client)">
                                    <strong>@client.Name</strong> - 📞 @(string.IsNullOrEmpty(client.Phone) ? "N/A" : client.Phone)
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- LIGNES DE COMMANDE B2B -->
                <div style="margin-top: 15px; border-top:1px solid var(--border); padding-top:15px;">
                    @foreach (var line in B2bLines)
                    {
                        <div class="pos-line-item" style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:10px; background:#fff; padding:15px; border:1px solid var(--border); border-radius:8px;">
                            <div style="flex:2; min-width:200px;">
                                <label style="font-size:0.8rem; font-weight:bold; display:block; margin-bottom:5px;">Produit</label>
                                <select class="form-control" value="@line.ProductFirebaseId" @onchange="@(e => OnProductSelected(line, e.Value.ToString()))">
                                    <option value="">-- Choisir --</option>
                                    @foreach (var p in _catalog)
                                    {
                                        <option value="@p.Id">@p.Name (Stock: @p.Quantity)</option>
                                    }
                                </select>
                            </div>
                            <div style="display:flex; gap:10px; flex:1; min-width:150px;">
                                <div style="flex:1;">
                                    <label style="font-size:0.8rem; font-weight:bold; display:block; margin-bottom:5px;">Qté</label>
                                    <input type="number" class="form-control" value="@line.Quantity" min="1" max="@line.MaxStock" @onchange="@(e => OnQuantityChanged(line, e.Value))" style="text-align:center;">
                                </div>
                                <div style="flex:1;">
                                    <label style="font-size:0.8rem; font-weight:bold; display:block; margin-bottom:5px;">Prix U. (B2B)</label>
                                    <input type="number" class="form-control" @bind="line.UnitPrice" min="0" style="color:var(--primary); font-weight:bold;">
                                </div>
                            </div>
                            <button class="btn btn-outline" @onclick="() => B2bLines.Remove(line)" style="color:var(--danger); border-color:var(--danger-subtle); font-weight:bold;">Supprimer</button>
                        </div>
                    }
                </div>

                <button class="btn btn-outline" @onclick="AddLine" style="width:100%; margin-top:10px; border-style:dashed; color:var(--primary); border-color:var(--primary-subtle); cursor:pointer; font-weight:600;">+ Ajouter un article</button>

                <div class="receipt-block" style="margin-top:20px; background:var(--warning-subtle); border-color:var(--warning); padding:15px; border-radius:8px;">
                    <div class="receipt-row" style="color:var(--text-main); font-weight:bold; font-size:1rem; margin-bottom:15px;">
                        <span>Total Sélection :</span> <span>@FormatMoney(SubTotal)</span>
                    </div>
                    <div class="form-group" style="margin-bottom: 10px;">
                        <label style="color:var(--warning); font-weight:bold; display:block; margin-bottom:8px;">Montant Avancé (Laissez vide si total)</label>
                        <input type="number" class="form-control" placeholder="Ex: 50000" min="0" max="@SubTotal" @bind="AvanceValue" @bind:event="oninput" style="border-color:var(--warning);">
                    </div>
                    <div class="receipt-total" style="color:var(--danger); border-top:1px solid #fcd34d; padding-top:12px; margin-top:10px; font-size: 1.1rem; display:flex; justify-content:space-between;">
                        <span>RESTE À PAYER :</span> <span>@FormatMoney(ResteAPayer)</span>
                    </div>
                </div>

                <div class="form-group" style="margin-top: 20px; margin-bottom:10px;">
                    <label style="font-weight:bold; display:block; margin-bottom:8px;">Mode de paiement</label>
                    <select class="form-control" @bind="SalePaymentMethod">
                        <option value="espece">Espèce</option>
                        <option value="virement">Virement Bancaire</option>
                        <option value="mobile_money">Mobile Money</option>
                    </select>
                </div>
            </div>

            <div class="caisse-footer">
                <button class="btn btn-success" disabled="@IsProcessing" @onclick="SubmitSale" style="width:100%; background:var(--success); color:white; border:none; padding:16px; font-size:1.15rem; font-weight:bold; cursor:pointer; border-radius:8px;">
                    @(IsProcessing ? "Validation..." : "✅ Valider la vente B2B")
                </button>
            </div>
        </section>
    </div>
}

@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div id="toast" style="display:block;">@ToastMessage</div>
}

@code {
    private bool IsLoading = true;
    private bool IsFormView = false;
    private bool IsProcessing = false;
    private string ToastMessage = "";
    private string SearchQuery = "";

    // Données
    private List<Product> _catalog = new();
    private List<Order> _historyOrders = new();
    private List<User> _b2bClients = new();

    // État du formulaire B2B
    private User SelectedClient = null;
    private string _clientSearchQuery = "";
    private string ClientSearchQuery
    {
        get => _clientSearchQuery;
        set
        {
            _clientSearchQuery = value;
            SelectedClient = null; // Réinitialise le client sélectionné si on modifie la recherche
        }
    }

    private string SalePaymentMethod = "espece";

    // On utilise int? pour que le champ puisse être vide ("Laissez vide si total")
    private int? _avanceValue;
    private int? AvanceValue
    {
        get => _avanceValue;
        set { _avanceValue = (value.HasValue && value > SubTotal) ? SubTotal : value; }
    }

    private List<B2bLineItem> B2bLines = new();

    public class B2bLineItem
    {
        public string ProductFirebaseId { get; set; }
        public string ProductName { get; set; }
        public int Quantity { get; set; } = 1;
        public int UnitPrice { get; set; }
        public int MaxStock { get; set; }
    }

    // Propriétés calculées
    private int SubTotal => B2bLines.Sum(l => l.Quantity * l.UnitPrice);

    // Si l'avance est nulle, on considère qu'il paie la totalité
    private int ResteAPayer => SubTotal - (_avanceValue ?? SubTotal);

    private IEnumerable<Order> FilteredHistory => _historyOrders
        .Where(o => string.IsNullOrWhiteSpace(SearchQuery) ||
                    o.ClientName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (o.Id != null && o.Id.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(o => o.CreatedAt);

    private IEnumerable<User> SuggestedClients => string.IsNullOrWhiteSpace(ClientSearchQuery)
        ? Array.Empty<User>()
        : _b2bClients.Where(c => c.Name.Contains(ClientSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                 (c.Phone != null && c.Phone.Contains(ClientSearchQuery)));

    protected override async Task OnInitializedAsync()
    {
        _catalog = await DbService.GetProductsAsync();

        // Simulation du chargement des partenaires B2B
        _b2bClients = new List<User>
        {
            new User { FirebaseUid = "UID1", Name = "Boutique Le Soleil", Phone = "70112233", Role = "detaillant" },
            new User { FirebaseUid = "UID2", Name = "PACOTHOGO Abdoulaye", Phone = "4584556", Role = "detaillant" }
        };

        // Simulation de l'historique
        _historyOrders = new List<Order>
        {
            new Order { Id = "-PabcB2B", ClientName = "Boutique Le Soleil", Total = 450000, Reste = 150000, CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() }
        };
        IsLoading = false;
    }

    private void OpenNewSale()
    {
        ClientSearchQuery = "";
        SelectedClient = null;
        AvanceValue = null;
        SalePaymentMethod = "espece";
        B2bLines.Clear();
        AddLine();
        IsFormView = true;
    }

    private void CloseNewSale()
    {
        IsFormView = false;
    }

    private void SelectClient(User client)
    {
        SelectedClient = client;
        ClientSearchQuery = client.Name; // Remplir l'input avec le nom
    }

    private void AddLine()
    {
        B2bLines.Add(new B2bLineItem());
    }

    private void OnProductSelected(B2bLineItem line, string productId)
    {
        line.ProductFirebaseId = productId;
        var p = _catalog.FirstOrDefault(x => x.Id == productId);
        if (p != null)
        {
            line.ProductName = p.Name;
            // Magie : on sélectionne automatiquement le PartnerPrice s'il existe, sinon le Price normal
            line.UnitPrice = (p.PartnerPrice.HasValue && p.PartnerPrice > 0) ? p.PartnerPrice.Value : p.Price;
            line.MaxStock = p.Quantity;
            if (line.Quantity > line.MaxStock) line.Quantity = line.MaxStock;
        }
        else
        {
            line.UnitPrice = 0;
            line.MaxStock = 0;
        }
    }

    private void OnQuantityChanged(B2bLineItem line, object value)
    {
        if (int.TryParse(value?.ToString(), out int qty))
        {
            line.Quantity = qty > line.MaxStock ? line.MaxStock : (qty < 1 ? 1 : qty);
        }
    }

    private async Task SubmitSale()
    {
        if (SelectedClient == null)
        {
            await ShowToast("⚠️ Veuillez rechercher et sélectionner un détaillant.");
            return;
        }

        var validLines = B2bLines.Where(l => !string.IsNullOrEmpty(l.ProductFirebaseId) && l.Quantity > 0).ToList();
        if (!validLines.Any())
        {
            await ShowToast("⚠️ Veuillez ajouter au moins un produit.");
            return;
        }

        IsProcessing = true;

        var order = new Order
        {
            Type = "b2b",
            ClientId = SelectedClient.FirebaseUid,
            ClientName = SelectedClient.Name,
            ClientPhone = SelectedClient.Phone,
            Total = SubTotal,
            Avance = _avanceValue ?? SubTotal,
            Reste = ResteAPayer,
            PaymentMethod = SalePaymentMethod,
            Items = validLines.Select(l => new OrderItem
            {
                ProductFirebaseId = l.ProductFirebaseId,
                ProductName = l.ProductName,
                UnitPrice = l.UnitPrice,
                Quantity = l.Quantity
            }).ToList()
        };

        bool success = await DbService.CreateLocalOrderAsync(order);

        if (success)
        {
            await ShowToast("✅ Vente B2B enregistrée !");
            order.Id = "-LB2B" + DateTimeOffset.UtcNow.ToUnixTimeSeconds();
            order.CreatedAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            _historyOrders.Insert(0, order);

            foreach (var line in validLines)
            {
                var p = _catalog.FirstOrDefault(x => x.Id == line.ProductFirebaseId);
                if (p != null) p.Quantity -= line.Quantity;
            }

            IsFormView = false;
        }
        else
        {
            await ShowToast("❌ Erreur lors de l'enregistrement dans la base de données.");
        }

        IsProcessing = false;
    }

    private string FormatMoney(int amount)
    {
        var nfi = (NumberFormatInfo)CultureInfo.GetCultureInfo("fr-FR").NumberFormat.Clone();
        nfi.NumberGroupSeparator = " ";
        return amount.ToString("N0", nfi) + " FCFA";
    }

    private string FormatDate(long timestamp)
    {
        return DateTimeOffset.FromUnixTimeMilliseconds(timestamp).LocalDateTime.ToString("dd/MM/yyyy HH:mm");
    }

    private async Task ShowToast(string message)
    {
        ToastMessage = message;
        StateHasChanged();
        await Task.Delay(3000);
        ToastMessage = "";
        StateHasChanged();
    }
}